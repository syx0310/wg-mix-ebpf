proc r2_git_history_prefix {history_git} {
    if {$history_git ne
        "${::R2_PREDECESSOR_LOCAL_PACKAGE}/history-verification.git"} {
        return -code error "r2-history-git-path"
    }
    return [list /usr/bin/env -i PATH=/usr/bin:/bin LC_ALL=C \
        GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 \
        GIT_NO_REPLACE_OBJECTS=1 GIT_OPTIONAL_LOCKS=0 \
        /usr/bin/git --no-pager --no-replace-objects \
        -c core.attributesFile=/dev/null -c core.fsmonitor=false \
        -c core.hooksPath=/dev/null --git-dir $history_git]
}

proc r2_verify_predecessor_history {values package package_stat_data} {
    upvar 1 $package_stat_data package_stat
    set roots "${package}/history-roots.v1"
    set objects "${package}/history-objects.v1"
    set history_git "${package}/history-verification.git"
    foreach {artifact expected_size expected_sha} [list \
        $roots 41 [dict get $values history_roots_sha256] \
        $objects 351103 [dict get $values history_objects_sha256]] {
        if {[catch {file lstat $artifact before_stat}] ||
            $before_stat(type) ne "file" || $before_stat(nlink) != 1 ||
            $before_stat(size) != $expected_size ||
            ($before_stat(mode) & 07777) != 0600 ||
            $before_stat(uid) != $package_stat(uid) ||
            $before_stat(gid) != $package_stat(gid) ||
            [file_sha256 $artifact] ne $expected_sha ||
            [catch {file lstat $artifact after_stat}]} {
            return -code error "r2-history-file"
        }
        foreach field {dev ino size mode nlink uid gid type mtime} {
            if {$after_stat($field) ne $before_stat($field)} {
                return -code error "r2-history-file-drift"
            }
        }
    }
    if {[catch {file lstat $history_git history_before}] ||
        $history_before(type) ne "directory" ||
        ($history_before(mode) & 07777) != 0700 ||
        $history_before(uid) != $package_stat(uid) ||
        $history_before(gid) != $package_stat(gid)} {
        return -code error "r2-history-git"
    }
    set prefix [r2_git_history_prefix $history_git]
    set commit $::R2_PREDECESSOR_COMMIT
    if {[catch {exec {*}$prefix cat-file -e "${commit}^{commit}"}]} {
        return -code error "r2-history-commit"
    }
    if {[catch {exec {*}$prefix fsck --full --strict --no-dangling \
        $commit 2>@1}]} {
        return -code error "r2-history-fsck"
    }
    if {[catch {exec {*}$prefix rev-list --count $commit} count] ||
        [string trim $count] ne "668"} {
        return -code error "r2-history-count"
    }
    if {[catch {exec {*}$prefix rev-list --max-parents=0 --reverse \
        $commit} roots_output] ||
        [catch {open $roots r} roots_channel]} {
        return -code error "r2-history-roots"
    }
    fconfigure $roots_channel -encoding binary -translation binary
    set roots_payload [read $roots_channel]
    close $roots_channel
    if {$roots_payload ne "${roots_output}\n" || $roots_output eq ""} {
        return -code error "r2-history-roots-content"
    }
    if {[catch {exec {*}$prefix rev-list --parents --objects \
        --missing=print $commit} objects_output] ||
        [regexp -line {^\?} $objects_output] ||
        [catch {open $objects r} objects_channel]} {
        return -code error "r2-history-objects"
    }
    fconfigure $objects_channel -encoding binary -translation binary
    set objects_payload [read $objects_channel]
    close $objects_channel
    if {$objects_payload ne "${objects_output}\n"} {
        return -code error "r2-history-objects-content"
    }
    set bundle "${package}/source-4f2a9b61.bundle"
    if {[catch {exec {*}$prefix bundle verify $bundle 2>@1}]} {
        return -code error "r2-history-bundle-verify"
    }
    if {[catch {exec {*}$prefix bundle list-heads $bundle \
        refs/heads/codex/tcx-faketcp-final-v2} bundle_head] ||
        [string trim $bundle_head] ne
            "$commit refs/heads/codex/tcx-faketcp-final-v2"} {
        return -code error "r2-history-bundle-head"
    }
    if {[catch {file lstat $history_git history_after}]} {
        return -code error "r2-history-git-drift"
    }
    foreach field {dev ino mode uid gid type mtime} {
        if {$history_after($field) ne $history_before($field)} {
            return -code error "r2-history-git-drift"
        }
    }
}

proc r2_stale_operations {} {
    set operations {
        stale-alternate-bootstrap-root stale-stage-root stale-fresh-root
        stale-standalone-root stale-routed-evidence-root stale-realnic-run-roots
        stale-realnic-interface-leases stale-veth-wgc8e41a stale-veth-wgc8e41b
        stale-veth-wga19f7a stale-veth-wga19f7b stale-veth-wg5b8d3a
        stale-veth-wg5b8d3b stale-pin-fresh stale-pin-standalone
        stale-pin-legacy-tcx stale-pin-legacy-nic-original
        stale-pin-legacy-nic-all-on stale-pin-legacy-nic-all-off
        stale-pin-legacy-nic-tx-path stale-pin-legacy-nic-rx-path
        stale-pin-legacy-nic-mtu1492 stale-pin-legacy-nic-mtu1500
        stale-pin-legacy-nic-soak stale-checksum-module
        stale-checksum-module-btf stale-checksum-module-lock
        stale-physical-interface-lock
    }
    if {[llength $operations] != 28} {
        return -code error "r2-stale-cardinality"
    }
    return $operations
}

proc r2_require_predecessor_authority {} {
    set package $::R2_PREDECESSOR_LOCAL_PACKAGE
    set manifest "${package}/package-manifest.v1"
    if {[catch {r2_load_predecessor_manifest $manifest} values] ||
        [catch {exec /usr/bin/id -u} caller_uid] ||
        ![regexp {^[0-9]+$} $caller_uid] ||
        [catch {file lstat $package package_stat}] ||
        $package_stat(type) ne "directory" ||
        ($package_stat(mode) & 07777) != 0700 ||
        $package_stat(uid) != $caller_uid} {
        fail "r2-predecessor-authority" 66
    }
    set actual_names {}
    foreach pattern [list * .*] {
        foreach candidate [glob -nocomplain -directory $package $pattern] {
            set name [file tail $candidate]
            if {$name ni {. ..} && [lsearch -exact $actual_names $name] < 0} {
                lappend actual_names $name
            }
        }
    }
    set expected_names [r2_predecessor_package_names]
    set expected_local_names [concat $expected_names {
        history-roots.v1 history-objects.v1 history-verification.git
    }]
    if {[llength $actual_names] != 20 ||
        [lsort -ascii $actual_names] ne [lsort -ascii $expected_local_names]} {
        fail "r2-predecessor-entry-set" 66
    }
    foreach name $expected_names {
        set artifact "${package}/${name}"
        set expected_sha [r2_predecessor_package_sha $name]
        set expected_size [r2_predecessor_package_size $name]
        if {[file normalize $artifact] ne $artifact ||
            [catch {file lstat $artifact artifact_stat}] ||
            $artifact_stat(type) ne "file" || $artifact_stat(nlink) != 1 ||
            $artifact_stat(size) != $expected_size ||
            ($artifact_stat(mode) & 07777) != 0600 ||
            $artifact_stat(uid) != $package_stat(uid) ||
            $artifact_stat(gid) != $package_stat(gid) ||
            [file_sha256 $artifact] ne $expected_sha} {
            fail "r2-predecessor-artifact-$name" 66
        }
    }
    if {[catch {r2_verify_predecessor_history $values $package package_stat}]} {
        fail "r2-predecessor-history" 66
    }
    if {[dict get $values integration_commit] ne $::R2_PREDECESSOR_COMMIT ||
        [dict get $values bundle_sha256] ne $::R2_PREDECESSOR_BUNDLE_SHA256} {
        fail "r2-predecessor-binding" 66
    }
    puts "B82_V6_R2_PREDECESSOR_AUTHORITY predecessor_commit=$::R2_PREDECESSOR_COMMIT predecessor_manifest_sha256=$::R2_PREDECESSOR_MANIFEST_SHA256 package_files=17 credential_read=0 network_operations=0"
    return $values
}

proc r2_local_delivery_file {values manifest_sha name} {
    set package [dict get $values local_package_dir]
    switch -- $name {
        package-manifest.v1 { set expected_sha $manifest_sha }
        prepare-stage-root.sh {
            set expected_sha [dict get $values prepare_stage_root_sh_sha256]
        }
        default { return -code error "r2-delivery-name" }
    }
    set artifact "${package}/${name}"
    if {[file normalize $artifact] ne $artifact ||
        [catch {file lstat $artifact artifact_stat}] ||
        [catch {file lstat $package package_stat}] ||
        $artifact_stat(type) ne "file" || $artifact_stat(nlink) != 1 ||
        $artifact_stat(size) < 1 || $artifact_stat(size) > 16777216 ||
        ($artifact_stat(mode) & 07777) != 0600 ||
        $package_stat(type) ne "directory" ||
        ($package_stat(mode) & 07777) != 0700 ||
        $artifact_stat(uid) != $package_stat(uid) ||
        $artifact_stat(gid) != $package_stat(gid) ||
        [file_sha256 $artifact] ne $expected_sha} {
        return -code error "r2-delivery-local-file"
    }
    return [list $artifact $expected_sha]
}

