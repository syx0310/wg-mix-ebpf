    set spawn_argv [concat [list /usr/bin/ssh] [ssh_options $tty] \
        [list -- $target] $remote]
    return [list ssh $spawn_argv $prompt_limit $assertion $timeout_seconds]
}

proc output_value {payload} {
    set value [string map [list "\r" ""] $payload]
    return [string trim $value "\n"]
}

proc exact_line_count {lines expected} {
    set count 0
    foreach line $lines {
        if {$line eq $expected} {
            incr count
        }
    }
    return $count
}

proc prefix_line_count {lines prefix} {
    set count 0
    foreach line $lines {
        if {[string first $prefix $line] == 0} {
            incr count
        }
    }
    return $count
}

proc successful_write_finish_count {lines} {
    set count 0
    foreach line $lines {
        if {[string first "write_finish " $line] == 0 &&
            [string match "* exit=0" $line]} {
            incr count
        }
    }
    return $count
}

proc provision_missing_class {lines} {
    set matches {}
    foreach line $lines {
        if {[string first "missing_packages=" $line] == 0} {
            lappend matches $line
        }
    }
    if {[llength $matches] != 1} {
        return -code error "missing-set-cardinality"
    }
    switch -- [lindex $matches 0] {
        "missing_packages=" { return none }
        "missing_packages= clang gcc golang-go iperf3 libbpf-dev llvm make pkg-config shellcheck wireguard-tools" {
            return initial
        }
        "missing_packages= iperf3" { return iperf3 }
        default { return -code error "unexpected-missing-set" }
    }
}

proc provision_plan_policy {payload expected_mode} {
    set normalized [output_value $payload]
    set lines [split $normalized "\n"]
    set missing_class [provision_missing_class $lines]
    if {[exact_line_count $lines "mode=$expected_mode"] != 1 ||
        [exact_line_count $lines \
            "plan_complete planned_commands_executed=0 writes=0 automatic_cleanup=0"] != 1} {
        return -code error "plan-evidence"
    }
    set plan_count [prefix_line_count $lines "plan_command="]
    if {$missing_class eq "none"} {
        if {$plan_count != 0 ||
            [exact_line_count $lines \
                "plan_apt_commands=skipped reason=fixed-package-set-already-installed"] != 1} {
            return -code error "already-ready-plan"
        }
    } else {
        if {$plan_count != 3 ||
            [prefix_line_count $lines "plan_command=A0 argv="] != 1 ||
            [prefix_line_count $lines "plan_command=A1 argv="] != 1 ||
            [prefix_line_count $lines "plan_command=A2 argv="] != 1} {
            return -code error "missing-package-plan"
        }
    }
    if {$expected_mode eq "check"} {
        if {[prefix_line_count $lines "write_start "] != 0 ||
            [prefix_line_count $lines "write_finish "] != 0 ||
            [exact_line_count $lines "provisioning completed"] != 0} {
            return -code error "check-write-evidence"
        }
    } else {
        if {$missing_class eq "none" ||
            [prefix_line_count $lines "write_start "] != 2 ||
            [prefix_line_count $lines "write_finish "] != 2 ||
            [successful_write_finish_count $lines] != 2 ||
            [exact_line_count $lines "provisioning completed"] != 1} {
            return -code error "apply-write-evidence"
        }
    }
    return $missing_class
}

proc assert_output {assertion payload} {
    set value [output_value $payload]
    if {$assertion eq "none"} {
        return
    }
    if {[string first "exact-entry-set" $assertion] == 0} {
        set expected [lrange $assertion 1 end]
        set actual {}
        if {$value ne ""} {
            set actual [split $value "\n"]
        }
        if {[llength $actual] != [llength $expected] ||
            [lsort -ascii $actual] ne [lsort -ascii $expected]} {
            return -code error "entry-set-output-mismatch"
        }
        return
    }
    if {$assertion eq "same-two-inodes"} {
        set lines [split $value "\n"]
        if {[llength $lines] != 2 || [lindex $lines 0] ne [lindex $lines 1] ||
            ![regexp {^[0-9]+:[0-9]+$} [lindex $lines 0]]} {
            return -code error "inode-pair-output-mismatch"
        }
        return
    }
    if {$assertion eq "empty"} {
        if {$value ne ""} {
            return -code error "expected-empty-output"
        }
        return
    }
    if {[string first "exact:" $assertion] == 0} {
        if {$value ne [string range $assertion 6 end]} {
            return -code error "exact-output-mismatch"
        }
        return
    }
    if {[string first "word:" $assertion] == 0} {
        set expected [string range $assertion 5 end]
        if {[lsearch -exact [split $value] $expected] < 0} {
            return -code error "word-output-missing"
        }
        return
    }
    if {[string first "contains:" $assertion] == 0} {
        set expected [string range $assertion 9 end]
        if {[string first $expected $value] < 0} {
            return -code error "required-output-fragment-missing"
        }
        return
    }
    return -code error "unknown-assertion"
}

proc emit_safe {payload password} {
    if {$password ne ""} {
        set payload [string map [list $password "<credential-redacted>"] $payload]
    }
    puts -nonewline $payload
    flush stdout
}

proc python_json_escape_utf8_content {value} {
    binary scan $value cu* octets
    set escaped ""
    set index 0
    set count [llength $octets]
    while {$index < $count} {
        set first [lindex $octets $index]
        if {$first <= 0x7f} {
            set codepoint $first
            set width 1
        } elseif {$first >= 0xc2 && $first <= 0xdf && $index + 1 < $count} {
            set second [lindex $octets [expr {$index + 1}]]
            if {$second < 0x80 || $second > 0xbf} {
                return -code error "credential-utf8"
            }
            set codepoint [expr {(($first & 0x1f) << 6) | ($second & 0x3f)}]
            set width 2
        } elseif {$first >= 0xe0 && $first <= 0xef && $index + 2 < $count} {
            set second [lindex $octets [expr {$index + 1}]]
            set third [lindex $octets [expr {$index + 2}]]
            if {$third < 0x80 || $third > 0xbf ||
                ($first == 0xe0 && ($second < 0xa0 || $second > 0xbf)) ||
                ($first == 0xed && ($second < 0x80 || $second > 0x9f)) ||
                ($first != 0xe0 && $first != 0xed &&
                 ($second < 0x80 || $second > 0xbf))} {
                return -code error "credential-utf8"
            }
            set codepoint [expr {(($first & 0x0f) << 12) |
                (($second & 0x3f) << 6) | ($third & 0x3f)}]
            set width 3
        } elseif {$first >= 0xf0 && $first <= 0xf4 && $index + 3 < $count} {
            set second [lindex $octets [expr {$index + 1}]]
            set third [lindex $octets [expr {$index + 2}]]
            set fourth [lindex $octets [expr {$index + 3}]]
            if {$third < 0x80 || $third > 0xbf ||
                $fourth < 0x80 || $fourth > 0xbf ||
                ($first == 0xf0 && ($second < 0x90 || $second > 0xbf)) ||
                ($first == 0xf4 && ($second < 0x80 || $second > 0x8f)) ||
                ($first != 0xf0 && $first != 0xf4 &&
                 ($second < 0x80 || $second > 0xbf))} {
                return -code error "credential-utf8"
            }
            set codepoint [expr {(($first & 0x07) << 18) |
                (($second & 0x3f) << 12) | (($third & 0x3f) << 6) |
                ($fourth & 0x3f)}]
            set width 4
        } else {
            return -code error "credential-utf8"
        }
        switch -- $codepoint {
            8 { append escaped {\b} }
            9 { append escaped {\t} }
            10 { append escaped {\n} }
            12 { append escaped {\f} }
            13 { append escaped {\r} }
            34 { append escaped {\"} }
            92 { append escaped {\\} }
            default {
                if {$codepoint >= 0x20 && $codepoint <= 0x7e} {
                    append escaped [format %c $codepoint]
                } elseif {$codepoint <= 0xffff} {
                    append escaped [format {\u%04x} $codepoint]
                } else {
                    set scalar [expr {$codepoint - 0x10000}]
                    append escaped [format {\u%04x\u%04x} \
                        [expr {0xd800 + ($scalar >> 10)}] \
                        [expr {0xdc00 + ($scalar & 0x3ff)}]]
                }
            }
        }
        incr index $width
    }
    return $escaped
}

proc append_capture_output {variable_name chunk password password_json_escape} {
    upvar 1 $variable_name captured
    append captured $chunk
    if {[string bytelength $captured] > 16777232} {
        return -code error "candidate-too-large"
    }
    if {$password ne "" && [string first $password $captured] >= 0} {
        return -code error "credential-in-candidate"
    }
    if {$password_json_escape ne "" &&
        [string first $password_json_escape $captured] >= 0} {
        return -code error "credential-json-escape-in-candidate"
    }
}

proc accept_capture_prompt {variable_name credential_sends buffer} {
    upvar 1 $variable_name captured
    if {$credential_sends == 0} {
        set expected_prompt {siyixuan@192.168.10.82's password: }
        if {$buffer ne $expected_prompt || $captured ne ""} {
            return -code error "capture-ssh-prompt-frame"
        }
    } elseif {$credential_sends == 1} {
        set expected_prompt B82_V6_SUDO_PASSWORD:
        if {$buffer ne $expected_prompt || $captured ne "\r\n"} {
            return -code error "capture-sudo-prompt-frame"
        }
    } else {
        return -code error "capture-credential-frame-count"
    }
}

proc canonical_capture_payload {raw credential_sends} {
    if {$credential_sends < 1 || $credential_sends > 2 ||
        [string first "\u0000" $raw] >= 0} {
        return -code error "capture-prompt-or-nul"
    }
    set without_crlf [string map [list "\r\n" ""] $raw]
    if {[string first "\r" $without_crlf] >= 0 ||
        [string first "\n" $without_crlf] >= 0} {
        return -code error "capture-non-crlf"
    }
    set normalized [string map [list "\r\n" "\n"] $raw]
    set prefix [string repeat "\n" $credential_sends]
    if {[string range $normalized 0 [expr {[string length $prefix] - 1}]] ne $prefix} {
        return -code error "capture-leading-frame"
    }
    set payload [string range $normalized [string length $prefix] end]
    if {[string bytelength $payload] < 3 || [string bytelength $payload] > 16777216 ||
        [string index $payload 0] ne "{" || [string range $payload end-1 end] ne "}\n" ||
        [string first "\n" [string range $payload 0 end-1]] >= 0 ||
        [string first "\r" $payload] >= 0} {
        return -code error "capture-payload-frame"
    }
    return $payload
}

proc read_capture_credential {path} {
    if {[catch {open $path r} credential_file]} {
        return -code error "credential-open"
    }
    fconfigure $credential_file -encoding binary -translation binary
    if {[catch {read $credential_file 4097} payload]} {
        close $credential_file
        return -code error "credential-read"
    }
    close $credential_file
    if {[string bytelength $payload] > 4096 || $payload eq ""} {
        return -code error "credential-shape"
    }
    if {[string index $payload end] eq "\n"} {
        set payload [string range $payload 0 end-1]
    }
    set boundary [string first "\n" $payload]
    if {$boundary < 1 || [string first "\n" $payload [expr {$boundary + 1}]] >= 0} {
        return -code error "credential-shape"
    }
    set ssh_line [string range $payload 0 [expr {$boundary - 1}]]
    set password_bytes [string range $payload [expr {$boundary + 1}] end]
    set payload ""
    if {$ssh_line ne "ssh siyixuan@192.168.10.82" || $password_bytes eq "" ||
        [string first "\u0000" $password_bytes] >= 0 ||
        [string first "\r" $password_bytes] >= 0 ||
        [string first "\n" $password_bytes] >= 0 ||
        [catch {python_json_escape_utf8_content $password_bytes} escape_error]} {
        set password_bytes ""
        return -code error "credential-value"
    }
    return $password_bytes
}

proc clean_child_exit_status {wait_status} {
    if {[llength $wait_status] != 4 || [lindex $wait_status 2] != 0 ||
        ![string is integer -strict [lindex $wait_status 3]] ||
        [lindex $wait_status 3] < 0 || [lindex $wait_status 3] > 255} {
        return -code error "child-wait-status"
    }
    return [lindex $wait_status 3]
}

proc capture_payload_to_eof {child_id variable_name credential_sends password_bytes \
    password_json_escape deadline_ms} {
    upvar 1 $variable_name captured_output
    set remaining_ms [expr {$deadline_ms - [clock milliseconds]}]
    if {$remaining_ms < 1000} {
        fail "timeout" 124
    }
    set timeout [expr {int($remaining_ms / 1000)}]
    expect {
        -i $child_id
        timeout {
            fail "timeout" 124
        }
        full_buffer {
            fail "capture-full-buffer" 78
        }
        eof {
            if {[info exists expect_out(buffer)] && $expect_out(buffer) ne ""} {
                if {[catch {append_capture_output captured_output $expect_out(buffer) \
                    $password_bytes $password_json_escape} capture_error]} {
                    fail $capture_error 78
                }
            }
            set wait_status [wait -i $child_id]
            if {[catch {clean_child_exit_status $wait_status} child_rc]} {
                fail "child-wait-status" 78
            }
            if {$child_rc != 0} {
                exit $child_rc
            }
            if {[clock milliseconds] > $deadline_ms} {
                fail "timeout" 124
            }
            if {($password_bytes ne "" &&
                 [string first $password_bytes $captured_output] >= 0) ||
                ($password_json_escape ne "" &&
                 [string first $password_json_escape $captured_output] >= 0)} {
                fail "credential-in-candidate" 78
            }
            if {[catch {canonical_capture_payload $captured_output $credential_sends} payload]} {
                fail "capture-framing-$payload" 78
            }
            return [list $payload $credential_sends [string bytelength $captured_output]]
        }
    }
}

proc capture_child_payload {child_id password_bytes prompt_limit timeout_seconds} {
    set timeout $timeout_seconds
    set deadline_ms [expr {[clock milliseconds] + ($timeout_seconds * 1000)}]
    set captured_output ""
    set credential_sends 0
    set password_json_escape [python_json_escape_utf8_content $password_bytes]
    set credential_pattern {(?:siyixuan@192\.168\.10\.82's password: |B82_V6_SUDO_PASSWORD:)$}
    fconfigure $child_id -encoding binary -translation binary
    match_max -i $child_id 16781312
    remove_nulls -i $child_id 0
    expect {
        -i $child_id
        -re {^\r\n} {
            if {[catch {append_capture_output captured_output $expect_out(buffer) \
                $password_bytes $password_json_escape} capture_error]} {
                set password_bytes ""
                set password_json_escape ""
                fail $capture_error 78
            }
            exp_continue -continue_timer
        }
        -re $credential_pattern {
            if {[catch {accept_capture_prompt captured_output $credential_sends \
                $expect_out(buffer)} capture_error]} {
                set password_bytes ""
                set password_json_escape ""
                fail $capture_error 78
            }
            incr credential_sends
            if {$credential_sends > $prompt_limit} {
                set password_bytes ""
                set password_json_escape ""
                fail "credential-prompt-count" 77
            }
            send -i $child_id -- $password_bytes
            send -i $child_id -- "\r"
            exp_continue -continue_timer
        }
        -exact "\{" {
            set expected_prefix [string repeat "\r\n" $credential_sends]
            if {$credential_sends < 1 || $credential_sends > 2 ||
                $expect_out(buffer) ne "\{" || $captured_output ne $expected_prefix} {
                set password_bytes ""
                set password_json_escape ""
                fail "capture-payload-start-frame" 78
            }
            if {[catch {append_capture_output captured_output "\{" $password_bytes \
                $password_json_escape} capture_error]} {
                set password_bytes ""
                set password_json_escape ""
                fail $capture_error 78
            }
            set result [capture_payload_to_eof $child_id captured_output \
                $credential_sends $password_bytes $password_json_escape $deadline_ms]
            set password_bytes ""
            set password_json_escape ""
            return $result
        }
        timeout {
            set password_bytes ""
            set password_json_escape ""
            fail "timeout" 124
        }
        full_buffer {
            set password_bytes ""
            set password_json_escape ""
            fail "capture-full-buffer" 78
        }
        eof {
            set wait_status [wait -i $child_id]
            if {[catch {clean_child_exit_status $wait_status} child_rc]} {
                set password_bytes ""
                set password_json_escape ""
                fail "child-wait-status" 78
            }
            if {$child_rc != 0} {
                set password_bytes ""
                set password_json_escape ""
                exit $child_rc
            }
            set password_bytes ""
            set password_json_escape ""
            fail "capture-missing-payload" 78
        }
    }
}

proc base_identity_operations {} {
    return {identity-hostname identity-kernel identity-machine identity-netns identity-interface}
}

proc postflight_operations {} {
    return {
        identity-driver identity-wg-interfaces
        tool-go tool-clang tool-llvm tool-bpftool tool-make tool-gcc tool-iperf3
        tool-shellcheck tool-jq tool-wireguard tool-ethtool tool-tc tool-ip
        kernel-btf kernel-bpffs kernel-headers
    }
}

proc prepare_stale_operations {} {
    return {
        stale-package-root stale-bootstrap-root stale-alternate-bootstrap-root
        stale-stage-root stale-fresh-root stale-standalone-root
        stale-routed-evidence-root stale-realnic-run-roots
        stale-realnic-interface-leases stale-veth-wgc8e41a stale-veth-wgc8e41b
        stale-veth-wga19f7a stale-veth-wga19f7b stale-veth-wg5b8d3a
        stale-veth-wg5b8d3b stale-pin-fresh stale-pin-standalone
        stale-pin-legacy-tcx stale-pin-legacy-nic-original
        stale-pin-legacy-nic-all-on stale-pin-legacy-nic-all-off
        stale-pin-legacy-nic-tx-path stale-pin-legacy-nic-rx-path
        stale-pin-legacy-nic-mtu1492 stale-pin-legacy-nic-mtu1500
        stale-pin-legacy-nic-soak stale-checksum-module
        stale-checksum-module-btf stale-checksum-module-lock
        stale-physical-interface-lock
    }
}

proc retirement_stale_operations {} {
    set operations {}
    foreach operation [prepare_stale_operations] {
        if {$operation ni {stale-package-root stale-bootstrap-root}} {
            lappend operations $operation
        }
    }
    if {[llength $operations] != 28} {
        return -code error "retirement-stale-cardinality"
    }
    return $operations
}

proc package_names {} {
    return {
        source-4f2a9b61.bundle package-manifest.v1 bind-final-package.sh
        controller.sh prepare-stage-root.sh provision-ubuntu-test-host.sh
        root-matrix-n-r.sh check-realhost-iperf.py test-hermetic-matrix.sh
        test_matrix_static.py checksum-module-lease.sh root-fresh-verifier-gate.sh
        test-hermetic-fresh-verifier-gate.sh test_fresh_verifier_gate_static.py
        realnic_acceptance.py test_realnic_acceptance.py
        test_realnic_acceptance_static.py
    }
}

proc bootstrap_create_operations {} {
    return {
        bootstrap-absent bootstrap-not-symlink bootstrap-create
        bootstrap-root-readlink bootstrap-root-stat
        bootstrap-install-provisioner bootstrap-install-stager
    }
}

proc bootstrap_verify_operations {} {
    return {bootstrap-root-readlink bootstrap-root-stat}
}

proc provisioner_verify_operations {} {
    return {
        bootstrap-provisioner-readlink bootstrap-provisioner-stat
        bootstrap-provisioner-sha
    }
}

proc stager_verify_operations {} {
    return {bootstrap-stager-readlink bootstrap-stager-stat bootstrap-stager-sha}
}

proc stage_operations {} { return {stage-snapshot stage-plan stage-run} }

proc transaction_operation {operation} {
    return [expr {$operation in {
        prepare provision-apply fresh-run fresh-restore veth-run veth-restore
        routed-run routed-restore realnic-run realnic-restore
        retire-prestage-2c690050
    }}]
}

proc retirement_mutation_operation {operation} {
    return [expr {$operation eq "retire-prestage-2c690050"}]
}

proc retirement_read_only_operation {operation} {
    return [expr {$operation eq "verify-retirement"}]
}

proc read_only_operation {operation} {
    if {[retirement_read_only_operation $operation]} {
        return 1
    }
    if {[lsearch -exact [concat [base_identity_operations] [postflight_operations] \
        [prepare_stale_operations]] $operation] >= 0} {
        return 1
    }
    if {$operation in {
        package-parent-stat bootstrap-absent bootstrap-not-symlink
        bootstrap-root-readlink bootstrap-root-stat bootstrap-stager-readlink
        bootstrap-stager-stat bootstrap-stager-sha bootstrap-provisioner-readlink
        bootstrap-provisioner-stat bootstrap-provisioner-sha provision-check
        stage-plan fresh-plan veth-plan routed-plan
        verify-sha-realnic-approved-plan verify-stat-realnic-approved-plan
        stage-realnic-plan-verify
    }} {
        return 1
    }
    if {[regexp {^verify-(?:sha|stat)-(.+)$} $operation -> name] &&
        [lsearch -exact [package_names] $name] >= 0} {
        return 1
    }
    return 0
}

proc operation_requires_approved_sha {operation} {
    return [expr {$operation in {
        scp-realnic-approved-plan verify-sha-realnic-approved-plan
        verify-stat-realnic-approved-plan stage-realnic-plan-snapshot
        realnic-run stage-realnic-plan-verify realnic-restore
    }}]
}

proc read_execute_credential {credential_path} {
    if {[catch {open $credential_path r} credential_file]} {
        fail "credential-open" 65
    }
    fconfigure $credential_file -encoding utf-8 -translation lf
    if {[gets $credential_file ssh_line] < 0 || [gets $credential_file password] < 0 ||
        [gets $credential_file unexpected] >= 0} {
        close $credential_file
        set password ""
        fail "credential-shape" 65
    }
    close $credential_file
    set ssh_parts [split [string trim $ssh_line]]
    set ssh_line ""
    if {$ssh_parts ne [list ssh siyixuan@192.168.10.82] || $password eq "" ||
        [string first "\u0000" $password] >= 0 || [string first "\r" $password] >= 0 ||
        [string first "\n" $password] >= 0} {
        set password ""
        fail "credential-value" 65
    }
    return $password
}

proc require_manifest_authority {values manifest_sha} {
    set manifest "[dict get $values local_package_dir]/package-manifest.v1"
    if {[catch {load_manifest $manifest $manifest_sha} current] ||
        $current ne $values ||
        [catch {exec /usr/bin/id -u} caller_uid] ||
        ![regexp {^[0-9]+$} $caller_uid] ||
        [catch {file lstat $manifest manifest_stat}] ||
        [catch {file lstat [dict get $values local_package_dir] package_stat}] ||
        $manifest_stat(type) ne "file" || $manifest_stat(nlink) != 1 ||
        ($manifest_stat(mode) & 07777) != 0600 ||
        $package_stat(type) ne "directory" ||
        ($package_stat(mode) & 07777) != 0700 ||
        $package_stat(uid) != $caller_uid ||
        $manifest_stat(uid) != $package_stat(uid) ||
        $manifest_stat(gid) != $package_stat(gid)} {
        fail "manifest-transaction-drift" 66
    }
}

proc require_retirement_predecessor_authority {} {
    set manifest "${::PREDECESSOR_LOCAL_PACKAGE}/package-manifest.v1"
    if {[catch {load_manifest $manifest $::PREDECESSOR_MANIFEST_SHA256} values] ||
        [catch {validate_manifest_values $values} validation_message] ||
        [dict get $values integration_commit] ne $::PREDECESSOR_COMMIT ||
        [dict get $values local_package_dir] ne $::PREDECESSOR_LOCAL_PACKAGE ||
        [dict get $values remote_package_dir] ne
            "/home/siyixuan/wg-mix-ebpf-test/unpriv-4f2a9b61"} {
        fail "retirement-predecessor-manifest" 66
    }
    require_manifest_authority $values $::PREDECESSOR_MANIFEST_SHA256
    puts "B82_V6_RETIREMENT_PREDECESSOR_AUTHORITY predecessor_commit=$::PREDECESSOR_COMMIT predecessor_manifest_sha256=$::PREDECESSOR_MANIFEST_SHA256 credential_read=0 network_operations=0"
    return $values
}

proc require_controller_verifier_authority {values} {
    set repository [dict get $values local_repository]
    set controller_path [dict get $values controller_sh_path]
    set controller_source "${repository}/${controller_path}"
    set package [dict get $values local_package_dir]
    set controller_copy "${package}/controller.sh"
    set expected_path "scripts/realhost-b82-c8e41d73/controller.sh"
    set expected_sha [dict get $values controller_sh_sha256]
    set expected_blob [dict get $values controller_sh_blob]
    if {$controller_path ne $expected_path ||
        [catch {file normalize $repository} normalized_repository] ||
        $normalized_repository ne $repository ||
        [catch {file normalize $controller_source} normalized_source] ||
        $normalized_source ne $controller_source ||
        [catch {file lstat $controller_source source_stat}] ||
        [catch {file lstat $controller_copy copy_stat}] ||
        [catch {file lstat $package package_stat}] ||
        $source_stat(type) ne "file" || $source_stat(nlink) != 1 ||
        $source_stat(size) < 1 || $source_stat(size) > 16777216 ||
        ($source_stat(mode) & 07777) != 0755 ||
        $copy_stat(type) ne "file" || $copy_stat(nlink) != 1 ||
        $copy_stat(size) < 1 || $copy_stat(size) > 16777216 ||
        ($copy_stat(mode) & 07777) != 0600 ||
        $package_stat(type) ne "directory" ||
        ($package_stat(mode) & 07777) != 0700 ||
        $copy_stat(uid) != $package_stat(uid) ||
        $copy_stat(gid) != $package_stat(gid) ||
        [catch {file_sha256 $controller_source} source_sha] ||
        $source_sha ne $expected_sha ||
        [catch {file_sha256 $controller_copy} copy_sha] ||
        $copy_sha ne $expected_sha} {
        fail "controller-verifier-shape" 66
    }
    set git_prefix [list /usr/bin/env -i PATH=/usr/bin:/bin LC_ALL=C \
        GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 \
        GIT_NO_REPLACE_OBJECTS=1 GIT_OPTIONAL_LOCKS=0 \
        /usr/bin/git --no-pager --no-replace-objects \
        -c core.attributesFile=/dev/null -c core.fsmonitor=false \
        -c core.hooksPath=/dev/null -C $repository]
    set integration_commit [dict get $values integration_commit]
    set integration_ref [dict get $values integration_ref]
    if {[catch {exec {*}$git_prefix rev-parse --show-toplevel} top_level] ||
        [string trim $top_level] ne $repository ||
        [catch {exec {*}$git_prefix rev-parse --verify "${integration_ref}^{commit}"} ref_commit] ||
        [string trim $ref_commit] ne $integration_commit ||
        [catch {exec {*}$git_prefix hash-object -- $controller_source} source_blob] ||
        [string trim $source_blob] ne $expected_blob ||
        [catch {exec {*}$git_prefix rev-parse "${integration_commit}:${controller_path}"} commit_blob] ||
        [string trim $commit_blob] ne $expected_blob ||
        [catch {exec {*}$git_prefix ls-tree $integration_commit -- $controller_path} tree_entry] ||
        [string trim $tree_entry] ne "100755 blob ${expected_blob}\t${controller_path}"} {
        fail "controller-verifier-git-identity" 66
    }
}

proc execute_controller_package_verifier {values manifest_sha} {
    set package [dict get $values local_package_dir]
    set controller "${package}/controller.sh"
    set manifest "${package}/package-manifest.v1"
    if {[catch {file lstat $package package_stat}]} {
        fail "controller-package-verifier-shape" 66
    }
    set expected_marker "B82_V6_CONTROLLER_PACKAGE_VERIFIED manifest_sha256=$manifest_sha integration_commit=[dict get $values integration_commit] package_device_inode=$package_stat(dev):$package_stat(ino) credential_read=0 network_operations=0"
    set verifier_argv [list /usr/bin/env -i PATH=/usr/bin:/bin LC_ALL=C \
        /bin/bash $controller verify-package \
        --manifest $manifest --manifest-sha256 $manifest_sha \
        --credential-path /Users/siyixuan/codes-2/wg-mix-ebpf/credientials/192.168.10.82 \
        --approved-plan-sha256 none]
    if {[catch {exec {*}$verifier_argv 2>@1} verifier_output]} {
        fail "controller-package-verifier" 66
    }
    set normalized [output_value $verifier_output]
    set lines [split $normalized "\n"]
    if {[exact_line_count $lines $expected_marker] != 1 ||
        [lindex $lines end] ne $expected_marker} {
        fail "controller-package-verifier-marker" 66
    }
    puts "B82_V6_TRANSPORT_PACKAGE_AUTHORITY manifest_sha256=$manifest_sha integration_commit=[dict get $values integration_commit] package_device_inode=$package_stat(dev):$package_stat(ino) verifier=controller-read-only"
}

proc require_transaction_local_authority {values manifest_sha operation approved_sha} {
    require_controller_verifier_authority $values
    foreach name [package_names] {
        if {[catch {build_operation $values $manifest_sha "scp-$name" none} \
            package_copy_spec]} {
            fail "local-package-artifact" 66
        }
    }
    execute_controller_package_verifier $values $manifest_sha
    if {$operation eq "realnic-run" &&
        [catch {build_operation $values $manifest_sha scp-realnic-approved-plan \
            $approved_sha} approved_plan_spec]} {
        fail "realnic-approved-plan-local" 66
    }
}

proc execute_operation_spec {operation operation_spec password} {
    lassign $operation_spec transport_type spawn_argv prompt_limit assertion timeout_seconds
    puts "B82_V6_TRANSPORT_EXECUTE operation=$operation transport=$transport_type credential_in_argv=0 channel=execute"
    puts "EXPECT_SPAWN_ARGV [list {*}$spawn_argv]"
    log_user 0
    spawn -noecho {*}$spawn_argv
    set child_id $spawn_id
    set timeout $timeout_seconds
    set captured_output ""
    set credential_sends 0
    set credential_pattern {(?i)(?:password|passphrase)[^:\r\n]*:[ \t]*$}
    expect {
        -i $child_id
        -re $credential_pattern {
            incr credential_sends
            if {$credential_sends > $prompt_limit} {
                set password ""
                fail "credential-prompt-count" 77
            }
            send -i $child_id -- "$password\r"
            exp_continue
        }
        -re {[^\r\n]*(?:\r\n|\n|\r)} {
            append captured_output $expect_out(buffer)
            emit_safe $expect_out(buffer) $password
            exp_continue
        }
        timeout {
            set password ""
            fail "timeout" 124
        }
        eof {
            if {[info exists expect_out(buffer)] && $expect_out(buffer) ne ""} {
                append captured_output $expect_out(buffer)
                emit_safe $expect_out(buffer) $password
            }
            if {[catch {wait -i $child_id} wait_status] ||
                [catch {clean_child_exit_status $wait_status} child_rc]} {
                set password ""
                fail "child-wait-status" 78
            }
            if {$child_rc != 0} {
                set password ""
                if {$assertion in {provision-check provision-apply}} {
                    puts "B82_V6_PROVISION_AUDIT operation=$assertion child_rc=$child_rc plan=unverified missing_set=unverified next_state=STOP"
                }
                return [list child-failure $child_rc $captured_output none]
            }
            set policy_result none
            if {$assertion eq "provision-check"} {
                if {[catch {provision_plan_policy $captured_output check} policy_result]} {
                    puts "B82_V6_PROVISION_AUDIT operation=provision-check child_rc=0 plan=rejected missing_set=unexpected next_state=STOP policy=$policy_result"
                    fail "output-assertion" 78
                }
                set next_state [expr {$policy_result eq "none" ? "POSTFLIGHT" : "AWAIT_APPLY"}]
                puts "B82_V6_PROVISION_AUDIT operation=provision-check child_rc=0 plan=valid missing_set=$policy_result next_state=$next_state"
            } elseif {$assertion eq "provision-apply"} {
                if {[catch {provision_plan_policy $captured_output apply} policy_result]} {
                    puts "B82_V6_PROVISION_AUDIT operation=provision-apply child_rc=0 plan=rejected missing_set=unexpected next_state=STOP policy=$policy_result"
                    fail "output-assertion" 78
                }
                puts "B82_V6_PROVISION_AUDIT operation=provision-apply child_rc=0 plan=valid missing_set=$policy_result next_state=POSTFLIGHT"
            } elseif {[catch {assert_output $assertion $captured_output} assertion_message]} {
                fail "output-assertion" 78
            }
            set password ""
            return [list ok 0 $captured_output $policy_result]
        }
    }
}

proc execute_primitive {values manifest_sha operation approved_sha password} {
    require_manifest_authority $values $manifest_sha
    if {[catch {build_operation $values $manifest_sha $operation $approved_sha} operation_spec]} {
        fail "policy" 66
    }
    return [execute_operation_spec $operation $operation_spec $password]
}

proc require_primitive_success {result} {
    if {[lindex $result 0] ne "ok"} {
        exit [lindex $result 1]
    }
    return $result
}

proc transaction_step {values manifest_sha operation approved_sha password} {
    set result [execute_primitive $values $manifest_sha $operation $approved_sha $password]
    require_primitive_success $result
    puts "B82_V6_TRANSPORT_TRANSACTION_STEP operation=$operation rc=0"
    return $result
}

proc execute_retirement_primitive {values manifest_sha predecessor_values operation password} {
    require_manifest_authority $values $manifest_sha
    if {$predecessor_values ne ""} {
        require_manifest_authority $predecessor_values \
            $::PREDECESSOR_MANIFEST_SHA256
    }
    if {[catch {build_retirement_operation $values $manifest_sha \
        $predecessor_values $operation} operation_spec]} {
        fail "retirement-policy" 66
    }
    return [execute_operation_spec $operation $operation_spec $password]
}

proc retirement_step {values manifest_sha predecessor_values operation password} {
    set result [execute_retirement_primitive $values $manifest_sha \
        $predecessor_values $operation $password]
    require_primitive_success $result
    puts "B82_V6_RETIREMENT_STEP operation=$operation rc=0"
    return $result
}

proc retirement_predecessor_step {values manifest_sha predecessor_values operation password} {
    require_manifest_authority $values $manifest_sha
    set result [execute_primitive $predecessor_values \
        $::PREDECESSOR_MANIFEST_SHA256 $operation none $password]
    require_primitive_success $result
    puts "B82_V6_RETIREMENT_STEP operation=$operation authority=predecessor rc=0"
    return $result
}

proc retirement_path_exists {values manifest_sha predecessor_values path_name password} {
    set operation "retire-ro-exists-${path_name}"
    set result [execute_retirement_primitive $values $manifest_sha \
        $predecessor_values $operation $password]
    if {[lindex $result 0] eq "ok"} {
        return 1
    }
    if {[lindex $result 0] eq "child-failure" && [lindex $result 1] == 1} {
        return 0
    }
    exit [lindex $result 1]
}

proc retirement_read_entries {values manifest_sha predecessor_values operation password} {
    set result [retirement_step $values $manifest_sha $predecessor_values \
        $operation $password]
    set value [output_value [lindex $result 2]]
    if {$value eq ""} {
        return {}
    }
    if {[string first "\u0000" $value] >= 0 || [string first "\r" $value] >= 0} {
        fail "retirement-entry-framing" 78
    }
    return [split $value "\n"]
}

proc retirement_require_entries {actual expected reason} {
    if {[llength $actual] != [llength $expected] ||
        [lsort -ascii $actual] ne [lsort -ascii $expected]} {
        fail $reason 78
    }
}

proc retirement_observe_sha {values manifest_sha predecessor_values operation path password} {
    set result [retirement_step $values $manifest_sha $predecessor_values \
        $operation $password]
    set value [output_value [lindex $result 2]]
    set digest [string range $value 0 63]
    if {![regexp {^[0-9a-f]{64}$} $digest] ||
        [string range $value 64 end] ne "  ${path}"} {
        fail "retirement-sha-output" 78
    }
    return $digest
}

proc retirement_observe_user_file_size {values manifest_sha predecessor_values operation password} {
    set result [retirement_step $values $manifest_sha $predecessor_values \
        $operation $password]
    set value [output_value [lindex $result 2]]
    if {![regexp {^siyixuan:siyixuan:600:1:([0-9]+):regular file$} \
        $value -> size] || ![string is integer -strict $size] ||
        $size < 0 || $size > 16777216} {
        fail "retirement-intake-file-shape" 78
    }
    return $size
}

proc retirement_require_intake_prefix {values manifest_sha predecessor_values name password} {
    switch -- $name {
        package-manifest.v1 {
            set shape_operation retire-ro-intake-manifest-shape-observe
            set sha_operation retire-ro-intake-manifest-sha-observe
        }
        prepare-stage-root.sh {
            set shape_operation retire-ro-intake-self-shape-observe
            set sha_operation retire-ro-intake-self-sha-observe
        }
        default { fail "retirement-intake-prefix-name" 78 }
    }
    if {[catch {retirement_local_delivery_file $values $manifest_sha $name} \
        local_authority]} {
        fail "retirement-intake-local-authority" 66
    }
    lassign $local_authority local_path expected_sha
    if {[catch {file lstat $local_path local_stat}]} {
        fail "retirement-intake-local-stat" 66
    }
    set remote_path "${::RETIREMENT_USER_INTAKE}/${name}"
    set remote_size [retirement_observe_user_file_size $values $manifest_sha \
        $predecessor_values $shape_operation $password]
    set remote_sha [retirement_observe_sha $values $manifest_sha \
        $predecessor_values $sha_operation $remote_path $password]
    if {$remote_sha eq $expected_sha} {
        return exact
    }
    if {$remote_size > $local_stat(size) ||
        [catch {file_prefix_sha256 $local_path $remote_size} prefix_sha] ||
        $remote_sha ne $prefix_sha} {
        fail "retirement-intake-nonprefix" 78
    }
    if {[catch {retirement_local_delivery_file $values $manifest_sha $name} \
        rechecked_authority]} {
        fail "retirement-intake-local-drift" 66
    }
    lassign $rechecked_authority rechecked_path rechecked_sha
    if {[catch {file lstat $rechecked_path rechecked_stat}] ||
        $rechecked_path ne $local_path || $rechecked_sha ne $expected_sha} {
        fail "retirement-intake-local-drift" 66
    }
    foreach field {dev ino size mode nlink uid gid type} {
        if {$rechecked_stat($field) ne $local_stat($field)} {
            fail "retirement-intake-local-drift" 66
        }
    }
    return prefix
}

proc retirement_verify_manifest_pair {values manifest_sha predecessor_values password} {
    foreach operation {
        retire-ro-auth-manifest-pending-sha retire-ro-auth-manifest-sha
        retire-ro-auth-manifest-stat retire-ro-auth-manifest-pair
    } {
        retirement_step $values $manifest_sha $predecessor_values \
            $operation $password
    }
}

proc retirement_verify_self_pair {values manifest_sha predecessor_values password} {
    foreach operation {
        retire-ro-auth-self-pending-sha retire-ro-auth-self-sha
        retire-ro-auth-self-stat retire-ro-auth-self-pair
    } {
        retirement_step $values $manifest_sha $predecessor_values \
            $operation $password
    }
}

proc retirement_authority_state {values manifest_sha predecessor_values password} {
    set names {
        home-qroot auth-root run-qroot auth-manifest-pending auth-manifest
        auth-self-pending auth-self quarantine-intake quarantine-package
        quarantine-bootstrap lock receipt-pending receipt-final
    }
    set present [dict create]
    foreach name $names {
        dict set present $name [retirement_path_exists $values $manifest_sha \
            $predecessor_values $name $password]
    }

    set home [dict get $present home-qroot]
    set auth [dict get $present auth-root]
    set run [dict get $present run-qroot]
    set manifest_pending [dict get $present auth-manifest-pending]
    set manifest_final [dict get $present auth-manifest]
    set self_pending [dict get $present auth-self-pending]
    set self_final [dict get $present auth-self]

    if {$manifest_pending && $manifest_final && $self_pending && $self_final} {
        if {!$home || !$auth || !$run} {
            fail "retirement-authority-parent-missing" 78
        }
        foreach operation {
            retire-ro-home-qroot-readlink retire-ro-home-qroot-stat
            retire-ro-auth-root-readlink retire-ro-auth-root-stat
            retire-ro-run-qroot-readlink retire-ro-run-qroot-stat
        } {
            retirement_step $values $manifest_sha $predecessor_values \
                $operation $password
        }
        retirement_require_entries \
            [retirement_read_entries $values $manifest_sha $predecessor_values \
                retire-ro-auth-root-entries $password] \
            [list "package-manifest.v1.pending\tf" \
                "package-manifest.v1\tf" "prepare-stage-root.sh.pending\tf" \
                "prepare-stage-root.sh\tf"] \
            "retirement-authority-entry-set"
        retirement_verify_manifest_pair $values $manifest_sha \
            $predecessor_values $password
        retirement_verify_self_pair $values $manifest_sha \
            $predecessor_values $password
        return complete
    }

    foreach name {
        quarantine-intake quarantine-package quarantine-bootstrap lock
        receipt-pending receipt-final
    } {
        if {[dict get $present $name]} {
            fail "retirement-prefix-without-complete-authority" 78
        }
    }
    if {!$home} {
        foreach name {
            auth-root run-qroot auth-manifest-pending auth-manifest
            auth-self-pending auth-self
        } {
            if {[dict get $present $name]} {
                fail "retirement-prefix-parent-order" 78
            }
        }
        return absent
    }

    foreach operation {retire-ro-home-qroot-readlink retire-ro-home-qroot-stat} {
        retirement_step $values $manifest_sha $predecessor_values \
            $operation $password
    }
    if {!$auth} {
        foreach name {
            run-qroot auth-manifest-pending auth-manifest auth-self-pending auth-self
        } {
            if {[dict get $present $name]} {
                fail "retirement-prefix-auth-order" 78
            }
        }
        retirement_require_entries \
            [retirement_read_entries $values $manifest_sha $predecessor_values \
                retire-ro-home-qroot-entries $password] {} \
            "retirement-home-prefix-entries"
        return home-qroot
    }

    foreach operation {retire-ro-auth-root-readlink retire-ro-auth-root-stat} {
        retirement_step $values $manifest_sha $predecessor_values \
            $operation $password
    }
    retirement_require_entries \
        [retirement_read_entries $values $manifest_sha $predecessor_values \
            retire-ro-home-qroot-entries $password] [list "authority\td"] \
        "retirement-home-prefix-entries"
    if {!$run} {
        foreach name {
            auth-manifest-pending auth-manifest auth-self-pending auth-self
        } {
            if {[dict get $present $name]} {
                fail "retirement-prefix-run-order" 78
            }
        }
        retirement_require_entries \
            [retirement_read_entries $values $manifest_sha $predecessor_values \
                retire-ro-auth-root-entries $password] {} \
            "retirement-auth-prefix-entries"
        return auth-root
    }

    foreach operation {retire-ro-run-qroot-readlink retire-ro-run-qroot-stat} {
        retirement_step $values $manifest_sha $predecessor_values \
            $operation $password
    }
    retirement_require_entries \
        [retirement_read_entries $values $manifest_sha $predecessor_values \
            retire-ro-run-qroot-entries $password] {} \
        "retirement-run-prefix-entries"
    if {!$manifest_pending && !$manifest_final && !$self_pending && !$self_final} {
        retirement_require_entries \
            [retirement_read_entries $values $manifest_sha $predecessor_values \
                retire-ro-auth-root-entries $password] {} \
            "retirement-auth-prefix-entries"
        return run-qroot
    }
    if {$manifest_pending && !$manifest_final && !$self_pending && !$self_final} {
        retirement_require_entries \
            [retirement_read_entries $values $manifest_sha $predecessor_values \
                retire-ro-auth-root-entries $password] \
            [list "package-manifest.v1.pending\tf"] \
            "retirement-auth-prefix-entries"
        retirement_step $values $manifest_sha $predecessor_values \
            retire-ro-auth-manifest-pending-stat $password
        return manifest-pending
    }
    if {$manifest_pending && $manifest_final && !$self_pending && !$self_final} {
        retirement_require_entries \
            [retirement_read_entries $values $manifest_sha $predecessor_values \
                retire-ro-auth-root-entries $password] \
            [list "package-manifest.v1.pending\tf" "package-manifest.v1\tf"] \
            "retirement-auth-prefix-entries"
        retirement_verify_manifest_pair $values $manifest_sha \
            $predecessor_values $password
        return manifest-pair
    }
    if {$manifest_pending && $manifest_final && $self_pending && !$self_final} {
        retirement_require_entries \
            [retirement_read_entries $values $manifest_sha $predecessor_values \
                retire-ro-auth-root-entries $password] \
            [list "package-manifest.v1.pending\tf" "package-manifest.v1\tf" \
                "prepare-stage-root.sh.pending\tf"] \
            "retirement-auth-prefix-entries"
        retirement_verify_manifest_pair $values $manifest_sha \
            $predecessor_values $password
        retirement_step $values $manifest_sha $predecessor_values \
            retire-ro-auth-self-pending-stat $password
        return self-pending
    }
    fail "retirement-authority-prefix" 78
}

proc retirement_ensure_delivery {values manifest_sha predecessor_values password} {
    set intake_exists [retirement_path_exists $values $manifest_sha \
        $predecessor_values user-intake $password]
    if {!$intake_exists} {
        retirement_step $values $manifest_sha $predecessor_values \
            retire-raw-intake-mkdir $password
    }
    foreach operation {retire-ro-intake-readlink retire-ro-intake-stat} {
        retirement_step $values $manifest_sha $predecessor_values \
            $operation $password
    }
    set entries [retirement_read_entries $values $manifest_sha \
        $predecessor_values retire-ro-intake-entries $password]
    set manifest_entry "package-manifest.v1\tf"
    set self_entry "prepare-stage-root.sh\tf"
    if {$entries eq {}} {
        retirement_step $values $manifest_sha $predecessor_values \
            retire-raw-scp-manifest $password
        set entries [list $manifest_entry]
    } elseif {[llength $entries] == 1 && [lindex $entries 0] eq $manifest_entry} {
        set prefix_state [retirement_require_intake_prefix $values $manifest_sha \
            $predecessor_values package-manifest.v1 $password]
        if {$prefix_state eq "prefix"} {
            retirement_step $values $manifest_sha $predecessor_values \
                retire-raw-scp-manifest $password
        }
    } elseif {[llength $entries] == 2 &&
        [lsort -ascii $entries] eq [lsort -ascii [list $manifest_entry $self_entry]]} {
        if {[retirement_require_intake_prefix $values $manifest_sha \
            $predecessor_values package-manifest.v1 $password] ne "exact"} {
            fail "retirement-intake-earlier-prefix" 78
        }
        set prefix_state [retirement_require_intake_prefix $values $manifest_sha \
            $predecessor_values prepare-stage-root.sh $password]
        if {$prefix_state eq "prefix"} {
            retirement_step $values $manifest_sha $predecessor_values \
                retire-raw-scp-self $password
        }
    } else {
        fail "retirement-intake-prefix" 78
    }

    foreach operation {retire-ro-intake-manifest-stat retire-ro-intake-manifest-sha} {
        retirement_step $values $manifest_sha $predecessor_values \
            $operation $password
    }
    set entries [retirement_read_entries $values $manifest_sha \
        $predecessor_values retire-ro-intake-entries $password]
    if {[llength $entries] == 1 && [lindex $entries 0] eq $manifest_entry} {
        retirement_step $values $manifest_sha $predecessor_values \
            retire-raw-scp-self $password
    }
    foreach operation {retire-ro-intake-self-stat retire-ro-intake-self-sha} {
        retirement_step $values $manifest_sha $predecessor_values \
            $operation $password
    }
    retirement_require_entries \
        [retirement_read_entries $values $manifest_sha $predecessor_values \
            retire-ro-intake-entries $password] \
        [list $manifest_entry $self_entry] "retirement-intake-final-entries"
}

proc retirement_converge_delivery_durability {
    values manifest_sha predecessor_values password
} {
    foreach operation {
        retire-raw-sync-intake-manifest retire-raw-sync-intake-self
        retire-raw-sync-intake-directory retire-raw-sync-intake-parent
    } {
        retirement_step $values $manifest_sha $predecessor_values \
            $operation $password
    }
    transaction_step $values $manifest_sha package-parent-stat none $password
    foreach operation {
        retire-ro-intake-readlink retire-ro-intake-stat
        retire-ro-intake-manifest-stat retire-ro-intake-manifest-sha
        retire-ro-intake-self-stat retire-ro-intake-self-sha
    } {
        retirement_step $values $manifest_sha $predecessor_values \
            $operation $password
    }
    retirement_require_entries \
        [retirement_read_entries $values $manifest_sha $predecessor_values \
            retire-ro-intake-entries $password] \
        [list "package-manifest.v1\tf" "prepare-stage-root.sh\tf"] \
        "retirement-intake-postsync-entries"
    puts "B82_V6_RETIREMENT_INTAKE_DURABLE files=2 directories=2 postcheck=exact"
}

proc execute_retirement_common_gate {values manifest_sha password} {
    foreach operation [base_identity_operations] {
        transaction_step $values $manifest_sha $operation none $password
    }
    set stale_operations [retirement_stale_operations]
    set total [llength $stale_operations]
    set ordinal 0
    foreach operation $stale_operations {
        incr ordinal
        set result [execute_primitive $values $manifest_sha $operation none $password]
        set id [string range $operation 6 end]
        if {[lindex $result 0] ne "ok"} {
            set rc [lindex $result 1]
            puts [format "B82_V6_RETIREMENT_STALE_ITEM ordinal=%02d id=%s class=STOP writes=0 rc=%d" $ordinal $id $rc]
            puts "B82_V6_RETIREMENT_STALE_SUMMARY items=$total checked=$ordinal result=STOP writes=0 rc=$rc"
            exit $rc
        }
        puts [format "B82_V6_RETIREMENT_STALE_ITEM ordinal=%02d id=%s class=ABSENT writes=0 rc=0" $ordinal $id]
    }
    puts "B82_V6_RETIREMENT_STALE_SUMMARY items=$total checked=$total absent=$total result=PASS writes=0 rc=0"
    puts "B82_V6_RETIREMENT_COMMON_GATE identities=5 stale_absent=28 writes=0 result=PASS"
}

proc execute_retirement_predecessor_gate {values manifest_sha predecessor_values password} {
    transaction_step $values $manifest_sha package-parent-stat none $password
    foreach operation {
        retire-ro-old-package-readlink retire-ro-old-package-stat
        retire-ro-old-package-entries
    } {
        retirement_step $values $manifest_sha $predecessor_values \
            $operation $password
    }
    foreach name [package_names] {
        retirement_predecessor_step $values $manifest_sha $predecessor_values \
            "verify-sha-$name" $password
        retirement_predecessor_step $values $manifest_sha $predecessor_values \
            "verify-stat-$name" $password
    }
    foreach operation {
        bootstrap-root-readlink bootstrap-root-stat
        bootstrap-provisioner-readlink bootstrap-provisioner-stat
        bootstrap-provisioner-sha bootstrap-stager-readlink bootstrap-stager-stat
        bootstrap-stager-sha
    } {
        retirement_predecessor_step $values $manifest_sha $predecessor_values \
            $operation $password
    }
    retirement_step $values $manifest_sha $predecessor_values \
        retire-ro-old-bootstrap-entries $password
    set provision_result [retirement_predecessor_step $values $manifest_sha \
        $predecessor_values provision-check $password]
    if {[lindex $provision_result 3] ne "none"} {
        fail "retirement-predecessor-provision-check" 78
    }
    puts "B82_V6_RETIREMENT_PREDECESSOR_GATE package_files=17 bootstrap_files=2 provision_missing=none writes=0 result=PASS"
}

proc retirement_ensure_authority {values manifest_sha predecessor_values state password} {
    if {$state eq "absent"} {
        retirement_step $values $manifest_sha $predecessor_values \
            retire-raw-home-qroot-create $password
        set state [retirement_authority_state $values $manifest_sha \
            $predecessor_values $password]
        if {$state ne "home-qroot"} { fail "retirement-home-create-state" 78 }
    }
    if {$state eq "home-qroot"} {
        retirement_step $values $manifest_sha $predecessor_values \
            retire-raw-sync-home-parent $password
        retirement_step $values $manifest_sha $predecessor_values \
            retire-raw-auth-root-create $password
        set state [retirement_authority_state $values $manifest_sha \
            $predecessor_values $password]
        if {$state ne "auth-root"} { fail "retirement-auth-create-state" 78 }
    }
    if {$state eq "auth-root"} {
        retirement_step $values $manifest_sha $predecessor_values \
            retire-raw-sync-home-qroot $password
        retirement_step $values $manifest_sha $predecessor_values \
            retire-raw-run-qroot-create $password
        set state [retirement_authority_state $values $manifest_sha \
            $predecessor_values $password]
        if {$state ne "run-qroot"} { fail "retirement-run-create-state" 78 }
    }
    if {$state eq "run-qroot" || $state eq "manifest-pending"} {
        retirement_step $values $manifest_sha $predecessor_values \
            retire-raw-sync-run-parent $password
        retirement_step $values $manifest_sha $predecessor_values \
            retire-raw-auth-manifest-install $password
        foreach operation {
            retire-ro-auth-manifest-pending-stat
            retire-ro-auth-manifest-pending-sha
            retire-raw-sync-auth-manifest-pending retire-raw-sync-auth-root
        } {
            retirement_step $values $manifest_sha $predecessor_values \
                $operation $password
        }
        if {[retirement_path_exists $values $manifest_sha $predecessor_values \
            auth-manifest $password]} {
            fail "retirement-manifest-final-before-link" 78
        }
        retirement_step $values $manifest_sha $predecessor_values \
            retire-raw-link-auth-manifest $password
        retirement_step $values $manifest_sha $predecessor_values \
            retire-raw-sync-auth-root $password
        set state [retirement_authority_state $values $manifest_sha \
            $predecessor_values $password]
        if {$state ne "manifest-pair"} { fail "retirement-manifest-pair-state" 78 }
    }
    if {$state eq "manifest-pair" || $state eq "self-pending"} {
        retirement_step $values $manifest_sha $predecessor_values \
            retire-raw-sync-auth-manifest-pending $password
        retirement_step $values $manifest_sha $predecessor_values \
            retire-raw-sync-auth-root $password
        retirement_step $values $manifest_sha $predecessor_values \
            retire-raw-auth-self-install $password
        foreach operation {
            retire-ro-auth-self-pending-stat retire-ro-auth-self-pending-sha
            retire-raw-sync-auth-self-pending retire-raw-sync-auth-root
        } {
            retirement_step $values $manifest_sha $predecessor_values \
                $operation $password
        }
        if {[retirement_path_exists $values $manifest_sha $predecessor_values \
            auth-self $password]} {
            fail "retirement-self-final-before-link" 78
        }
        retirement_step $values $manifest_sha $predecessor_values \
            retire-raw-link-auth-self $password
        retirement_step $values $manifest_sha $predecessor_values \
            retire-raw-sync-auth-root $password
        set state [retirement_authority_state $values $manifest_sha \
            $predecessor_values $password]
        if {$state ne "complete"} { fail "retirement-authority-complete-state" 78 }
    }
    if {$state ne "complete"} {
        fail "retirement-authority-state" 78
    }
    foreach operation {
        retire-raw-sync-auth-manifest-pending retire-raw-sync-auth-self-pending
        retire-raw-sync-auth-root
    } {
        retirement_step $values $manifest_sha $predecessor_values \
            $operation $password
    }
    if {[retirement_authority_state $values $manifest_sha \
        $predecessor_values $password] ne "complete"} {
        fail "retirement-authority-final-recheck" 78
    }
}

proc execute_retirement_transaction {values manifest_sha predecessor_values password} {
    puts "B82_V6_RETIREMENT_TRANSACTION_START retire_id=$::RETIRE_ID operation=retire-prestage-2c690050 sequence=fixed caller_argv=forbidden"
    set state [retirement_authority_state $values $manifest_sha \
        $predecessor_values $password]
    if {$state ne "complete"} {
        execute_retirement_common_gate $values $manifest_sha $password
        execute_retirement_predecessor_gate $values $manifest_sha \
            $predecessor_values $password
        retirement_ensure_delivery $values $manifest_sha \
            $predecessor_values $password
        retirement_converge_delivery_durability $values $manifest_sha \
            $predecessor_values $password
    }
    retirement_ensure_authority $values $manifest_sha $predecessor_values \
        $state $password
    execute_retirement_common_gate $values $manifest_sha $password
    retirement_step $values $manifest_sha $predecessor_values \
        retire-raw-helper-mutate $password
    retirement_step $values $manifest_sha $predecessor_values \
        retire-ro-helper-verify $password
    puts "B82_V6_RETIREMENT_TRANSACTION_COMPLETE retire_id=$::RETIRE_ID state=T automatic_cleanup=0 retention=quarantine"
}

proc execute_retirement_verify_transaction {values manifest_sha predecessor_values password} {
    set state [retirement_authority_state $values $manifest_sha \
        $predecessor_values $password]
    if {$state ne "complete"} {
        fail "retirement-verify-authority-state" 78
    }
    retirement_step $values $manifest_sha $predecessor_values \
        retire-ro-helper-verify $password
    puts "B82_V6_RETIREMENT_VERIFY_COMPLETE retire_id=$::RETIRE_ID state=T mutations=0"
}

proc execute_stale_transaction_gate {values manifest_sha password} {
    set operations [prepare_stale_operations]
    set total [llength $operations]
    set ordinal 0
    foreach operation $operations {
        incr ordinal
        set result [execute_primitive $values $manifest_sha $operation none $password]
        set id [string range $operation 6 end]
        if {[lindex $result 0] ne "ok"} {
            set rc [lindex $result 1]
            puts [format "B82_V6_STALE_ITEM_V1 ordinal=%02d id=%s class=STOP writes=0 cleanup=0 rc=%d" $ordinal $id $rc]
            puts "B82_V6_STALE_SUMMARY_V1 profile=prepare-new items=$total checked=$ordinal absent=[expr {$ordinal - 1}] writes=0 cleanup=0 result=STOP rc=$rc"
            exit $rc
        }
        puts [format "B82_V6_STALE_ITEM_V1 ordinal=%02d id=%s class=ABSENT writes=0 cleanup=0 rc=0" $ordinal $id]
    }
    puts "B82_V6_STALE_SUMMARY_V1 profile=prepare-new items=$total checked=$total absent=$total writes=0 cleanup=0 result=PASS rc=0"
}

proc verify_remote_package_transaction {values manifest_sha password} {
    foreach name [package_names] {
        transaction_step $values $manifest_sha "verify-sha-$name" none $password
        transaction_step $values $manifest_sha "verify-stat-$name" none $password
    }
}

proc verify_provisioner_transaction {values manifest_sha password} {
    foreach operation [provisioner_verify_operations] {
        transaction_step $values $manifest_sha $operation none $password
    }
}

proc execute_postflight_transaction {values manifest_sha password} {
    verify_remote_package_transaction $values $manifest_sha $password
    foreach operation [concat [postflight_operations] {
        controller-shellcheck hermetic-matrix hermetic-fresh
    }] {
        transaction_step $values $manifest_sha $operation none $password
    }
    foreach operation [stager_verify_operations] {
        transaction_step $values $manifest_sha $operation none $password
    }
    foreach operation [stage_operations] {
        transaction_step $values $manifest_sha $operation none $password
    }
    puts "B82_V6_CONTROLLER_POSTFLIGHT_COMPLETE state=POSTFLIGHT"
}

proc execute_prepare_transaction {values manifest_sha password} {
    foreach operation [base_identity_operations] {
        transaction_step $values $manifest_sha $operation none $password
    }
    execute_stale_transaction_gate $values $manifest_sha $password
    transaction_step $values $manifest_sha package-parent-stat none $password
    transaction_step $values $manifest_sha package-mkdir none $password
    foreach name [package_names] {
        transaction_step $values $manifest_sha "scp-$name" none $password
        transaction_step $values $manifest_sha "verify-sha-$name" none $password
        transaction_step $values $manifest_sha "verify-stat-$name" none $password
    }
    foreach operation [bootstrap_create_operations] {
        transaction_step $values $manifest_sha $operation none $password
    }
    puts "B82_V6_CONTROLLER_STATE from=PACKAGE_BOUND to=BOOTSTRAP_ONLY automatic_apply=0"
    verify_provisioner_transaction $values $manifest_sha $password
    puts "B82_V6_CONTROLLER_STATE from=BOOTSTRAP_ONLY to=PROVISION_CHECK automatic_apply=0"
    set result [transaction_step $values $manifest_sha provision-check none $password]
    set missing [lindex $result 3]
    if {$missing eq "none"} {
        puts "B82_V6_CONTROLLER_STATE from=PROVISION_CHECK to=POSTFLIGHT automatic_apply=0"
        execute_postflight_transaction $values $manifest_sha $password
        return POSTFLIGHT
    }
    if {$missing ni {initial iperf3}} { fail "provision-state" 78 }
    puts "B82_V6_CONTROLLER_STATE from=PROVISION_CHECK to=AWAIT_APPLY automatic_apply=0"
    puts "B82_V6_PROVISION_AWAIT_APPLY missing_set=$missing explicit_mode=provision-apply automatic_apply=0"
    return AWAIT_APPLY
}

proc execute_provision_apply_transaction {values manifest_sha password} {
    foreach operation [concat [base_identity_operations] [bootstrap_verify_operations]] {
        transaction_step $values $manifest_sha $operation none $password
    }
    verify_remote_package_transaction $values $manifest_sha $password
    verify_provisioner_transaction $values $manifest_sha $password
    puts "B82_V6_CONTROLLER_STATE from=BOOTSTRAP_ONLY to=PROVISION_CHECK automatic_apply=0"
    set result [transaction_step $values $manifest_sha provision-check none $password]
    set missing [lindex $result 3]
    if {$missing eq "none"} {
        puts "B82_V6_CONTROLLER_STATE from=PROVISION_CHECK to=POSTFLIGHT automatic_apply=0"
        execute_postflight_transaction $values $manifest_sha $password
        return POSTFLIGHT
    }
    if {$missing ni {initial iperf3}} { fail "provision-state" 78 }
    puts "B82_V6_CONTROLLER_STATE from=PROVISION_CHECK to=AWAIT_APPLY automatic_apply=0"
    puts "B82_V6_CONTROLLER_STATE from=AWAIT_APPLY to=PROVISION_APPLY automatic_apply=0"
    verify_provisioner_transaction $values $manifest_sha $password
    set apply_result [transaction_step $values $manifest_sha provision-apply none $password]
    if {[lindex $apply_result 3] ne $missing} { fail "provision-apply-state" 78 }
    verify_provisioner_transaction $values $manifest_sha $password
    set post_result [transaction_step $values $manifest_sha provision-check none $password]
    if {[lindex $post_result 3] ne "none"} { fail "provision-postcheck" 78 }
    puts "B82_V6_CONTROLLER_STATE from=PROVISION_APPLY to=POSTFLIGHT automatic_apply=0"
    execute_postflight_transaction $values $manifest_sha $password
    return POSTFLIGHT
}

proc execute_transaction {values manifest_sha operation approved_sha password} {
    puts "B82_V6_TRANSPORT_TRANSACTION_START operation=$operation sequence=fixed caller_argv=forbidden"
    switch -- $operation {
        prepare {
            set result [execute_prepare_transaction $values $manifest_sha $password]
        }
        provision-apply {
            set result [execute_provision_apply_transaction $values $manifest_sha $password]
        }
        fresh-run - fresh-restore - veth-run - veth-restore -
        routed-run - routed-restore {
            transaction_step $values $manifest_sha $operation none $password
            set result COMPLETE
        }
        realnic-run {
            foreach primitive {
                scp-realnic-approved-plan verify-sha-realnic-approved-plan
                verify-stat-realnic-approved-plan stage-realnic-plan-snapshot realnic-run
            } {
                transaction_step $values $manifest_sha $primitive $approved_sha $password
            }
            set result COMPLETE
        }
        realnic-restore {
            foreach primitive {stage-realnic-plan-verify realnic-restore} {
                transaction_step $values $manifest_sha $primitive $approved_sha $password
            }
            set result COMPLETE
        }
        default { fail "transaction-operation" 65 }
    }
    puts "B82_V6_TRANSPORT_TRANSACTION_COMPLETE operation=$operation result=$result"
}

proc transport_main {arguments} {
    set argc [llength $arguments]
    set argv $arguments
    if {$argc != 12 ||
        [lindex $argv 0] ne "--manifest" ||
        [lindex $argv 2] ne "--manifest-sha256" ||
        [lindex $argv 4] ne "--credential-path" ||
        [lindex $argv 6] ne "--action" ||
        [lindex $argv 8] ne "--operation" ||
        [lindex $argv 10] ne "--approved-plan-sha256"} {
        fail "arguments" 64
    }
    set manifest [lindex $argv 1]
    set manifest_sha [lindex $argv 3]
    set credential_path [lindex $argv 5]
    set action [lindex $argv 7]
    set operation [lindex $argv 9]
    set approved_sha [lindex $argv 11]

    if {![regexp {^[0-9a-f]{64}$} $manifest_sha] ||
        $credential_path ne "/Users/siyixuan/codes-2/wg-mix-ebpf/credientials/192.168.10.82" ||
        $action ni {plan execute capture} ||
        ![regexp {^[A-Za-z0-9_.-]+$} $operation] ||
        !($approved_sha eq "none" || [regexp {^[0-9a-f]{64}$} $approved_sha])} {
        fail "argument-values" 65
    }
    if {($action eq "capture" && $operation ne "realnic-plan") ||
        ($action eq "execute" && ![transaction_operation $operation] &&
         ![read_only_operation $operation])} {
        fail "action-operation" 65
    }
    set sha_is_valid [expr {
        [regexp {^[0-9a-f]{64}$} $approved_sha] &&
        ![regexp {^0{64}$} $approved_sha] &&
        ![regexp {^f{64}$} $approved_sha]
    }]
    if {([operation_requires_approved_sha $operation] && !$sha_is_valid) ||
        (![operation_requires_approved_sha $operation] && $approved_sha ne "none")} {
        fail "approved-plan-sha-operation" 65
    }
    if {[catch {load_manifest $manifest $manifest_sha} values] ||
        $manifest ne "[dict get $values local_package_dir]/package-manifest.v1" ||
        [catch {validate_manifest_values $values} validation_message] ||
        [catch {validate_self $values} self_message]} {
        fail "policy" 66
    }
    if {[catch {exec /usr/bin/id -u} caller_uid] ||
        ![regexp {^[0-9]+$} $caller_uid] ||
        [catch {file lstat $manifest manifest_stat}] ||
        [catch {file lstat [dict get $values local_package_dir] package_stat}] ||
        $manifest_stat(type) ne "file" || $manifest_stat(nlink) != 1 ||
        ($manifest_stat(mode) & 07777) != 0600 ||
        $package_stat(type) ne "directory" || ($package_stat(mode) & 07777) != 0700 ||
        $package_stat(uid) != $caller_uid ||
        $manifest_stat(uid) != $package_stat(uid) ||
        $manifest_stat(gid) != $package_stat(gid)} {
        fail "local-package-owner" 66
    }
    if {$action eq "plan"} {
        if {[retirement_mutation_operation $operation] ||
            [retirement_read_only_operation $operation]} {
            set helper_mode [expr {[retirement_mutation_operation $operation] ?
                "retire-prestage-2c690050" : "verify-retirement"}]
            puts "B82_V6_TRANSPORT_PLAN operation=$operation transport=high-level-fixed credential_read=0 network_operations=0 raw_leaves=unreachable"
            puts "EXPECT_PROGRAM [info nameofexecutable] SCRIPT $::TRANSPORT_SCRIPT_PATH"
            puts "RETIREMENT_AUTH_SELF_ARGV [list {*}[retirement_helper_remote_argv \
                $values $manifest_sha $helper_mode]]"
            exit 0
        }
        if {[catch {build_operation $values $manifest_sha $operation $approved_sha} operation_spec]} {
            fail "policy" 66
        }
        lassign $operation_spec transport_type spawn_argv prompt_limit assertion timeout_seconds
        puts "B82_V6_TRANSPORT_PLAN operation=$operation transport=$transport_type credential_read=0 network_operations=0"
        puts "EXPECT_PROGRAM [info nameofexecutable] SCRIPT $::TRANSPORT_SCRIPT_PATH"
        puts "EXPECT_SPAWN_ARGV [list {*}$spawn_argv]"
        puts "EXPECT_OUTPUT_ASSERTION [list $assertion]"
        exit 0
    }

    if {$action eq "capture"} {
        if {[catch {build_operation $values $manifest_sha $operation $approved_sha} operation_spec]} {
            fail "policy" 66
        }
        lassign $operation_spec transport_type spawn_argv prompt_limit assertion timeout_seconds
        set password ""
        if {[catch {read_capture_credential $credential_path} password]} {
            set password ""
            fail "credential-value" 65
        }
        puts stderr "B82_V6_TRANSPORT_EXECUTE operation=$operation transport=$transport_type credential_in_argv=0 channel=capture"
        puts stderr "EXPECT_SPAWN_ARGV [list {*}$spawn_argv]"
        log_user 0
        spawn -noecho {*}$spawn_argv
        set child_id $spawn_id
        if {[catch {capture_child_payload $child_id $password $prompt_limit \
            $timeout_seconds} capture_result]} {
            set password ""
            fail "capture-expect" 78
        }
        set password ""
        lassign $capture_result payload credential_sends raw_bytes
        puts stderr "B82_V6_TRANSPORT_CAPTURE operation=$operation child_rc=0 prompts=$credential_sends raw_bytes=$raw_bytes payload_bytes=[string bytelength $payload] framing=canonical"
        fconfigure stdout -encoding binary -translation binary
        puts -nonewline stdout $payload
        flush stdout
        exit 0
    }
    set prebuilt_operation_spec {}
    set predecessor_values {}
    if {[transaction_operation $operation]} {
        require_transaction_local_authority $values $manifest_sha $operation $approved_sha
        if {[retirement_mutation_operation $operation]} {
            set predecessor_values [require_retirement_predecessor_authority]
        }
    } elseif {[retirement_read_only_operation $operation]} {
        require_transaction_local_authority $values $manifest_sha $operation $approved_sha
        set predecessor_values [require_retirement_predecessor_authority]
    } elseif {[catch {build_operation $values $manifest_sha $operation \
        $approved_sha} prebuilt_operation_spec]} {
        fail "policy" 66
    }
    set password [read_execute_credential $credential_path]
    if {[retirement_mutation_operation $operation]} {
        execute_retirement_transaction $values $manifest_sha \
            $predecessor_values $password
    } elseif {[retirement_read_only_operation $operation]} {
        execute_retirement_verify_transaction $values $manifest_sha \
            $predecessor_values $password
    } elseif {[transaction_operation $operation]} {
        execute_transaction $values $manifest_sha $operation $approved_sha $password
    } else {
        require_manifest_authority $values $manifest_sha
        require_primitive_success [execute_operation_spec $operation \
            $prebuilt_operation_spec $password]
    }
    set password ""
    exit 0
}

if {[info exists argv0] && [file normalize $argv0] eq $::TRANSPORT_SCRIPT_PATH} {
    transport_main $argv
}
