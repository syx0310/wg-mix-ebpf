        -o ServerAliveInterval=15 \
        -o ServerAliveCountMax=2 \
        -o ClearAllForwardings=yes \
        -o ForwardAgent=no \
        -o ForwardX11=no \
        -o PermitLocalCommand=no \
        -o LocalCommand=none \
        -o ProxyCommand=none \
        -o ControlMaster=no \
        -o ControlPath=none \
        -o ControlPersist=no \
        -o CanonicalizeHostname=no \
        -o Compression=no \
        -o LogLevel=ERROR]
}

proc env_argv {} {
