proc r2_load_predecessor_manifest {path} {
    if {$path ne "${::R2_PREDECESSOR_LOCAL_PACKAGE}/package-manifest.v1" ||
        [file normalize $path] ne $path ||
        [catch {file lstat $path file_stat}] ||
        $file_stat(type) ne "file" || $file_stat(nlink) != 1 ||
        [file_sha256 $path] ne $::R2_PREDECESSOR_MANIFEST_SHA256} {
        return -code error "r2-predecessor-manifest-path"
    }
    set channel [open $path r]
    fconfigure $channel -encoding utf-8 -translation lf
    set payload [read $channel]
    close $channel
    if {[string first "\u0000" $payload] >= 0 || ![string match "*\n" $payload]} {
        return -code error "r2-predecessor-manifest-encoding"
    }
    set lines [split [string range $payload 0 end-1] "\n"]
    set oracle [r2_predecessor_manifest_oracle]
    if {[llength $lines] != 103 || [llength $oracle] != 206} {
        return -code error "r2-predecessor-manifest-cardinality"
    }
    set values [dict create]
    set index 0
    foreach {expected_key expected_value} $oracle {
        set fields [split [lindex $lines $index] "\t"]
        if {[llength $fields] != 2 ||
            [lindex $fields 0] ne $expected_key ||
            [lindex $fields 1] ne $expected_value} {
            return -code error "r2-predecessor-manifest-field-$expected_key"
        }
        dict set values $expected_key $expected_value
        incr index
    }
    return $values
}

proc load_manifest {path expected_sha} {
    if {[file normalize $path] ne $path || [file type $path] ne "file"} {
        return -code error "manifest-path"
    }
    file lstat $path stat_data
    if {$stat_data(type) ne "file" || $stat_data(nlink) != 1} {
        return -code error "manifest-shape"
    }
    if {[file_sha256 $path] ne $expected_sha} {
        return -code error "manifest-sha256"
    }
    set expected_keys {
        format run_id package_id integration_ref integration_commit
        bundle_name bundle_sha256 history_verification history_commit_count
        history_roots_sha256 history_objects_sha256 wg_state wg_interface wg_local_address
        wg_peer_address local_repository local_package_dir remote_package_dir
        remote_source target_user target_host target_hostname target_kernel
        target_machine_id target_interface peer_address peer_port soak_seconds
        session_seconds physical_nic_forward_authority physical_interface_lock
        legacy_matrix_mode realnic_profile realnic_traffic_seconds
        bind_final_package_sh_path bind_final_package_sh_blob
        bind_final_package_sh_sha256 controller_sh_path controller_sh_blob
        controller_sh_sha256 locked_transport_exp_path locked_transport_exp_blob
        locked_transport_exp_sha256 root_matrix_n_r_sh_path root_matrix_n_r_sh_blob
        root_matrix_n_r_sh_sha256 check_realhost_iperf_py_path
        check_realhost_iperf_py_blob check_realhost_iperf_py_sha256
        test_hermetic_matrix_sh_path test_hermetic_matrix_sh_blob
        test_hermetic_matrix_sh_sha256 test_matrix_static_py_path
        test_matrix_static_py_blob test_matrix_static_py_sha256
        checksum_module_lease_sh_path checksum_module_lease_sh_blob
        checksum_module_lease_sh_sha256
        test_hermetic_checksum_module_lease_sh_path
        test_hermetic_checksum_module_lease_sh_blob
        test_hermetic_checksum_module_lease_sh_sha256
        test_checksum_module_lease_static_py_path
        test_checksum_module_lease_static_py_blob
        test_checksum_module_lease_static_py_sha256
        wg_mix_faketcp_checksum_c_path wg_mix_faketcp_checksum_c_blob
        wg_mix_faketcp_checksum_c_sha256 root_fresh_verifier_gate_sh_path
        root_fresh_verifier_gate_sh_blob root_fresh_verifier_gate_sh_sha256
        test_hermetic_fresh_verifier_gate_sh_path
        test_hermetic_fresh_verifier_gate_sh_blob
        test_hermetic_fresh_verifier_gate_sh_sha256
        test_fresh_verifier_gate_static_py_path
        test_fresh_verifier_gate_static_py_blob
        test_fresh_verifier_gate_static_py_sha256
        prepare_stage_root_sh_path prepare_stage_root_sh_blob
        prepare_stage_root_sh_sha256 realnic_acceptance_py_path
        realnic_acceptance_py_blob realnic_acceptance_py_sha256
        test_realnic_acceptance_py_path test_realnic_acceptance_py_blob
        test_realnic_acceptance_py_sha256 test_realnic_acceptance_static_py_path
        test_realnic_acceptance_static_py_blob test_realnic_acceptance_static_py_sha256
        provision_ubuntu_test_host_sh_path
        provision_ubuntu_test_host_sh_blob provision_ubuntu_test_host_sh_sha256
        root_veth_n_r_sh_path root_veth_n_r_sh_blob root_veth_n_r_sh_sha256
        test_hermetic_veth_runner_sh_path test_hermetic_veth_runner_sh_blob
        test_hermetic_veth_runner_sh_sha256 test_veth_runner_static_py_path
        test_veth_runner_static_py_blob test_veth_runner_static_py_sha256
        controller_seam_sh_path controller_seam_sh_blob controller_seam_sh_sha256
        root_routed_veth_n_r_sh_path root_routed_veth_n_r_sh_blob
        root_routed_veth_n_r_sh_sha256 test_hermetic_routed_veth_harness_sh_path
        test_hermetic_routed_veth_harness_sh_blob
        test_hermetic_routed_veth_harness_sh_sha256
        test_routed_veth_harness_static_py_path
        test_routed_veth_harness_static_py_blob
        test_routed_veth_harness_static_py_sha256
    }
    set channel [open $path r]
    fconfigure $channel -encoding utf-8 -translation lf
    set payload [read $channel]
    close $channel
    if {[string first "\u0000" $payload] >= 0 || ![string match "*\n" $payload]} {
        return -code error "manifest-encoding"
    }
    set lines [split [string range $payload 0 end-1] "\n"]
    if {[llength $lines] != [llength $expected_keys]} {
        return -code error "manifest-field-count"
    }
    set values [dict create]
    for {set index 0} {$index < [llength $expected_keys]} {incr index} {
        set fields [split [lindex $lines $index] "\t"]
        set expected [lindex $expected_keys $index]
        if {[llength $fields] != 2 || [lindex $fields 0] ne $expected ||
            [lindex $fields 1] eq ""} {
            return -code error "manifest-field-$expected"
        }
        dict set values $expected [lindex $fields 1]
    }
    return $values
}

proc validate_manifest_values {values} {
    if {[dict get $values format] ne "wg-mix-ebpf-b82-v6-package-v5" ||
        [dict get $values run_id] ne "c8e41d73" ||
        [dict get $values package_id] ne "4f2a9b61" ||
        ![regexp {^refs/heads/[A-Za-z0-9][A-Za-z0-9._/-]{0,180}$} [dict get $values integration_ref]] ||
        [string first ".." [dict get $values integration_ref]] >= 0 ||
        [string first "//" [dict get $values integration_ref]] >= 0 ||
        ![regexp {^[0-9a-f]{40}$} [dict get $values integration_commit]] ||
        [dict get $values local_package_dir] ne
            "/private/tmp/wg-mix-b82-v6-c8e41d73-4f2a9b61-[string range [dict get $values integration_commit] 0 11]" ||
        [dict get $values bundle_name] ne "source-4f2a9b61.bundle" ||
        ![regexp {^[0-9a-f]{64}$} [dict get $values bundle_sha256]] ||
        [dict get $values history_verification] ne "isolated-unbundle-rev-list-fsck-v1" ||
        ![regexp {^[1-9][0-9]*$} [dict get $values history_commit_count]] ||
        ![regexp {^[0-9a-f]{64}$} [dict get $values history_roots_sha256]] ||
        ![regexp {^[0-9a-f]{64}$} [dict get $values history_objects_sha256]] ||
        [dict get $values remote_package_dir] ne "/home/siyixuan/wg-mix-ebpf-test/unpriv-4f2a9b61" ||
        [dict get $values remote_source] ne "/run/wg-mix-ebpf-source-stages/c8e41d73/source" ||
        [dict get $values target_user] ne "siyixuan" ||
        [dict get $values target_host] ne "192.168.10.82" ||
        [dict get $values target_hostname] ne "ubuntu-2604-test" ||
        [dict get $values target_kernel] ne "7.0.0-28-generic" ||
        [dict get $values target_machine_id] ne "9db3fb717cc74974b2a6b243d67f67b9" ||
