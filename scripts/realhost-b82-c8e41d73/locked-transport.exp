proc r2_validate_mutation_prefix {trace} {
    set expected [r2_mutation_operations]
    set previous -1
    foreach operation $trace {
        set index [lsearch -exact $expected $operation]
        if {$index < 0 || $index <= $previous} {
            return -code error "r2-mutation-order"
        }
        set previous $index
    }
    return
}

proc r2_validate_mutation_trace {trace require_full} {
    if {$require_full ni {0 1}} {
        return -code error "r2-mutation-trace-mode"
    }
    r2_validate_mutation_prefix $trace
    if {$trace eq {}} {
        if {$require_full} {
            return -code error "r2-mutation-count"
        }
        return empty
    }
    if {[lindex $trace end] ne "r2-raw-helper-mutate"} {
        return -code error "r2-mutation-completion"
    }
    if {$require_full} {
        set expected [r2_mutation_operations]
        if {[llength $trace] != [llength $expected] ||
            [lrange $trace 0 end] ne [lrange $expected 0 end]} {
            return -code error "r2-mutation-count"
        }
    }
    return [expr {$require_full ? "full" : "subsequence"}]
}

proc r2_mutation_trace_start {initial_phase} {
    if {[info exists ::R2_MUTATION_TRACE_ACTIVE] &&
        $::R2_MUTATION_TRACE_ACTIVE} {
        fail "r2-mutation-trace-nested" 78
    }
    set ::R2_MUTATION_TRACE_ACTIVE 1
    set ::R2_MUTATION_TRACE {}
    set ::R2_MUTATION_INITIAL_PHASE $initial_phase
    set ::R2_MUTATION_INTAKE_CREATED 0
}

proc r2_mutation_trace_record {operation} {
    if {![info exists ::R2_MUTATION_TRACE_ACTIVE] ||
        !$::R2_MUTATION_TRACE_ACTIVE} {
        fail "r2-mutation-trace-inactive" 78
    }
    set candidate [concat $::R2_MUTATION_TRACE [list $operation]]
    if {[catch {r2_validate_mutation_prefix $candidate}]} {
        fail "r2-mutation-order" 78
    }
    set ::R2_MUTATION_TRACE $candidate
}

proc r2_mutation_trace_intake_created {} {
    if {![info exists ::R2_MUTATION_TRACE_ACTIVE] ||
        !$::R2_MUTATION_TRACE_ACTIVE ||
        $::R2_MUTATION_TRACE ne {r2-raw-intake-mkdir}} {
        fail "r2-mutation-intake-trace" 78
    }
    set ::R2_MUTATION_INTAKE_CREATED 1
}

proc r2_mutation_trace_finish {} {
    if {![info exists ::R2_MUTATION_TRACE_ACTIVE] ||
        !$::R2_MUTATION_TRACE_ACTIVE} {
        fail "r2-mutation-trace-inactive" 78
    }
    set require_full [expr {
        $::R2_MUTATION_INITIAL_PHASE eq "absent" &&
        $::R2_MUTATION_INTAKE_CREATED
    }]
    if {[catch {r2_validate_mutation_trace $::R2_MUTATION_TRACE \
        $require_full} trace_class]} {
        fail $trace_class 78
    }
    set count [llength $::R2_MUTATION_TRACE]
    set ::R2_MUTATION_TRACE_ACTIVE 0
    set ::R2_MUTATION_TRACE {}
    puts "B82_V6_R2_MUTATION_AUDIT class=$trace_class raw_calls=$count fixed_surface=21 result=PASS"
    return $trace_class
}

