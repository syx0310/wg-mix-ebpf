}

proc r2_helper_remote_argv {manifest_sha mode} {
    if {$mode ni {
        retire-postflight-f75fe7678cfd-r2 verify-postflight-retirement-r2
    } || ![regexp {^[0-9a-f]{64}$} $manifest_sha]} {
        return -code error "r2-helper-mode"
    }
    return [list /bin/bash -p $::R2_AUTH_SELF $mode \
        --manifest $::R2_AUTH_MANIFEST --manifest-sha256 $manifest_sha]
}

proc r2_fixed_path {name} {
    switch -- $name {
        home-qroot { return $::R2_HOME_QROOT }
        auth-root { return $::R2_AUTH_ROOT }
        run-qroot { return $::R2_RUN_QROOT }
        auth-manifest-pending { return $::R2_AUTH_MANIFEST_PENDING }
        auth-manifest { return $::R2_AUTH_MANIFEST }
        auth-self-pending { return $::R2_AUTH_SELF_PENDING }
        auth-self { return $::R2_AUTH_SELF }
        quarantine-intake { return $::R2_Q_INTAKE }
        quarantine-package { return $::R2_Q_PACKAGE }
        quarantine-bootstrap { return $::R2_Q_BOOTSTRAP }
        lock { return $::R2_LOCK }
        receipt-pending { return $::R2_RECEIPT_PENDING }
        receipt-final { return $::R2_RECEIPT_FINAL }
        default { return -code error "r2-fixed-path" }
    }
}

proc fresh_remote_argv {values manifest_sha mode bootstrap_root} {
    set source [dict get $values remote_source]
    set script_path [dict get $values root_fresh_verifier_gate_sh_path]
    return [list /bin/bash -p "${source}/${script_path}" $mode \
        --controller-source $source \
        --commit [dict get $values integration_commit] \
        --manifest "${bootstrap_root}/package-manifest.v1" \
        --manifest-sha256 $manifest_sha \
        --bundle "${bootstrap_root}/[dict get $values bundle_name]" \
        --bundle-sha256 [dict get $values bundle_sha256]]
}

proc realnic_remote_argv {values mode approved_sha} {
    set source [dict get $values remote_source]
    set script_path [dict get $values realnic_acceptance_py_path]
    set argv [list /usr/bin/python3 -B -I "${source}/${script_path}" $mode \
        --source-commit [dict get $values integration_commit]]
    if {$mode in {run restore}} {
        if {![regexp {^[0-9a-f]{64}$} $approved_sha]} {
            return -code error "realnic-approved-plan-sha256"
        }
        lappend argv --approved-plan \
            /run/wg-mix-ebpf-source-bootstrap-c8e41d73/realnic-approved-plan.json \
            --approved-plan-sha256 $approved_sha
    }
    return $argv
}

proc veth_remote_argv {values mode bootstrap_root} {
    if {[dict get $values wg_state] ne "absent"} {
        return -code error "veth-wireguard-state"
    }
    set source [dict get $values remote_source]
    set runner [dict get $values root_veth_n_r_sh_path]
    return [list /bin/bash -p "${source}/${runner}" $mode \
        --controller-source $source \
        --commit [dict get $values integration_commit] \
        --bundle "${bootstrap_root}/[dict get $values bundle_name]" \
        --bundle-sha256 [dict get $values bundle_sha256] \
        --wg-state absent]
}

proc routed_remote_argv {values mode} {
    set source [dict get $values remote_source]
    set seam [dict get $values controller_seam_sh_path]
    return [list /bin/bash -p "${source}/${seam}" $mode \
        --commit [dict get $values integration_commit]]
}

