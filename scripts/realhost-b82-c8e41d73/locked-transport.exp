proc retained_retirement_readonly_operations {} {
    set package_files [retained_retirement_package_files]
    set package_names [retained_retirement_package_names]
    set bootstrap_files [retained_retirement_bootstrap_files]
    set bootstrap_names {
        prepare-stage-root.sh provision-ubuntu-test-host.sh
    }
    if {[dict size $package_files] != 17 ||
        [lsort -ascii [dict keys $package_files]] ne
            [lsort -ascii $package_names] ||
        [dict size $bootstrap_files] != 2 ||
        [lsort -ascii [dict keys $bootstrap_files]] ne
            [lsort -ascii $bootstrap_names]} {
        return -code error "retirement-lineage-retained-cardinality"
    }
    set operations {}
    foreach name $package_names {
        lappend operations "lineage-q-package-stat-${name}" \
            "lineage-q-package-sha-${name}"
    }
    foreach name $bootstrap_names {
        lappend operations "lineage-q-bootstrap-stat-${name}" \
            "lineage-q-bootstrap-sha-${name}"
    }
    lappend operations lineage-boot-id-read lineage-lock-content-read \
        lineage-lock-stat-recheck
    if {[llength $operations] != 41} {
        return -code error "retirement-lineage-readonly-cardinality"
    }
    return $operations
}

# This builder is private to the prepare transaction's read-only lineage gate.
# Its operations are not accepted by transport_main as caller operations.
proc build_retirement_lineage_operation {
    values operation {boot_id ""} {lock_identity ""}
} {
    set target "[dict get $values target_user]@[dict get $values target_host]"
    set remote {}
    set tty 1
    set prompt_limit 2
    set assertion none
    set timeout_seconds 600

    if {[regexp {^lineage-exists-(user-intake|home-qroot|run-qroot|receipt-pending)$}         $operation -> path_name]} {
        switch -- $path_name {
            user-intake { set fixed_path $::RETIREMENT_USER_INTAKE }
            home-qroot { set fixed_path $::RETIREMENT_HOME_QROOT }
            run-qroot { set fixed_path $::RETIREMENT_RUN_QROOT }
            receipt-pending { set fixed_path $::RETIREMENT_RECEIPT_PENDING }
        }
        set remote [concat [list /usr/bin/sudo --] [env_argv] \
            [list /usr/bin/find [file dirname $fixed_path] -xdev \
            -mindepth 1 -maxdepth 1 -name [file tail $fixed_path] -print]]
    } elseif {[regexp {^lineage-q-(package|bootstrap)-(stat|sha)-(.+)$} \
        $operation -> namespace family name]} {
        if {$namespace eq "package"} {
            set retained_files [retained_retirement_package_files]
            set fixed_path "${::RETIREMENT_Q_PACKAGE}/${name}"
            set stat_prefix siyixuan:siyixuan:600
        } else {
            set retained_files [retained_retirement_bootstrap_files]
            set fixed_path "${::RETIREMENT_Q_BOOTSTRAP}/${name}"
            set stat_prefix root:root:700
        }
        if {![dict exists $retained_files $name]} {
            return -code error "retirement-lineage-retained-name"
        }
        lassign [dict get $retained_files $name] expected_size expected_sha
        if {$family eq "stat"} {
            set remote [concat [list /usr/bin/sudo --] [env_argv] \
                [list /usr/bin/stat -Lc %U:%G:%a:%h:%s:%F -- $fixed_path]]
            set assertion \
                "exact:${stat_prefix}:1:${expected_size}:regular file"
        } else {
            set remote [concat [list /usr/bin/sudo --] [env_argv] \
                [list /usr/bin/sha256sum -- $fixed_path]]
            set assertion "exact:${expected_sha}  ${fixed_path}"
        }
    } else {
        switch -- $operation {
            lineage-boot-id-read {
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/cat -- /proc/sys/kernel/random/boot_id]]
                set assertion boot-uuid-line
            }
            lineage-lock-content-read {
                if {![regexp \
                    {^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$} \
                    $boot_id]} {
                    return -code error "retirement-lineage-boot-id"
                }
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/dd "if=$::RETIREMENT_LOCK" \
                    iflag=nonblock,nofollow,fullblock bs=46 count=1 \
                    status=none]]
                set assertion "r1-lock-content:${boot_id}"
            }
            lineage-lock-stat-recheck {
                if {![regexp \
                    {^[0-9]+:[0-9]+:root:root:600:1:45:regular file$} \
                    $lock_identity]} {
                    return -code error "retirement-lineage-lock-identity"
                }
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/stat -Lc %d:%i:%U:%G:%a:%h:%s:%F -- \
                    $::RETIREMENT_LOCK]]
                set assertion "exact:${lock_identity}"
            }
            lineage-home-readlink - lineage-auth-readlink -
            lineage-run-readlink - lineage-q-intake-readlink -
            lineage-q-package-readlink - lineage-q-bootstrap-readlink {
                switch -- $operation {
                    lineage-home-readlink { set fixed_path $::RETIREMENT_HOME_QROOT }
                    lineage-auth-readlink { set fixed_path $::RETIREMENT_AUTH_ROOT }
                    lineage-run-readlink { set fixed_path $::RETIREMENT_RUN_QROOT }
                    lineage-q-intake-readlink { set fixed_path $::RETIREMENT_Q_INTAKE }
                    lineage-q-package-readlink { set fixed_path $::RETIREMENT_Q_PACKAGE }
                    lineage-q-bootstrap-readlink { set fixed_path $::RETIREMENT_Q_BOOTSTRAP }
                }
                set remote [concat [list /usr/bin/sudo --] [env_argv]                     [list /usr/bin/readlink -e -- $fixed_path]]
                set assertion "exact:$fixed_path"
            }
            lineage-home-stat - lineage-auth-stat - lineage-run-stat -
            lineage-q-bootstrap-stat {
                switch -- $operation {
                    lineage-home-stat { set fixed_path $::RETIREMENT_HOME_QROOT }
                    lineage-auth-stat { set fixed_path $::RETIREMENT_AUTH_ROOT }
                    lineage-run-stat { set fixed_path $::RETIREMENT_RUN_QROOT }
                    lineage-q-bootstrap-stat { set fixed_path $::RETIREMENT_Q_BOOTSTRAP }
                }
                set remote [concat [list /usr/bin/sudo --] [env_argv]                     [list /usr/bin/stat -Lc %U:%G:%a:%F -- $fixed_path]]
                set assertion exact:root:root:700:directory
            }
            lineage-q-intake-stat - lineage-q-package-stat {
                set fixed_path [expr {$operation eq "lineage-q-intake-stat" ?
                    $::RETIREMENT_Q_INTAKE : $::RETIREMENT_Q_PACKAGE}]
                set remote [concat [list /usr/bin/sudo --] [env_argv]                     [list /usr/bin/stat -Lc %U:%G:%a:%F -- $fixed_path]]
                set assertion exact:siyixuan:siyixuan:700:directory
            }
            lineage-home-entries {
                set remote [concat [list /usr/bin/sudo --] [env_argv]                     [list /usr/bin/find $::RETIREMENT_HOME_QROOT -xdev                     -mindepth 1 -maxdepth 1 -printf {'%f\t%y\n'}]]
                set assertion [lineage_entry_assertion                     [list "authority\td" "intake\td" "package\td"]]
            }
            lineage-auth-entries {
                set remote [concat [list /usr/bin/sudo --] [env_argv]                     [list /usr/bin/find $::RETIREMENT_AUTH_ROOT -xdev                     -mindepth 1 -maxdepth 1 -printf {'%f\t%y\n'}]]
                set assertion [lineage_entry_assertion [list                     "package-manifest.v1.pending\tf" "package-manifest.v1\tf"                     "prepare-stage-root.sh.pending\tf" "prepare-stage-root.sh\tf"]]
            }
            lineage-run-entries {
                set remote [concat [list /usr/bin/sudo --] [env_argv]                     [list /usr/bin/find $::RETIREMENT_RUN_QROOT -xdev                     -mindepth 1 -maxdepth 1 -printf {'%f\t%y\n'}]]
                set assertion [lineage_entry_assertion [list "bootstrap\td"                     "retirement.v1.lock\tf" "retirement-complete.v1\tf"]]
            }
            lineage-q-intake-entries {
                set remote [concat [list /usr/bin/sudo --] [env_argv]                     [list /usr/bin/find $::RETIREMENT_Q_INTAKE -xdev                     -mindepth 1 -maxdepth 1 -printf {'%f\t%y\n'}]]
                set assertion [lineage_entry_assertion                     [list "package-manifest.v1\tf" "prepare-stage-root.sh\tf"]]
            }
            lineage-q-package-entries {
                set remote [concat [list /usr/bin/sudo --] [env_argv]                     [list /usr/bin/find $::RETIREMENT_Q_PACKAGE -xdev                     -mindepth 1 -maxdepth 1 -printf {'%f\t%y\n'}]]
                set entries {}
                foreach name [retained_retirement_package_names] {
                    lappend entries "$name\tf"
                }
                set assertion [lineage_entry_assertion $entries]
            }
            lineage-q-bootstrap-entries {
                set remote [concat [list /usr/bin/sudo --] [env_argv]                     [list /usr/bin/find $::RETIREMENT_Q_BOOTSTRAP -xdev                     -mindepth 1 -maxdepth 1 -printf {'%f\t%y\n'}]]
                set assertion [lineage_entry_assertion                     [list "prepare-stage-root.sh\tf"                     "provision-ubuntu-test-host.sh\tf"]]
            }
            lineage-auth-manifest-pending-stat -
            lineage-auth-manifest-stat {
                set fixed_path [expr {$operation eq "lineage-auth-manifest-pending-stat" ?
                    $::RETIREMENT_AUTH_MANIFEST_PENDING :
                    $::RETIREMENT_AUTH_MANIFEST}]
                set remote [concat [list /usr/bin/sudo --] [env_argv]                     [list /usr/bin/stat -Lc %U:%G:%a:%h:%F -- $fixed_path]]
                set assertion exact:root:root:600:2:regular\ file
            }
            lineage-auth-self-pending-stat - lineage-auth-self-stat {
                set fixed_path [expr {$operation eq "lineage-auth-self-pending-stat" ?
                    $::RETIREMENT_AUTH_SELF_PENDING : $::RETIREMENT_AUTH_SELF}]
                set remote [concat [list /usr/bin/sudo --] [env_argv]                     [list /usr/bin/stat -Lc %U:%G:%a:%h:%F -- $fixed_path]]
                set assertion exact:root:root:700:2:regular\ file
            }
            lineage-auth-manifest-pending-sha - lineage-auth-manifest-sha {
                set fixed_path [expr {$operation eq "lineage-auth-manifest-pending-sha" ?
                    $::RETIREMENT_AUTH_MANIFEST_PENDING :
                    $::RETIREMENT_AUTH_MANIFEST}]
                set remote [concat [list /usr/bin/sudo --] [env_argv]                     [list /usr/bin/sha256sum -- $fixed_path]]
                set assertion                     "exact:$::RETAINED_RETIREMENT_MANIFEST_SHA256  $fixed_path"
            }
            lineage-auth-self-pending-sha - lineage-auth-self-sha {
                set fixed_path [expr {$operation eq "lineage-auth-self-pending-sha" ?
                    $::RETIREMENT_AUTH_SELF_PENDING : $::RETIREMENT_AUTH_SELF}]
                set remote [concat [list /usr/bin/sudo --] [env_argv]                     [list /usr/bin/sha256sum -- $fixed_path]]
                set assertion                     "exact:$::RETAINED_RETIREMENT_HELPER_SHA256  $fixed_path"
            }
            lineage-auth-manifest-pair {
                set remote [concat [list /usr/bin/sudo --] [env_argv]                     [list /usr/bin/stat -Lc %d:%i --                     $::RETIREMENT_AUTH_MANIFEST_PENDING                     $::RETIREMENT_AUTH_MANIFEST]]
                set assertion same-two-inodes
            }
            lineage-auth-self-pair {
                set remote [concat [list /usr/bin/sudo --] [env_argv]                     [list /usr/bin/stat -Lc %d:%i --                     $::RETIREMENT_AUTH_SELF_PENDING $::RETIREMENT_AUTH_SELF]]
                set assertion same-two-inodes
            }
            lineage-q-intake-manifest-stat {
                set fixed_path "$::RETIREMENT_Q_INTAKE/package-manifest.v1"
                set remote [concat [list /usr/bin/sudo --] [env_argv]                     [list /usr/bin/stat -Lc %U:%G:%a:%h:%F -- $fixed_path]]
                set assertion exact:siyixuan:siyixuan:600:1:regular\ file
            }
            lineage-q-intake-self-stat {
                set fixed_path "$::RETIREMENT_Q_INTAKE/prepare-stage-root.sh"
                set remote [concat [list /usr/bin/sudo --] [env_argv]                     [list /usr/bin/stat -Lc %U:%G:%a:%h:%F -- $fixed_path]]
                set assertion exact:siyixuan:siyixuan:600:1:regular\ file
            }
            lineage-q-intake-manifest-sha {
                set fixed_path "$::RETIREMENT_Q_INTAKE/package-manifest.v1"
                set remote [concat [list /usr/bin/sudo --] [env_argv]                     [list /usr/bin/sha256sum -- $fixed_path]]
                set assertion                     "exact:$::RETAINED_RETIREMENT_MANIFEST_SHA256  $fixed_path"
            }
            lineage-q-intake-self-sha {
                set fixed_path "$::RETIREMENT_Q_INTAKE/prepare-stage-root.sh"
                set remote [concat [list /usr/bin/sudo --] [env_argv]                     [list /usr/bin/sha256sum -- $fixed_path]]
                set assertion                     "exact:$::RETAINED_RETIREMENT_HELPER_SHA256  $fixed_path"
            }
            lineage-lock-stat {
                set remote [concat [list /usr/bin/sudo --] [env_argv]                     [list /usr/bin/stat -Lc %d:%i:%U:%G:%a:%h:%s:%F --                     $::RETIREMENT_LOCK]]
                set assertion r1-lock-identity
            }
            lineage-receipt-stat {
                set remote [concat [list /usr/bin/sudo --] [env_argv]                     [list /usr/bin/stat -Lc %U:%G:%a:%h:%F --                     $::RETIREMENT_RECEIPT_FINAL]]
                set assertion exact:root:root:600:1:regular\ file
            }
            lineage-receipt-sha {
                set remote [concat [list /usr/bin/sudo --] [env_argv]                     [list /usr/bin/sha256sum -- $::RETIREMENT_RECEIPT_FINAL]]
                set assertion                     "exact:$::RETAINED_RETIREMENT_RECEIPT_SHA256  $::RETIREMENT_RECEIPT_FINAL"
            }
            default {
                return -code error "retirement-lineage-operation"
            }
        }
    }
    set spawn_argv [concat [list /usr/bin/ssh] [ssh_options $tty]         [list -- $target] $remote]
    return [list ssh $spawn_argv $prompt_limit $assertion $timeout_seconds]
}

proc r2_entry_assertion {names} {
    set assertion [list exact-entry-set]
    foreach name $names {
        lappend assertion "${name}\tf"
    }
    return $assertion
}

# Private R2 leaves are never admitted by transport_main.  This builder owns a
# separate frozen predecessor namespace and does not call build_operation for
# any predecessor package or bootstrap observation.
proc build_r2_operation {values manifest_sha predecessor_values operation} {
    if {[dict size $predecessor_values] != 103 ||
        [dict get $predecessor_values integration_commit] ne
            $::R2_PREDECESSOR_COMMIT} {
        return -code error "r2-predecessor-values"
    }
    set target "[dict get $values target_user]@[dict get $values target_host]"
    set old_package "/home/siyixuan/wg-mix-ebpf-test/unpriv-4f2a9b61"
    set old_bootstrap "/run/wg-mix-ebpf-source-bootstrap-c8e41d73"
    set old_provisioner "${old_bootstrap}/provision-ubuntu-test-host.sh"
    set old_stager "${old_bootstrap}/prepare-stage-root.sh"
    set remote {}
    set tty 1
    set prompt_limit 2
    set assertion none
    set timeout_seconds 600

    if {[regexp {^r2-ro-exists-(.+)$} $operation -> path_name]} {
        set fixed_path [r2_fixed_path $path_name]
        set remote [concat [list /usr/bin/sudo --] [env_argv] \
            [list /usr/bin/test -e $fixed_path -o -L $fixed_path]]
    } elseif {[regexp {^r2-ro-old-package-(sha|stat)-(.+)$} \
        $operation -> family name]} {
        if {[lsearch -exact [r2_predecessor_package_names] $name] < 0} {
            return -code error "r2-old-package-name"
        }
        set artifact "${old_package}/${name}"
        if {$family eq "sha"} {
            set expected_sha [r2_predecessor_package_sha $name]
            set remote [concat [list /usr/bin/sudo --] [env_argv] \
                [list /usr/bin/sha256sum -- $artifact]]
            set assertion "exact:${expected_sha}  ${artifact}"
        } else {
            set remote [concat [list /usr/bin/sudo --] [env_argv] \
                [list /usr/bin/stat -Lc %U:%G:%a:%h:%F -- $artifact]]
            set assertion exact:siyixuan:siyixuan:600:1:regular\ file
        }
    } else {
        switch -- $operation {
            r2-ro-user-intake-exists {
                set remote [list /usr/bin/test -e $::R2_USER_INTAKE -o -L \
                    $::R2_USER_INTAKE]
                set tty 0
                set prompt_limit 1
            }
            r2-ro-old-package-readlink {
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/readlink -e -- $old_package]]
                set assertion "exact:${old_package}"
            }
            r2-ro-old-package-stat {
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/stat -Lc %U:%G:%a:%F -- $old_package]]
                set assertion exact:siyixuan:siyixuan:700:directory
            }
            r2-ro-old-package-entries {
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/find $old_package -xdev -mindepth 1 \
                    -maxdepth 1 -printf {'%f\t%y\n'}]]
                set assertion [r2_entry_assertion \
                    [r2_predecessor_package_names]]
            }
            r2-ro-old-bootstrap-root-readlink {
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/readlink -e -- $old_bootstrap]]
                set assertion "exact:${old_bootstrap}"
            }
            r2-ro-old-bootstrap-root-stat {
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/stat -Lc %U:%G:%a:%F -- $old_bootstrap]]
                set assertion exact:root:root:700:directory
            }
            r2-ro-old-bootstrap-provisioner-readlink -
            r2-ro-old-bootstrap-stager-readlink {
                set artifact [expr {$operation eq
                    "r2-ro-old-bootstrap-provisioner-readlink" ?
                    $old_provisioner : $old_stager}]
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/readlink -e -- $artifact]]
                set assertion "exact:${artifact}"
            }
            r2-ro-old-bootstrap-provisioner-stat -
            r2-ro-old-bootstrap-stager-stat {
                set artifact [expr {$operation eq
                    "r2-ro-old-bootstrap-provisioner-stat" ?
                    $old_provisioner : $old_stager}]
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/stat -Lc %U:%G:%a:%h:%F -- $artifact]]
                set assertion exact:root:root:700:1:regular\ file
            }
            r2-ro-old-bootstrap-provisioner-sha -
            r2-ro-old-bootstrap-stager-sha {
                if {$operation eq "r2-ro-old-bootstrap-provisioner-sha"} {
                    set artifact $old_provisioner
                    set expected_sha \
                        078d191b0edbafe27e9f684d3fa495e04d7217a01d0ec1fd32eaede211178c8f
                } else {
                    set artifact $old_stager
                    set expected_sha \
                        1bcb8db91d976d2a1d95f7d87223a2dac4a1678f74c1c25542e54b01ee10eeea
                }
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/sha256sum -- $artifact]]
                set assertion "exact:${expected_sha}  ${artifact}"
            }
            r2-ro-old-bootstrap-entries {
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/find $old_bootstrap -xdev -mindepth 1 \
                    -maxdepth 1 -printf {'%f\t%y\n'}]]
                set assertion [r2_entry_assertion \
                    {prepare-stage-root.sh provision-ubuntu-test-host.sh}]
            }
            r2-ro-old-provision-check {
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /bin/bash -p $old_provisioner --check \
                    --expected-address 192.168.10.82 \
                    --expected-interface ens33 \
                    --expected-hostname ubuntu-2604-test \
                    --expected-kernel 7.0.0-28-generic \
                    --expected-machine-id \
                    9db3fb717cc74974b2a6b243d67f67b9]]
                set assertion provision-check
            }
            r2-ro-intake-readlink {
                set remote [list /usr/bin/readlink -e -- $::R2_USER_INTAKE]
                set assertion "exact:$::R2_USER_INTAKE"
                set tty 0
                set prompt_limit 1
            }
            r2-ro-intake-stat {
                set remote [list /usr/bin/stat -Lc %U:%G:%a:%F -- \
                    $::R2_USER_INTAKE]
                set assertion exact:siyixuan:siyixuan:700:directory
                set tty 0
                set prompt_limit 1
            }
            r2-ro-intake-entries {
                set remote [list /usr/bin/find $::R2_USER_INTAKE -xdev \
                    -mindepth 1 -maxdepth 1 -printf {'%f\t%y\n'}]
                set tty 0
                set prompt_limit 1
            }
            r2-ro-intake-manifest-stat - r2-ro-intake-self-stat {
                set name [expr {$operation eq "r2-ro-intake-manifest-stat" ?
                    "package-manifest.v1" : "prepare-stage-root.sh"}]
                set remote [list /usr/bin/stat -Lc %U:%G:%a:%h:%F -- \
                    "${::R2_USER_INTAKE}/${name}"]
                set assertion exact:siyixuan:siyixuan:600:1:regular\ file
                set tty 0
                set prompt_limit 1
            }
            r2-ro-intake-manifest-shape - r2-ro-intake-self-shape {
                set name [expr {$operation eq "r2-ro-intake-manifest-shape" ?
                    "package-manifest.v1" : "prepare-stage-root.sh"}]
                set remote [list /usr/bin/stat -Lc %U:%G:%a:%h:%s:%F -- \
                    "${::R2_USER_INTAKE}/${name}"]
                set tty 0
                set prompt_limit 1
            }
            r2-ro-intake-manifest-sha - r2-ro-intake-self-sha {
                set name [expr {$operation eq "r2-ro-intake-manifest-sha" ?
                    "package-manifest.v1" : "prepare-stage-root.sh"}]
                set expected_sha [expr {$name eq "package-manifest.v1" ?
                    $manifest_sha :
                    [dict get $values prepare_stage_root_sh_sha256]}]
                set artifact "${::R2_USER_INTAKE}/${name}"
                set remote [list /usr/bin/sha256sum -- $artifact]
                set assertion "exact:${expected_sha}  ${artifact}"
                set tty 0
                set prompt_limit 1
            }
            r2-ro-intake-manifest-sha-observe -
            r2-ro-intake-self-sha-observe {
                set name [expr {$operation eq
                    "r2-ro-intake-manifest-sha-observe" ?
                    "package-manifest.v1" : "prepare-stage-root.sh"}]
                set remote [list /usr/bin/sha256sum -- \
                    "${::R2_USER_INTAKE}/${name}"]
                set tty 0
                set prompt_limit 1
            }
            r2-raw-intake-mkdir {
                set remote [list /usr/bin/mkdir --mode=0700 -- $::R2_USER_INTAKE]
                set tty 0
                set prompt_limit 1
            }
            r2-raw-scp-manifest - r2-raw-scp-self {
                set name [expr {$operation eq "r2-raw-scp-manifest" ?
                    "package-manifest.v1" : "prepare-stage-root.sh"}]
                lassign [r2_local_delivery_file $values $manifest_sha $name] \
                    local_artifact expected_sha
                set destination "${target}:${::R2_USER_INTAKE}/${name}"
                set spawn_argv [concat [list /usr/bin/scp] [scp_options] \
                    [list -- $local_artifact $destination]]
                return [list scp $spawn_argv 1 none $timeout_seconds]
            }
            r2-raw-sync-intake-manifest - r2-raw-sync-intake-self -
            r2-raw-sync-intake-directory - r2-raw-sync-intake-parent {
                switch -- $operation {
                    r2-raw-sync-intake-manifest {
                        set sync_path \
                            "${::R2_USER_INTAKE}/package-manifest.v1"
                    }
                    r2-raw-sync-intake-self {
                        set sync_path \
                            "${::R2_USER_INTAKE}/prepare-stage-root.sh"
                    }
                    r2-raw-sync-intake-directory {
                        set sync_path $::R2_USER_INTAKE
                    }
                    r2-raw-sync-intake-parent {
                        set sync_path $::R2_USER_INTAKE_PARENT
                    }
                }
                set remote [list /usr/bin/sync -- $sync_path]
                set tty 0
                set prompt_limit 1
            }
            r2-ro-home-qroot-readlink - r2-ro-auth-root-readlink -
            r2-ro-run-qroot-readlink {
                switch -- $operation {
                    r2-ro-home-qroot-readlink { set fixed_path $::R2_HOME_QROOT }
                    r2-ro-auth-root-readlink { set fixed_path $::R2_AUTH_ROOT }
                    r2-ro-run-qroot-readlink { set fixed_path $::R2_RUN_QROOT }
                }
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/readlink -e -- $fixed_path]]
                set assertion "exact:${fixed_path}"
            }
            r2-ro-home-qroot-stat - r2-ro-auth-root-stat -
            r2-ro-run-qroot-stat {
                switch -- $operation {
                    r2-ro-home-qroot-stat { set fixed_path $::R2_HOME_QROOT }
                    r2-ro-auth-root-stat { set fixed_path $::R2_AUTH_ROOT }
                    r2-ro-run-qroot-stat { set fixed_path $::R2_RUN_QROOT }
                }
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/stat -Lc %U:%G:%a:%F -- $fixed_path]]
                set assertion exact:root:root:700:directory
            }
            r2-ro-home-qroot-entries - r2-ro-auth-root-entries -
            r2-ro-run-qroot-entries {
                switch -- $operation {
                    r2-ro-home-qroot-entries { set fixed_path $::R2_HOME_QROOT }
                    r2-ro-auth-root-entries { set fixed_path $::R2_AUTH_ROOT }
                    r2-ro-run-qroot-entries { set fixed_path $::R2_RUN_QROOT }
                }
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/find $fixed_path -xdev -mindepth 1 \
                    -maxdepth 1 -printf {'%f\t%y\n'}]]
            }
            r2-raw-home-qroot-create - r2-raw-auth-root-create -
            r2-raw-run-qroot-create {
                switch -- $operation {
                    r2-raw-home-qroot-create { set fixed_path $::R2_HOME_QROOT }
                    r2-raw-auth-root-create { set fixed_path $::R2_AUTH_ROOT }
                    r2-raw-run-qroot-create { set fixed_path $::R2_RUN_QROOT }
                }
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/mkdir --mode=0700 -- $fixed_path]]
            }
            r2-raw-auth-manifest-install {
                set source "${::R2_USER_INTAKE}/package-manifest.v1"
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/install --owner=root --group=root --mode=0600 \
                    --no-target-directory -- $source \
                    $::R2_AUTH_MANIFEST_PENDING]]
            }
            r2-raw-auth-self-install {
                set source "${::R2_USER_INTAKE}/prepare-stage-root.sh"
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/install --owner=root --group=root --mode=0700 \
                    --no-target-directory -- $source $::R2_AUTH_SELF_PENDING]]
            }
            r2-ro-auth-manifest-pending-shape -
            r2-ro-auth-self-pending-shape {
                if {$operation eq "r2-ro-auth-manifest-pending-shape"} {
                    set artifact $::R2_AUTH_MANIFEST_PENDING
                } else {
                    set artifact $::R2_AUTH_SELF_PENDING
                }
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/stat -Lc %U:%G:%a:%h:%s:%F -- $artifact]]
            }
            r2-ro-auth-manifest-pending-sha-observe -
            r2-ro-auth-self-pending-sha-observe {
                set artifact [expr {$operation eq
                    "r2-ro-auth-manifest-pending-sha-observe" ?
                    $::R2_AUTH_MANIFEST_PENDING : $::R2_AUTH_SELF_PENDING}]
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/sha256sum -- $artifact]]
            }
            r2-ro-auth-manifest-pending-sha - r2-ro-auth-manifest-sha {
                set artifact [expr {$operation eq
                    "r2-ro-auth-manifest-pending-sha" ?
                    $::R2_AUTH_MANIFEST_PENDING : $::R2_AUTH_MANIFEST}]
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/sha256sum -- $artifact]]
                set assertion "exact:${manifest_sha}  ${artifact}"
            }
            r2-ro-auth-self-pending-sha - r2-ro-auth-self-sha {
                set artifact [expr {$operation eq "r2-ro-auth-self-pending-sha" ?
                    $::R2_AUTH_SELF_PENDING : $::R2_AUTH_SELF}]
                set expected_sha [dict get $values prepare_stage_root_sh_sha256]
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/sha256sum -- $artifact]]
                set assertion "exact:${expected_sha}  ${artifact}"
            }
            r2-ro-auth-manifest-pending-stat {
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/stat -Lc %U:%G:%a:%h:%F -- \
                    $::R2_AUTH_MANIFEST_PENDING]]
                set assertion exact:root:root:600:1:regular\ file
            }
            r2-ro-auth-self-pending-stat {
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/stat -Lc %U:%G:%a:%h:%F -- \
                    $::R2_AUTH_SELF_PENDING]]
                set assertion exact:root:root:700:1:regular\ file
            }
            r2-ro-auth-manifest-stat {
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/stat -Lc %U:%G:%a:%h:%F -- \
                    $::R2_AUTH_MANIFEST]]
                set assertion exact:root:root:600:2:regular\ file
            }
            r2-ro-auth-self-stat {
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/stat -Lc %U:%G:%a:%h:%F -- \
                    $::R2_AUTH_SELF]]
                set assertion exact:root:root:700:2:regular\ file
            }
            r2-ro-auth-manifest-pair - r2-ro-auth-self-pair {
                if {$operation eq "r2-ro-auth-manifest-pair"} {
                    set first $::R2_AUTH_MANIFEST_PENDING
                    set second $::R2_AUTH_MANIFEST
                } else {
                    set first $::R2_AUTH_SELF_PENDING
                    set second $::R2_AUTH_SELF
                }
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/stat -Lc %d:%i -- $first $second]]
                set assertion same-two-inodes
            }
            r2-raw-sync-auth-manifest-pending -
            r2-raw-sync-auth-self-pending {
                set artifact [expr {$operation eq
                    "r2-raw-sync-auth-manifest-pending" ?
                    $::R2_AUTH_MANIFEST_PENDING : $::R2_AUTH_SELF_PENDING}]
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/sync -- $artifact]]
            }
            r2-raw-link-auth-manifest - r2-raw-link-auth-self {
                if {$operation eq "r2-raw-link-auth-manifest"} {
                    set first $::R2_AUTH_MANIFEST_PENDING
                    set second $::R2_AUTH_MANIFEST
                } else {
                    set first $::R2_AUTH_SELF_PENDING
                    set second $::R2_AUTH_SELF
                }
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/ln --no-target-directory -- $first $second]]
            }
            r2-raw-sync-auth-root - r2-raw-sync-home-parent -
            r2-raw-sync-home-qroot - r2-raw-sync-run-parent {
                switch -- $operation {
                    r2-raw-sync-auth-root { set sync_path $::R2_AUTH_ROOT }
                    r2-raw-sync-home-parent { set sync_path /home }
                    r2-raw-sync-home-qroot { set sync_path $::R2_HOME_QROOT }
                    r2-raw-sync-run-parent { set sync_path /run }
                }
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [list /usr/bin/sync -- $sync_path]]
            }
            r2-raw-helper-mutate - r2-ro-helper-verify {
                set helper_mode [expr {$operation eq "r2-raw-helper-mutate" ?
                    "retire-postflight-f75fe7678cfd-r2" :
                    "verify-postflight-retirement-r2"}]
                set remote [concat [list /usr/bin/sudo --] [env_argv] \
                    [r2_helper_remote_argv $manifest_sha $helper_mode]]
                set assertion [expr {$operation eq "r2-raw-helper-mutate" ?
                    "r2-helper-mutate" : "r2-helper-verify"}]
                set timeout_seconds 2400
            }
            default { return -code error "r2-operation" }
        }
    }
    set spawn_argv [concat [list /usr/bin/ssh] [ssh_options $tty] \
        [list -- $target] $remote]
    return [list ssh $spawn_argv $prompt_limit $assertion $timeout_seconds]
}

proc output_value {payload} {
    set value [string map [list "\r" ""] $payload]
    return [string trim $value "\n"]
}

proc exact_line_count {lines expected} {
    set count 0
    foreach line $lines {
        if {$line eq $expected} {
            incr count
        }
    }
    return $count
}

proc prefix_line_count {lines prefix} {
    set count 0
    foreach line $lines {
        if {[string first $prefix $line] == 0} {
            incr count
        }
    }
    return $count
}

proc successful_write_finish_count {lines} {
    set count 0
    foreach line $lines {
        if {[string first "write_finish " $line] == 0 &&
            [string match "* exit=0" $line]} {
            incr count
        }
    }
    return $count
}

proc provision_missing_class {lines} {
    set matches {}
    foreach line $lines {
        if {[string first "missing_packages=" $line] == 0} {
            lappend matches $line
        }
    }
    if {[llength $matches] != 1} {
        return -code error "missing-set-cardinality"
    }
    switch -- [lindex $matches 0] {
        "missing_packages=" { return none }
        "missing_packages= clang gcc golang-go iperf3 libbpf-dev llvm make pkg-config shellcheck wireguard-tools" {
            return initial
        }
        "missing_packages= iperf3" { return iperf3 }
        default { return -code error "unexpected-missing-set" }
    }
}

proc provision_plan_policy {payload expected_mode} {
    set normalized [output_value $payload]
    set lines [split $normalized "\n"]
    set missing_class [provision_missing_class $lines]
    if {[exact_line_count $lines "mode=$expected_mode"] != 1 ||
        [exact_line_count $lines \
            "plan_complete planned_commands_executed=0 writes=0 automatic_cleanup=0"] != 1} {
        return -code error "plan-evidence"
    }
    set plan_count [prefix_line_count $lines "plan_command="]
    if {$missing_class eq "none"} {
        if {$plan_count != 0 ||
            [exact_line_count $lines \
                "plan_apt_commands=skipped reason=fixed-package-set-already-installed"] != 1} {
            return -code error "already-ready-plan"
        }
    } else {
        if {$plan_count != 3 ||
            [prefix_line_count $lines "plan_command=A0 argv="] != 1 ||
            [prefix_line_count $lines "plan_command=A1 argv="] != 1 ||
            [prefix_line_count $lines "plan_command=A2 argv="] != 1} {
            return -code error "missing-package-plan"
        }
    }
    if {$expected_mode eq "check"} {
        if {[prefix_line_count $lines "write_start "] != 0 ||
            [prefix_line_count $lines "write_finish "] != 0 ||
            [exact_line_count $lines "provisioning completed"] != 0} {
            return -code error "check-write-evidence"
        }
    } else {
        if {$missing_class eq "none" ||
            [prefix_line_count $lines "write_start "] != 2 ||
            [prefix_line_count $lines "write_finish "] != 2 ||
            [successful_write_finish_count $lines] != 2 ||
            [exact_line_count $lines "provisioning completed"] != 1} {
            return -code error "apply-write-evidence"
        }
    }
    return $missing_class
}

proc assert_output {assertion payload} {
    set value [output_value $payload]
    if {$assertion eq "none"} {
        return
    }
    if {$assertion eq "boot-uuid-line"} {
        set normalized [string map [list "\r\r\n" "\n" "\r\n" "\n"] $payload]
        if {[string first "\r" $normalized] >= 0 ||
            [string length $normalized] != 37 ||
            [string index $normalized end] ne "\n" || ![regexp \
            {^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$} \
            [string range $normalized 0 end-1]]} {
            return -code error "boot-uuid-output-mismatch"
        }
        return
    }
    if {$assertion eq "r1-lock-identity"} {
        if {![regexp \
            {^[0-9]+:[0-9]+:root:root:600:1:45:regular file$} $value]} {
            return -code error "r1-lock-identity-output-mismatch"
        }
        return
    }
    if {[string first "r1-lock-content:" $assertion] == 0} {
        set expected_boot_id [string range $assertion 16 end]
        set normalized [string map [list "\r\r\n" "\n" "\r\n" "\n"] $payload]
        if {![regexp \
                {^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$} \
                $expected_boot_id] ||
            [string first "\r" $normalized] >= 0 ||
            $normalized ne "boot_id\t${expected_boot_id}\n"} {
            return -code error "r1-lock-content-output-mismatch"
        }
        return
    }
    if {$assertion eq "r2-helper-verify"} {
        set expected "B82_V6_RETIREMENT_VERIFIED state=T namespace_writes=0 same_boot=1 receipt=$::R2_RECEIPT_FINAL"
        if {$value ne $expected} {
            return -code error "r2-helper-verify-output-mismatch"
        }
        return
    }
    if {$assertion eq "r2-helper-mutate"} {
        if {![regexp {^B82_V6_RETIREMENT_COMPLETE state=T disposition=advanced namespace_writes=[1-6] same_boot=1$} $value] &&
            $value ne "B82_V6_RETIREMENT_COMPLETE state=T disposition=verified-existing namespace_writes=0 same_boot=1"} {
            return -code error "r2-helper-mutate-output-mismatch"
        }
        return
    }
    if {[string first "exact-entry-set" $assertion] == 0} {
        set expected [lrange $assertion 1 end]
        set actual {}
        if {$value ne ""} {
            set actual [split $value "\n"]
        }
        if {[llength $actual] != [llength $expected] ||
            [lsort -ascii $actual] ne [lsort -ascii $expected]} {
            return -code error "entry-set-output-mismatch"
        }
        return
    }
    if {$assertion eq "same-two-inodes"} {
        set lines [split $value "\n"]
        if {[llength $lines] != 2 || [lindex $lines 0] ne [lindex $lines 1] ||
            ![regexp {^[0-9]+:[0-9]+$} [lindex $lines 0]]} {
            return -code error "inode-pair-output-mismatch"
        }
        return
    }
    if {$assertion eq "empty"} {
        if {$value ne ""} {
            return -code error "expected-empty-output"
        }
        return
    }
    if {[string first "exact:" $assertion] == 0} {
        if {$value ne [string range $assertion 6 end]} {
            return -code error "exact-output-mismatch"
        }
        return
    }
    if {[string first "word:" $assertion] == 0} {
        set expected [string range $assertion 5 end]
        if {[lsearch -exact [split $value] $expected] < 0} {
            return -code error "word-output-missing"
        }
        return
    }
    if {[string first "contains:" $assertion] == 0} {
        set expected [string range $assertion 9 end]
        if {[string first $expected $value] < 0} {
            return -code error "required-output-fragment-missing"
        }
        return
    }
    return -code error "unknown-assertion"
}

proc emit_safe {payload password} {
    if {$password ne ""} {
        set payload [string map [list $password "<credential-redacted>"] $payload]
    }
    puts -nonewline $payload
    flush stdout
}

proc python_json_escape_utf8_content {value} {
    binary scan $value cu* octets
    set escaped ""
    set index 0
    set count [llength $octets]
    while {$index < $count} {
        set first [lindex $octets $index]
        if {$first <= 0x7f} {
            set codepoint $first
            set width 1
        } elseif {$first >= 0xc2 && $first <= 0xdf && $index + 1 < $count} {
            set second [lindex $octets [expr {$index + 1}]]
            if {$second < 0x80 || $second > 0xbf} {
                return -code error "credential-utf8"
            }
            set codepoint [expr {(($first & 0x1f) << 6) | ($second & 0x3f)}]
            set width 2
        } elseif {$first >= 0xe0 && $first <= 0xef && $index + 2 < $count} {
            set second [lindex $octets [expr {$index + 1}]]
            set third [lindex $octets [expr {$index + 2}]]
            if {$third < 0x80 || $third > 0xbf ||
                ($first == 0xe0 && ($second < 0xa0 || $second > 0xbf)) ||
                ($first == 0xed && ($second < 0x80 || $second > 0x9f)) ||
                ($first != 0xe0 && $first != 0xed &&
                 ($second < 0x80 || $second > 0xbf))} {
                return -code error "credential-utf8"
            }
            set codepoint [expr {(($first & 0x0f) << 12) |
                (($second & 0x3f) << 6) | ($third & 0x3f)}]
            set width 3
        } elseif {$first >= 0xf0 && $first <= 0xf4 && $index + 3 < $count} {
            set second [lindex $octets [expr {$index + 1}]]
            set third [lindex $octets [expr {$index + 2}]]
            set fourth [lindex $octets [expr {$index + 3}]]
            if {$third < 0x80 || $third > 0xbf ||
                $fourth < 0x80 || $fourth > 0xbf ||
                ($first == 0xf0 && ($second < 0x90 || $second > 0xbf)) ||
                ($first == 0xf4 && ($second < 0x80 || $second > 0x8f)) ||
                ($first != 0xf0 && $first != 0xf4 &&
                 ($second < 0x80 || $second > 0xbf))} {
                return -code error "credential-utf8"
            }
            set codepoint [expr {(($first & 0x07) << 18) |
                (($second & 0x3f) << 12) | (($third & 0x3f) << 6) |
                ($fourth & 0x3f)}]
            set width 4
        } else {
            return -code error "credential-utf8"
        }
        switch -- $codepoint {
            8 { append escaped {\b} }
            9 { append escaped {\t} }
            10 { append escaped {\n} }
            12 { append escaped {\f} }
            13 { append escaped {\r} }
            34 { append escaped {\"} }
            92 { append escaped {\\} }
            default {
                if {$codepoint >= 0x20 && $codepoint <= 0x7e} {
                    append escaped [format %c $codepoint]
                } elseif {$codepoint <= 0xffff} {
                    append escaped [format {\u%04x} $codepoint]
                } else {
                    set scalar [expr {$codepoint - 0x10000}]
                    append escaped [format {\u%04x\u%04x} \
                        [expr {0xd800 + ($scalar >> 10)}] \
                        [expr {0xdc00 + ($scalar & 0x3ff)}]]
                }
            }
        }
        incr index $width
    }
    return $escaped
}

proc append_capture_output {variable_name chunk password password_json_escape} {
    upvar 1 $variable_name captured
    append captured $chunk
    if {[string bytelength $captured] > 16777232} {
        return -code error "candidate-too-large"
    }
    if {$password ne "" && [string first $password $captured] >= 0} {
        return -code error "credential-in-candidate"
    }
    if {$password_json_escape ne "" &&
        [string first $password_json_escape $captured] >= 0} {
        return -code error "credential-json-escape-in-candidate"
    }
}

proc accept_capture_prompt {variable_name credential_sends buffer} {
    upvar 1 $variable_name captured
    if {$credential_sends == 0} {
        set expected_prompt {siyixuan@192.168.10.82's password: }
        if {$buffer ne $expected_prompt || $captured ne ""} {
            return -code error "capture-ssh-prompt-frame"
        }
    } elseif {$credential_sends == 1} {
        set expected_prompt B82_V6_SUDO_PASSWORD:
        if {$buffer ne $expected_prompt || $captured ne "\r\n"} {
            return -code error "capture-sudo-prompt-frame"
        }
    } else {
        return -code error "capture-credential-frame-count"
    }
}

proc canonical_capture_payload {raw credential_sends} {
    if {$credential_sends < 1 || $credential_sends > 2 ||
        [string first "\u0000" $raw] >= 0} {
        return -code error "capture-prompt-or-nul"
    }
    set without_crlf [string map [list "\r\n" ""] $raw]
    if {[string first "\r" $without_crlf] >= 0 ||
        [string first "\n" $without_crlf] >= 0} {
        return -code error "capture-non-crlf"
    }
    set normalized [string map [list "\r\n" "\n"] $raw]
    set prefix [string repeat "\n" $credential_sends]
    if {[string range $normalized 0 [expr {[string length $prefix] - 1}]] ne $prefix} {
        return -code error "capture-leading-frame"
    }
    set payload [string range $normalized [string length $prefix] end]
    if {[string bytelength $payload] < 3 || [string bytelength $payload] > 16777216 ||
        [string index $payload 0] ne "{" || [string range $payload end-1 end] ne "}\n" ||
        [string first "\n" [string range $payload 0 end-1]] >= 0 ||
        [string first "\r" $payload] >= 0} {
        return -code error "capture-payload-frame"
    }
    return $payload
}

proc read_capture_credential {path} {
    if {[catch {open $path r} credential_file]} {
        return -code error "credential-open"
    }
    fconfigure $credential_file -encoding binary -translation binary
    if {[catch {read $credential_file 4097} payload]} {
        close $credential_file
        return -code error "credential-read"
    }
    close $credential_file
    if {[string bytelength $payload] > 4096 || $payload eq ""} {
        return -code error "credential-shape"
    }
    if {[string index $payload end] eq "\n"} {
        set payload [string range $payload 0 end-1]
    }
    set boundary [string first "\n" $payload]
    if {$boundary < 1 || [string first "\n" $payload [expr {$boundary + 1}]] >= 0} {
        return -code error "credential-shape"
    }
    set ssh_line [string range $payload 0 [expr {$boundary - 1}]]
    set password_bytes [string range $payload [expr {$boundary + 1}] end]
    set payload ""
    if {$ssh_line ne "ssh siyixuan@192.168.10.82" || $password_bytes eq "" ||
        [string first "\u0000" $password_bytes] >= 0 ||
        [string first "\r" $password_bytes] >= 0 ||
        [string first "\n" $password_bytes] >= 0 ||
        [catch {python_json_escape_utf8_content $password_bytes} escape_error]} {
        set password_bytes ""
        return -code error "credential-value"
    }
    return $password_bytes
}

proc clean_child_exit_status {wait_status} {
    if {[llength $wait_status] != 4 || [lindex $wait_status 2] != 0 ||
        ![string is integer -strict [lindex $wait_status 3]] ||
        [lindex $wait_status 3] < 0 || [lindex $wait_status 3] > 255} {
        return -code error "child-wait-status"
    }
    return [lindex $wait_status 3]
}

proc capture_payload_to_eof {child_id variable_name credential_sends password_bytes \
    password_json_escape deadline_ms} {
    upvar 1 $variable_name captured_output
    set remaining_ms [expr {$deadline_ms - [clock milliseconds]}]
    if {$remaining_ms < 1000} {
        fail "timeout" 124
    }
    set timeout [expr {int($remaining_ms / 1000)}]
    expect {
        -i $child_id
        timeout {
            fail "timeout" 124
        }
        full_buffer {
            fail "capture-full-buffer" 78
        }
        eof {
            if {[info exists expect_out(buffer)] && $expect_out(buffer) ne ""} {
                if {[catch {append_capture_output captured_output $expect_out(buffer) \
                    $password_bytes $password_json_escape} capture_error]} {
                    fail $capture_error 78
                }
            }
            set wait_status [wait -i $child_id]
            if {[catch {clean_child_exit_status $wait_status} child_rc]} {
                fail "child-wait-status" 78
            }
            if {$child_rc != 0} {
                exit $child_rc
            }
            if {[clock milliseconds] > $deadline_ms} {
                fail "timeout" 124
            }
            if {($password_bytes ne "" &&
                 [string first $password_bytes $captured_output] >= 0) ||
                ($password_json_escape ne "" &&
                 [string first $password_json_escape $captured_output] >= 0)} {
                fail "credential-in-candidate" 78
            }
            if {[catch {canonical_capture_payload $captured_output $credential_sends} payload]} {
                fail "capture-framing-$payload" 78
            }
            return [list $payload $credential_sends [string bytelength $captured_output]]
        }
    }
}

proc capture_child_payload {child_id password_bytes prompt_limit timeout_seconds} {
    set timeout $timeout_seconds
    set deadline_ms [expr {[clock milliseconds] + ($timeout_seconds * 1000)}]
    set captured_output ""
    set credential_sends 0
    set password_json_escape [python_json_escape_utf8_content $password_bytes]
    set credential_pattern {(?:siyixuan@192\.168\.10\.82's password: |B82_V6_SUDO_PASSWORD:)$}
    fconfigure $child_id -encoding binary -translation binary
    match_max -i $child_id 16781312
    remove_nulls -i $child_id 0
    expect {
        -i $child_id
        -re {^\r\n} {
            if {[catch {append_capture_output captured_output $expect_out(buffer) \
                $password_bytes $password_json_escape} capture_error]} {
                set password_bytes ""
                set password_json_escape ""
                fail $capture_error 78
            }
            exp_continue -continue_timer
        }
        -re $credential_pattern {
            if {[catch {accept_capture_prompt captured_output $credential_sends \
                $expect_out(buffer)} capture_error]} {
                set password_bytes ""
                set password_json_escape ""
                fail $capture_error 78
            }
            incr credential_sends
            if {$credential_sends > $prompt_limit} {
                set password_bytes ""
                set password_json_escape ""
                fail "credential-prompt-count" 77
            }
            send -i $child_id -- $password_bytes
            send -i $child_id -- "\r"
            exp_continue -continue_timer
        }
        -exact "\{" {
            set expected_prefix [string repeat "\r\n" $credential_sends]
            if {$credential_sends < 1 || $credential_sends > 2 ||
                $expect_out(buffer) ne "\{" || $captured_output ne $expected_prefix} {
                set password_bytes ""
                set password_json_escape ""
                fail "capture-payload-start-frame" 78
            }
            if {[catch {append_capture_output captured_output "\{" $password_bytes \
                $password_json_escape} capture_error]} {
                set password_bytes ""
                set password_json_escape ""
                fail $capture_error 78
            }
            set result [capture_payload_to_eof $child_id captured_output \
                $credential_sends $password_bytes $password_json_escape $deadline_ms]
            set password_bytes ""
            set password_json_escape ""
            return $result
        }
        timeout {
            set password_bytes ""
            set password_json_escape ""
            fail "timeout" 124
        }
        full_buffer {
            set password_bytes ""
            set password_json_escape ""
            fail "capture-full-buffer" 78
        }
        eof {
            set wait_status [wait -i $child_id]
            if {[catch {clean_child_exit_status $wait_status} child_rc]} {
                set password_bytes ""
                set password_json_escape ""
                fail "child-wait-status" 78
            }
            if {$child_rc != 0} {
                set password_bytes ""
                set password_json_escape ""
                exit $child_rc
            }
            set password_bytes ""
            set password_json_escape ""
            fail "capture-missing-payload" 78
        }
    }
}

proc base_identity_operations {} {
    return {identity-hostname identity-kernel identity-machine identity-netns identity-interface}
}

proc postflight_operations {} {
    return {
        identity-driver identity-wg-interfaces
        tool-go tool-clang tool-llvm tool-bpftool tool-make tool-gcc tool-iperf3
        tool-shellcheck tool-jq tool-wireguard tool-ethtool tool-tc tool-ip
        kernel-btf kernel-bpffs kernel-headers
    }
}

proc prepare_stale_operations {} {
    return {
        stale-package-root stale-bootstrap-root stale-alternate-bootstrap-root
        stale-stage-root stale-fresh-root stale-standalone-root
        stale-routed-evidence-root stale-realnic-run-roots
        stale-realnic-interface-leases stale-veth-wgc8e41a stale-veth-wgc8e41b
        stale-veth-wga19f7a stale-veth-wga19f7b stale-veth-wg5b8d3a
