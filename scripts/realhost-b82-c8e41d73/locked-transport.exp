proc r2_mutation_operation {operation} {
    return [expr {$operation eq "retire-postflight-f75fe7678cfd-r2"}]
}

proc r2_read_only_operation {operation} {
    return [expr {$operation eq "verify-postflight-retirement-r2"}]
}

proc transaction_operation {operation} {
    return [expr {$operation in {
        prepare provision-apply fresh-run fresh-restore veth-run veth-restore
        routed-run routed-restore realnic-run realnic-restore
        retire-postflight-f75fe7678cfd-r2
    }}]
}

proc read_only_operation {operation} {
    if {[r2_read_only_operation $operation]} {
        return 1
    }
    if {[lsearch -exact [concat [base_identity_operations] [postflight_operations] \
        [prepare_stale_operations]] $operation] >= 0} {
        return 1
    }
    if {$operation in {
        package-parent-stat bootstrap-absent bootstrap-not-symlink
        bootstrap-root-readlink bootstrap-root-stat bootstrap-stager-readlink
        bootstrap-stager-stat bootstrap-stager-sha bootstrap-provisioner-readlink
        bootstrap-provisioner-stat bootstrap-provisioner-sha provision-check
        stage-plan fresh-plan veth-plan routed-plan
        verify-sha-realnic-approved-plan verify-stat-realnic-approved-plan
        stage-realnic-plan-verify
    }} {
        return 1
    }
    if {[regexp {^verify-(?:sha|stat)-(.+)$} $operation -> name] &&
        [lsearch -exact [package_names] $name] >= 0} {
        return 1
    }
    return 0
}

proc operation_requires_approved_sha {operation} {
    return [expr {$operation in {
        scp-realnic-approved-plan verify-sha-realnic-approved-plan
        verify-stat-realnic-approved-plan stage-realnic-plan-snapshot
        realnic-run stage-realnic-plan-verify realnic-restore
    }}]
}

proc read_execute_credential {credential_path} {
    if {[catch {open $credential_path r} credential_file]} {
        fail "credential-open" 65
    }
    fconfigure $credential_file -encoding utf-8 -translation lf
    if {[gets $credential_file ssh_line] < 0 || [gets $credential_file password] < 0 ||
        [gets $credential_file unexpected] >= 0} {
        close $credential_file
        set password ""
        fail "credential-shape" 65
    }
    close $credential_file
    set ssh_parts [split [string trim $ssh_line]]
    set ssh_line ""
    if {$ssh_parts ne [list ssh siyixuan@192.168.10.82] || $password eq "" ||
        [string first "\u0000" $password] >= 0 || [string first "\r" $password] >= 0 ||
        [string first "\n" $password] >= 0} {
        set password ""
        fail "credential-value" 65
    }
    return $password
}

proc require_manifest_authority {values manifest_sha} {
    set manifest "[dict get $values local_package_dir]/package-manifest.v1"
    if {[catch {load_manifest $manifest $manifest_sha} current] ||
        $current ne $values ||
        [catch {exec /usr/bin/id -u} caller_uid] ||
        ![regexp {^[0-9]+$} $caller_uid] ||
        [catch {file lstat $manifest manifest_stat}] ||
        [catch {file lstat [dict get $values local_package_dir] package_stat}] ||
        $manifest_stat(type) ne "file" || $manifest_stat(nlink) != 1 ||
        ($manifest_stat(mode) & 07777) != 0600 ||
        $package_stat(type) ne "directory" ||
        ($package_stat(mode) & 07777) != 0700 ||
        $package_stat(uid) != $caller_uid ||
        $manifest_stat(uid) != $package_stat(uid) ||
        $manifest_stat(gid) != $package_stat(gid)} {
        fail "manifest-transaction-drift" 66
    }
}


proc require_controller_verifier_authority {values} {
    set repository [dict get $values local_repository]
    set controller_path [dict get $values controller_sh_path]
    set controller_source "${repository}/${controller_path}"
    set package [dict get $values local_package_dir]
    set controller_copy "${package}/controller.sh"
    set expected_path "scripts/realhost-b82-c8e41d73/controller.sh"
    set expected_sha [dict get $values controller_sh_sha256]
    set expected_blob [dict get $values controller_sh_blob]
    if {$controller_path ne $expected_path ||
        [catch {file normalize $repository} normalized_repository] ||
        $normalized_repository ne $repository ||
        [catch {file normalize $controller_source} normalized_source] ||
        $normalized_source ne $controller_source ||
        [catch {file lstat $controller_source source_stat}] ||
        [catch {file lstat $controller_copy copy_stat}] ||
        [catch {file lstat $package package_stat}] ||
        $source_stat(type) ne "file" || $source_stat(nlink) != 1 ||
        $source_stat(size) < 1 || $source_stat(size) > 16777216 ||
        ($source_stat(mode) & 07777) != 0755 ||
        $copy_stat(type) ne "file" || $copy_stat(nlink) != 1 ||
        $copy_stat(size) < 1 || $copy_stat(size) > 16777216 ||
        ($copy_stat(mode) & 07777) != 0600 ||
        $package_stat(type) ne "directory" ||
        ($package_stat(mode) & 07777) != 0700 ||
        $copy_stat(uid) != $package_stat(uid) ||
        $copy_stat(gid) != $package_stat(gid) ||
        [catch {file_sha256 $controller_source} source_sha] ||
        $source_sha ne $expected_sha ||
        [catch {file_sha256 $controller_copy} copy_sha] ||
        $copy_sha ne $expected_sha} {
        fail "controller-verifier-shape" 66
    }
    set git_prefix [list /usr/bin/env -i PATH=/usr/bin:/bin LC_ALL=C \
        GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 \
        GIT_NO_REPLACE_OBJECTS=1 GIT_OPTIONAL_LOCKS=0 \
        /usr/bin/git --no-pager --no-replace-objects \
        -c core.attributesFile=/dev/null -c core.fsmonitor=false \
        -c core.hooksPath=/dev/null -C $repository]
    set integration_commit [dict get $values integration_commit]
    set integration_ref [dict get $values integration_ref]
    if {[catch {exec {*}$git_prefix rev-parse --show-toplevel} top_level] ||
        [string trim $top_level] ne $repository ||
        [catch {exec {*}$git_prefix rev-parse --verify "${integration_ref}^{commit}"} ref_commit] ||
        [string trim $ref_commit] ne $integration_commit ||
        [catch {exec {*}$git_prefix hash-object -- $controller_source} source_blob] ||
        [string trim $source_blob] ne $expected_blob ||
        [catch {exec {*}$git_prefix rev-parse "${integration_commit}:${controller_path}"} commit_blob] ||
        [string trim $commit_blob] ne $expected_blob ||
        [catch {exec {*}$git_prefix ls-tree $integration_commit -- $controller_path} tree_entry] ||
        [string trim $tree_entry] ne "100755 blob ${expected_blob}\t${controller_path}"} {
        fail "controller-verifier-git-identity" 66
    }
}

proc execute_controller_package_verifier {values manifest_sha} {
    set package [dict get $values local_package_dir]
    set controller "${package}/controller.sh"
    set manifest "${package}/package-manifest.v1"
    if {[catch {file lstat $package package_stat}]} {
        fail "controller-package-verifier-shape" 66
    }
    set expected_marker "B82_V6_CONTROLLER_PACKAGE_VERIFIED manifest_sha256=$manifest_sha integration_commit=[dict get $values integration_commit] package_device_inode=$package_stat(dev):$package_stat(ino) credential_read=0 network_operations=0"
    set verifier_argv [list /usr/bin/env -i PATH=/usr/bin:/bin LC_ALL=C \
        /bin/bash $controller verify-package \
        --manifest $manifest --manifest-sha256 $manifest_sha \
        --credential-path /Users/siyixuan/codes-2/wg-mix-ebpf/credientials/192.168.10.82 \
        --approved-plan-sha256 none]
    if {[catch {exec {*}$verifier_argv 2>@1} verifier_output]} {
        fail "controller-package-verifier" 66
    }
    set normalized [output_value $verifier_output]
    set lines [split $normalized "\n"]
    if {[exact_line_count $lines $expected_marker] != 1 ||
        [lindex $lines end] ne $expected_marker} {
        fail "controller-package-verifier-marker" 66
    }
    puts "B82_V6_TRANSPORT_PACKAGE_AUTHORITY manifest_sha256=$manifest_sha integration_commit=[dict get $values integration_commit] package_device_inode=$package_stat(dev):$package_stat(ino) verifier=controller-read-only"
}

proc execute_r2_predecessor_controller_verifier {values manifest_sha} {
    set package [dict get $values local_package_dir]
    set controller "${package}/controller.sh"
    set manifest "${package}/package-manifest.v1"
    if {[catch {file lstat $::R2_PREDECESSOR_LOCAL_PACKAGE predecessor_stat}] ||
        $predecessor_stat(type) ne "directory"} {
        fail "r2-controller-predecessor-shape" 66
    }
    set expected_marker "B82_V6_CONTROLLER_R2_PREDECESSOR_VERIFIED predecessor_manifest_sha256=$::R2_PREDECESSOR_MANIFEST_SHA256 predecessor_commit=$::R2_PREDECESSOR_COMMIT package_device_inode=$predecessor_stat(dev):$predecessor_stat(ino) credential_read=0 network_operations=0"
    set verifier_argv [list /usr/bin/env -i PATH=/usr/bin:/bin LC_ALL=C \
        /bin/bash $controller verify-r2-predecessor-package \
        --manifest $manifest --manifest-sha256 $manifest_sha \
        --credential-path \
        /Users/siyixuan/codes-2/wg-mix-ebpf/credientials/192.168.10.82 \
        --approved-plan-sha256 none]
    if {[catch {exec {*}$verifier_argv 2>@1} verifier_output]} {
        fail "r2-controller-predecessor-verifier" 66
    }
    set lines [split [output_value $verifier_output] "\n"]
    if {[exact_line_count $lines $expected_marker] != 1 ||
        [lindex $lines end] ne $expected_marker} {
        fail "r2-controller-predecessor-marker" 66
    }
    puts "B82_V6_R2_LOCAL_AUTHORITIES current_manifest_sha256=$manifest_sha predecessor_manifest_sha256=$::R2_PREDECESSOR_MANIFEST_SHA256 credential_read=0 network_operations=0"
}

proc require_transaction_local_authority {values manifest_sha operation approved_sha} {
    require_controller_verifier_authority $values
    foreach name [package_names] {
        if {[catch {build_operation $values $manifest_sha "scp-$name" none} \
            package_copy_spec]} {
            fail "local-package-artifact" 66
        }
    }
    execute_controller_package_verifier $values $manifest_sha
    if {$operation eq "realnic-run" &&
        [catch {build_operation $values $manifest_sha scp-realnic-approved-plan \
            $approved_sha} approved_plan_spec]} {
        fail "realnic-approved-plan-local" 66
    }
}

proc execute_operation_spec {operation operation_spec password} {
    lassign $operation_spec transport_type spawn_argv prompt_limit assertion timeout_seconds
    puts "B82_V6_TRANSPORT_EXECUTE operation=$operation transport=$transport_type credential_in_argv=0 channel=execute"
    puts "EXPECT_SPAWN_ARGV [list {*}$spawn_argv]"
    log_user 0
    spawn -noecho {*}$spawn_argv
    set child_id $spawn_id
    set timeout $timeout_seconds
    set captured_output ""
    set credential_sends 0
    set credential_pattern {(?i)(?:password|passphrase)[^:\r\n]*:[ \t]*$}
    expect {
        -i $child_id
        -re $credential_pattern {
            incr credential_sends
            if {$credential_sends > $prompt_limit} {
                set password ""
                fail "credential-prompt-count" 77
            }
            send -i $child_id -- "$password\r"
            exp_continue
        }
        -re {[^\r\n]*(?:\r\n|\n|\r)} {
            append captured_output $expect_out(buffer)
            emit_safe $expect_out(buffer) $password
            exp_continue
        }
        timeout {
            set password ""
            fail "timeout" 124
        }
        eof {
            if {[info exists expect_out(buffer)] && $expect_out(buffer) ne ""} {
                append captured_output $expect_out(buffer)
                emit_safe $expect_out(buffer) $password
            }
            if {[catch {wait -i $child_id} wait_status] ||
                [catch {clean_child_exit_status $wait_status} child_rc]} {
                set password ""
                fail "child-wait-status" 78
            }
            if {$child_rc != 0} {
                set password ""
                if {$assertion in {provision-check provision-apply}} {
                    puts "B82_V6_PROVISION_AUDIT operation=$assertion child_rc=$child_rc plan=unverified missing_set=unverified next_state=STOP"
                }
                return [list child-failure $child_rc $captured_output none]
            }
            set policy_result none
            if {$assertion eq "provision-check"} {
                if {[catch {provision_plan_policy $captured_output check} policy_result]} {
                    puts "B82_V6_PROVISION_AUDIT operation=provision-check child_rc=0 plan=rejected missing_set=unexpected next_state=STOP policy=$policy_result"
                    fail "output-assertion" 78
                }
                set next_state [expr {$policy_result eq "none" ? "POSTFLIGHT" : "AWAIT_APPLY"}]
                puts "B82_V6_PROVISION_AUDIT operation=provision-check child_rc=0 plan=valid missing_set=$policy_result next_state=$next_state"
            } elseif {$assertion eq "provision-apply"} {
                if {[catch {provision_plan_policy $captured_output apply} policy_result]} {
                    puts "B82_V6_PROVISION_AUDIT operation=provision-apply child_rc=0 plan=rejected missing_set=unexpected next_state=STOP policy=$policy_result"
                    fail "output-assertion" 78
                }
                puts "B82_V6_PROVISION_AUDIT operation=provision-apply child_rc=0 plan=valid missing_set=$policy_result next_state=POSTFLIGHT"
            } elseif {[catch {assert_output $assertion $captured_output} assertion_message]} {
                fail "output-assertion" 78
            }
            set password ""
            return [list ok 0 $captured_output $policy_result]
        }
    }
}

proc execute_primitive {values manifest_sha operation approved_sha password} {
    require_manifest_authority $values $manifest_sha
    if {[catch {build_operation $values $manifest_sha $operation $approved_sha} operation_spec]} {
        fail "policy" 66
    }
    return [execute_operation_spec $operation $operation_spec $password]
}

proc require_primitive_success {result} {
    if {[lindex $result 0] ne "ok"} {
        exit [lindex $result 1]
    }
    return $result
}

proc transaction_step {values manifest_sha operation approved_sha password} {
    set result [execute_primitive $values $manifest_sha $operation $approved_sha $password]
    require_primitive_success $result
    puts "B82_V6_TRANSPORT_TRANSACTION_STEP operation=$operation rc=0"
    return $result
}

proc execute_retirement_lineage_primitive {
    values manifest_sha operation password {boot_id ""} {lock_identity ""}
} {
    require_manifest_authority $values $manifest_sha
    if {[catch {build_retirement_lineage_operation $values $operation \
        $boot_id $lock_identity} operation_spec]} {
        fail "retirement-lineage-policy" 66
    }
    return [execute_operation_spec $operation $operation_spec $password]
}

proc retirement_lineage_path_exists {
    values manifest_sha operation password
} {
    switch -- $operation {
        lineage-exists-user-intake { set fixed_path $::RETIREMENT_USER_INTAKE }
        lineage-exists-home-qroot { set fixed_path $::RETIREMENT_HOME_QROOT }
        lineage-exists-run-qroot { set fixed_path $::RETIREMENT_RUN_QROOT }
        lineage-exists-receipt-pending {
            set fixed_path $::RETIREMENT_RECEIPT_PENDING
        }
        default { fail "retirement-lineage-existence-operation" 66 }
    }
    set result [execute_retirement_lineage_primitive $values $manifest_sha \
        $operation $password]
    if {[lindex $result 0] ne "ok"} {
        fail "retirement-lineage-partial-$operation" 78
    }
    set value [output_value [lindex $result 2]]
    if {$value eq ""} {
        return 0
    }
    if {$value eq $fixed_path} {
        return 1
    }
    fail "retirement-lineage-presence-output-$operation" 78
}

proc retirement_lineage_step {
    values manifest_sha operation password {boot_id ""} {lock_identity ""}
} {
    set result [execute_retirement_lineage_primitive $values $manifest_sha \
        $operation $password $boot_id $lock_identity]
    if {[lindex $result 0] ne "ok"} {
        fail "retirement-lineage-partial-$operation" 78
    }
    puts "B82_V6_RETIREMENT_LINEAGE_STEP operation=$operation rc=0 writes=0"
    return $result
}

proc execute_retirement_lineage_gate {values manifest_sha password} {
    set user_intake [retirement_lineage_path_exists $values $manifest_sha         lineage-exists-user-intake $password]
    set home_qroot [retirement_lineage_path_exists $values $manifest_sha         lineage-exists-home-qroot $password]
    set run_qroot [retirement_lineage_path_exists $values $manifest_sha         lineage-exists-run-qroot $password]

    if {!$user_intake && !$home_qroot && !$run_qroot} {
        puts "B82_V6_RETIREMENT_LINEAGE state=FRESH namespace_absent=3 user_intake=absent home_qroot=absent run_qroot=absent namespace_writes=0"
        return FRESH
    }
    if {$user_intake || !$home_qroot || !$run_qroot} {
        fail "retirement-lineage-partial-state" 78
    }
    if {[retirement_lineage_path_exists $values $manifest_sha         lineage-exists-receipt-pending $password]} {
        fail "retirement-lineage-receipt-pending" 78
    }

    set retained_lock_identity ""
    foreach operation {
        lineage-home-readlink lineage-home-stat lineage-home-entries
        lineage-auth-readlink lineage-auth-stat lineage-auth-entries
        lineage-run-readlink lineage-run-stat lineage-run-entries
        lineage-auth-manifest-pending-stat lineage-auth-manifest-pending-sha
        lineage-auth-manifest-stat lineage-auth-manifest-sha
        lineage-auth-manifest-pair
        lineage-auth-self-pending-stat lineage-auth-self-pending-sha
        lineage-auth-self-stat lineage-auth-self-sha lineage-auth-self-pair
        lineage-q-intake-readlink lineage-q-intake-stat
        lineage-q-intake-entries lineage-q-intake-manifest-stat
        lineage-q-intake-manifest-sha lineage-q-intake-self-stat
        lineage-q-intake-self-sha
        lineage-q-package-readlink lineage-q-package-stat
        lineage-q-package-entries
        lineage-q-bootstrap-readlink lineage-q-bootstrap-stat
        lineage-q-bootstrap-entries
        lineage-lock-stat lineage-receipt-stat lineage-receipt-sha
    } {
        set result [retirement_lineage_step $values $manifest_sha \
            $operation $password]
        if {$operation eq "lineage-lock-stat"} {
            set retained_lock_identity [output_value [lindex $result 2]]
        }
    }

    if {[catch {retained_retirement_readonly_operations} readonly_operations] ||
        [llength $readonly_operations] != 41} {
        fail "retirement-lineage-readonly-cardinality" 66
    }
    set retained_boot_id ""
    foreach operation $readonly_operations {
        if {$operation eq "lineage-lock-content-read"} {
            if {$retained_boot_id eq ""} {
                fail "retirement-lineage-boot-order" 66
            }
            retirement_lineage_step $values $manifest_sha $operation $password \
                $retained_boot_id
        } elseif {$operation eq "lineage-lock-stat-recheck"} {
            if {$retained_lock_identity eq ""} {
                fail "retirement-lineage-lock-order" 66
            }
            retirement_lineage_step $values $manifest_sha $operation $password \
                $retained_boot_id $retained_lock_identity
        } else {
            set result [retirement_lineage_step $values $manifest_sha \
                $operation $password]
            if {$operation eq "lineage-boot-id-read"} {
                set retained_boot_id [output_value [lindex $result 2]]
            }
        }
    }

    if {[retirement_lineage_path_exists $values $manifest_sha             lineage-exists-user-intake $password] ||
        ![retirement_lineage_path_exists $values $manifest_sha             lineage-exists-home-qroot $password] ||
        ![retirement_lineage_path_exists $values $manifest_sha             lineage-exists-run-qroot $password] ||
        [retirement_lineage_path_exists $values $manifest_sha             lineage-exists-receipt-pending $password]} {
        fail "retirement-lineage-terminal-recheck" 78
    }
    puts "B82_V6_RETIREMENT_LINEAGE state=TERMINAL retained_commit=$::RETAINED_RETIREMENT_COMMIT retained_manifest_sha256=$::RETAINED_RETIREMENT_MANIFEST_SHA256 retained_helper_sha256=$::RETAINED_RETIREMENT_HELPER_SHA256 receipt_sha256=$::RETAINED_RETIREMENT_RECEIPT_SHA256 package_files=17 bootstrap_files=2 primitives=84 same_boot=1 lock_inode_stable=1 namespace_writes=0"
    return TERMINAL
}

proc execute_r2_primitive {
    values manifest_sha predecessor_values operation password
} {
    require_manifest_authority $values $manifest_sha
    if {[catch {r2_load_predecessor_manifest \
        "${::R2_PREDECESSOR_LOCAL_PACKAGE}/package-manifest.v1"} \
        current_predecessor]} {
        fail "r2-predecessor-manifest-drift" 66
    }
    if {$current_predecessor ne $predecessor_values ||
        [catch {build_r2_operation $values $manifest_sha $predecessor_values \
            $operation} operation_spec]} {
        fail "r2-policy" 66
    }
    return [execute_operation_spec $operation $operation_spec $password]
}

proc r2_step {values manifest_sha predecessor_values operation password} {
    if {[string first "r2-raw-" $operation] == 0} {
        r2_mutation_trace_record $operation
    }
    set result [execute_r2_primitive $values $manifest_sha \
        $predecessor_values $operation $password]
    require_primitive_success $result
    puts "B82_V6_R2_STEP operation=$operation rc=0"
    return $result
}

proc r2_path_exists {
    values manifest_sha predecessor_values path_name password
} {
    set operation "r2-ro-exists-${path_name}"
    set result [execute_r2_primitive $values $manifest_sha \
        $predecessor_values $operation $password]
    if {[lindex $result 0] eq "ok"} {
        return 1
    }
    if {[lindex $result 0] eq "child-failure" && [lindex $result 1] == 1} {
        return 0
    }
    exit [lindex $result 1]
}

proc r2_user_intake_exists {
    values manifest_sha predecessor_values password
} {
    set result [execute_r2_primitive $values $manifest_sha \
        $predecessor_values r2-ro-user-intake-exists $password]
    if {[lindex $result 0] eq "ok"} {
        return 1
    }
    if {[lindex $result 0] eq "child-failure" && [lindex $result 1] == 1} {
        return 0
    }
    exit [lindex $result 1]
}

proc r2_try_intake_mkdir {
    values manifest_sha predecessor_values password
} {
    r2_mutation_trace_record r2-raw-intake-mkdir
    set result [execute_r2_primitive $values $manifest_sha \
        $predecessor_values r2-raw-intake-mkdir $password]
    if {[lindex $result 0] eq "ok"} {
        r2_mutation_trace_intake_created
        puts "B82_V6_R2_STEP operation=r2-raw-intake-mkdir rc=0 created=1"
        return
    }
    if {[lindex $result 0] ne "child-failure" || [lindex $result 1] != 1 ||
        ![r2_user_intake_exists $values $manifest_sha $predecessor_values \
            $password]} {
        exit [lindex $result 1]
    }
    puts "B82_V6_R2_STEP operation=r2-raw-intake-mkdir rc=0 created=0 convergence=existing"
}

proc r2_read_entries {
    values manifest_sha predecessor_values operation password
} {
    set result [r2_step $values $manifest_sha $predecessor_values \
        $operation $password]
    set value [output_value [lindex $result 2]]
    if {$value eq ""} {
        return {}
    }
    if {[string first "\u0000" $value] >= 0 ||
        [string first "\r" $value] >= 0} {
        fail "r2-entry-framing" 78
    }
    return [split $value "\n"]
}

proc r2_require_entries {actual expected reason} {
    if {[llength $actual] != [llength $expected] ||
        [lsort -ascii $actual] ne [lsort -ascii $expected]} {
        fail $reason 78
    }
}

proc r2_observe_sha {
    values manifest_sha predecessor_values operation artifact password
} {
    set result [r2_step $values $manifest_sha $predecessor_values \
        $operation $password]
    set value [output_value [lindex $result 2]]
    set digest [string range $value 0 63]
    if {![regexp {^[0-9a-f]{64}$} $digest] ||
        [string range $value 64 end] ne "  ${artifact}"} {
        fail "r2-sha-output" 78
    }
    return $digest
}

proc r2_observe_intake_size {
    values manifest_sha predecessor_values operation password
} {
    set result [r2_step $values $manifest_sha $predecessor_values \
        $operation $password]
    set value [output_value [lindex $result 2]]
    if {![regexp {^siyixuan:siyixuan:600:1:([0-9]+):regular file$} \
        $value -> size] || ![string is integer -strict $size] ||
        $size < 0 || $size > 16777216} {
        fail "r2-intake-file-shape" 78
    }
    return $size
}

proc r2_observe_auth_pending_size {
    values manifest_sha predecessor_values name operation password
} {
    set result [r2_step $values $manifest_sha $predecessor_values \
        $operation $password]
    set value [output_value [lindex $result 2]]
    switch -- $name {
        package-manifest.v1 { set expected_mode 600 }
        prepare-stage-root.sh { set expected_mode 700 }
        default { fail "r2-auth-pending-size-name" 78 }
    }
    set pattern [format {^root:root:%s:1:([0-9]+):regular file$} \
        $expected_mode]
    if {![regexp $pattern $value -> size] ||
        ![string is integer -strict $size] || $size < 0 ||
        $size > 16777216} {
        fail "r2-auth-pending-file-shape" 78
    }
    return $size
}

proc r2_require_auth_pending_prefix {
    values manifest_sha predecessor_values name password
} {
    switch -- $name {
        package-manifest.v1 {
            set shape_operation r2-ro-auth-manifest-pending-shape
            set sha_operation r2-ro-auth-manifest-pending-sha-observe
            set remote_artifact $::R2_AUTH_MANIFEST_PENDING
        }
        prepare-stage-root.sh {
            set shape_operation r2-ro-auth-self-pending-shape
            set sha_operation r2-ro-auth-self-pending-sha-observe
            set remote_artifact $::R2_AUTH_SELF_PENDING
        }
        default { fail "r2-auth-pending-prefix-name" 78 }
    }
    if {[catch {r2_local_delivery_file $values $manifest_sha $name} \
        local_authority]} {
        fail "r2-auth-pending-local-authority" 66
    }
    lassign $local_authority local_artifact expected_sha
    if {[catch {file lstat $local_artifact local_stat}]} {
        fail "r2-auth-pending-local-stat" 66
    }
    set remote_size [r2_observe_auth_pending_size $values $manifest_sha \
        $predecessor_values $name $shape_operation $password]
    set remote_sha [r2_observe_sha $values $manifest_sha $predecessor_values \
        $sha_operation $remote_artifact $password]
    if {$remote_size > $local_stat(size)} {
        fail "r2-auth-pending-oversize" 78
    }
    if {$remote_size == $local_stat(size) && $remote_sha eq $expected_sha} {
        set prefix_class exact
    } elseif {[catch {r2_file_prefix_sha256 $local_artifact $remote_size} \
        prefix_sha] || $remote_sha ne $prefix_sha} {
        fail "r2-auth-pending-nonprefix" 78
    } elseif {$remote_size == 0} {
        set prefix_class empty
    } else {
        set prefix_class prefix
    }
    if {[catch {r2_local_delivery_file $values $manifest_sha $name} \
        rechecked_authority]} {
        fail "r2-auth-pending-local-drift" 66
    }
    lassign $rechecked_authority rechecked_artifact rechecked_sha
    if {$rechecked_artifact ne $local_artifact ||
        $rechecked_sha ne $expected_sha ||
        [catch {file lstat $rechecked_artifact rechecked_stat}]} {
        fail "r2-auth-pending-local-drift" 66
    }
    foreach field {dev ino size mode nlink uid gid type} {
        if {$rechecked_stat($field) ne $local_stat($field)} {
            fail "r2-auth-pending-local-drift" 66
        }
    }
    return $prefix_class
}

proc r2_require_intake_prefix {
    values manifest_sha predecessor_values name password
} {
    switch -- $name {
        package-manifest.v1 {
            set shape_operation r2-ro-intake-manifest-shape
            set sha_operation r2-ro-intake-manifest-sha-observe
        }
        prepare-stage-root.sh {
            set shape_operation r2-ro-intake-self-shape
            set sha_operation r2-ro-intake-self-sha-observe
        }
        default { fail "r2-intake-prefix-name" 78 }
    }
    if {[catch {r2_local_delivery_file $values $manifest_sha $name} \
        local_authority]} {
        fail "r2-intake-local-authority" 66
    }
    lassign $local_authority local_artifact expected_sha
    if {[catch {file lstat $local_artifact local_stat}]} {
        fail "r2-intake-local-stat" 66
    }
    set remote_artifact "${::R2_USER_INTAKE}/${name}"
    set remote_size [r2_observe_intake_size $values $manifest_sha \
        $predecessor_values $shape_operation $password]
    set remote_sha [r2_observe_sha $values $manifest_sha $predecessor_values \
        $sha_operation $remote_artifact $password]
    if {$remote_sha eq $expected_sha} {
        return exact
    }
    if {$remote_size > $local_stat(size) ||
        [catch {r2_file_prefix_sha256 $local_artifact $remote_size} prefix_sha] ||
        $remote_sha ne $prefix_sha} {
        fail "r2-intake-nonprefix" 78
    }
    if {[catch {r2_local_delivery_file $values $manifest_sha $name} \
        rechecked_authority]} {
        fail "r2-intake-local-drift" 66
    }
    lassign $rechecked_authority rechecked_artifact rechecked_sha
    if {$rechecked_artifact ne $local_artifact ||
        $rechecked_sha ne $expected_sha ||
        [catch {file lstat $rechecked_artifact rechecked_stat}]} {
        fail "r2-intake-local-drift" 66
    }
    foreach field {dev ino size mode nlink uid gid type} {
        if {$rechecked_stat($field) ne $local_stat($field)} {
            fail "r2-intake-local-drift" 66
        }
    }
    return prefix
}

proc r2_verify_manifest_pair {
    values manifest_sha predecessor_values password
} {
    foreach operation {
        r2-ro-auth-manifest-pending-sha r2-ro-auth-manifest-sha
        r2-ro-auth-manifest-stat r2-ro-auth-manifest-pair
    } {
        r2_step $values $manifest_sha $predecessor_values $operation $password
    }
}

proc r2_verify_self_pair {
    values manifest_sha predecessor_values password
} {
    foreach operation {
        r2-ro-auth-self-pending-sha r2-ro-auth-self-sha
        r2-ro-auth-self-stat r2-ro-auth-self-pair
    } {
        r2_step $values $manifest_sha $predecessor_values $operation $password
    }
}

proc r2_authority_state {
    values manifest_sha predecessor_values password
} {
    set names {
        home-qroot auth-root run-qroot auth-manifest-pending auth-manifest
        auth-self-pending auth-self quarantine-intake quarantine-package
        quarantine-bootstrap lock receipt-pending receipt-final
    }
    set present [dict create]
    foreach name $names {
        dict set present $name [r2_path_exists $values $manifest_sha \
            $predecessor_values $name $password]
    }
    if {[dict size $present] != 13} {
        fail "r2-existence-cardinality" 78
    }

    set home [dict get $present home-qroot]
    set auth [dict get $present auth-root]
    set run [dict get $present run-qroot]
    set manifest_pending [dict get $present auth-manifest-pending]
    set manifest_final [dict get $present auth-manifest]
    set self_pending [dict get $present auth-self-pending]
    set self_final [dict get $present auth-self]
    set complete [expr {$home && $auth && $run && $manifest_pending &&
        $manifest_final && $self_pending && $self_final}]

    if {$complete} {
        foreach operation {
            r2-ro-home-qroot-readlink r2-ro-home-qroot-stat
            r2-ro-auth-root-readlink r2-ro-auth-root-stat
            r2-ro-run-qroot-readlink r2-ro-run-qroot-stat
        } {
            r2_step $values $manifest_sha $predecessor_values \
                $operation $password
        }
        set home_entries [list "authority\td"]
        foreach {present_name entry} {
            quarantine-intake "intake\td"
            quarantine-package "package\td"
        } {
            if {[dict get $present $present_name]} {
                lappend home_entries $entry
            }
        }
        set run_entries {}
        foreach {present_name entry} {
            quarantine-bootstrap "bootstrap\td"
            lock "retirement.v1.lock\tf"
            receipt-pending "retirement-complete.v1.pending\tf"
            receipt-final "retirement-complete.v1\tf"
        } {
            if {[dict get $present $present_name]} {
                lappend run_entries $entry
            }
        }
        r2_require_entries \
            [r2_read_entries $values $manifest_sha $predecessor_values \
                r2-ro-home-qroot-entries $password] $home_entries \
            "r2-home-complete-entry-set"
        r2_require_entries \
            [r2_read_entries $values $manifest_sha $predecessor_values \
                r2-ro-run-qroot-entries $password] $run_entries \
            "r2-run-complete-entry-set"
        r2_require_entries \
            [r2_read_entries $values $manifest_sha $predecessor_values \
                r2-ro-auth-root-entries $password] \
            [list "package-manifest.v1.pending\tf" \
                "package-manifest.v1\tf" \
                "prepare-stage-root.sh.pending\tf" \
                "prepare-stage-root.sh\tf"] \
            "r2-authority-entry-set"
        r2_verify_manifest_pair $values $manifest_sha $predecessor_values \
            $password
        r2_verify_self_pair $values $manifest_sha $predecessor_values $password
        return [dict create phase complete present $present]
    }

    foreach name {
        quarantine-intake quarantine-package quarantine-bootstrap lock
        receipt-pending receipt-final
    } {
        if {[dict get $present $name]} {
            fail "r2-prefix-before-authority" 78
        }
    }
    if {!$home} {
        foreach name {
            auth-root run-qroot auth-manifest-pending auth-manifest
            auth-self-pending auth-self
        } {
            if {[dict get $present $name]} {
                fail "r2-prefix-parent-order" 78
            }
        }
        return [dict create phase absent present $present]
    }

    foreach operation {r2-ro-home-qroot-readlink r2-ro-home-qroot-stat} {
        r2_step $values $manifest_sha $predecessor_values $operation $password
    }
    if {!$auth} {
        foreach name {
            run-qroot auth-manifest-pending auth-manifest
            auth-self-pending auth-self
        } {
            if {[dict get $present $name]} {
                fail "r2-prefix-auth-order" 78
            }
        }
        r2_require_entries \
            [r2_read_entries $values $manifest_sha $predecessor_values \
                r2-ro-home-qroot-entries $password] {} \
            "r2-home-prefix-entries"
        return [dict create phase home-qroot present $present]
    }

    foreach operation {r2-ro-auth-root-readlink r2-ro-auth-root-stat} {
        r2_step $values $manifest_sha $predecessor_values $operation $password
    }
    r2_require_entries \
        [r2_read_entries $values $manifest_sha $predecessor_values \
            r2-ro-home-qroot-entries $password] [list "authority\td"] \
        "r2-home-prefix-entries"
    if {!$run} {
        foreach name {
            auth-manifest-pending auth-manifest auth-self-pending auth-self
        } {
            if {[dict get $present $name]} {
                fail "r2-prefix-run-order" 78
            }
        }
        r2_require_entries \
            [r2_read_entries $values $manifest_sha $predecessor_values \
                r2-ro-auth-root-entries $password] {} \
            "r2-auth-prefix-entries"
        return [dict create phase auth-root present $present]
    }

    foreach operation {r2-ro-run-qroot-readlink r2-ro-run-qroot-stat} {
        r2_step $values $manifest_sha $predecessor_values $operation $password
    }
    r2_require_entries \
        [r2_read_entries $values $manifest_sha $predecessor_values \
            r2-ro-run-qroot-entries $password] {} "r2-run-prefix-entries"
    if {!$manifest_pending && !$manifest_final &&
        !$self_pending && !$self_final} {
        r2_require_entries \
            [r2_read_entries $values $manifest_sha $predecessor_values \
                r2-ro-auth-root-entries $password] {} \
            "r2-auth-prefix-entries"
        return [dict create phase run-qroot present $present]
    }
    if {$manifest_pending && !$manifest_final &&
        !$self_pending && !$self_final} {
        r2_require_entries \
            [r2_read_entries $values $manifest_sha $predecessor_values \
                r2-ro-auth-root-entries $password] \
            [list "package-manifest.v1.pending\tf"] \
            "r2-auth-prefix-entries"
        foreach operation {
            r2-ro-auth-manifest-pending-stat
        } {
            r2_step $values $manifest_sha $predecessor_values \
                $operation $password
        }
        return [dict create phase manifest-pending present $present]
    }
    if {$manifest_pending && !$manifest_final && $self_pending && !$self_final} {
        r2_require_entries \
            [r2_read_entries $values $manifest_sha $predecessor_values \
                r2-ro-auth-root-entries $password] \
            [list "package-manifest.v1.pending\tf" \
                "prepare-stage-root.sh.pending\tf"] \
            "r2-auth-prefix-entries"
        foreach operation {
            r2-ro-auth-manifest-pending-stat
            r2-ro-auth-self-pending-stat
        } {
            r2_step $values $manifest_sha $predecessor_values \
                $operation $password
        }
        # Both unpublished pending files remain within the single frozen
        # manifest-pending prefix until the manifest hardlink is published.
        return [dict create phase manifest-pending present $present]
    }
    if {$manifest_pending && $manifest_final && !$self_pending && !$self_final} {
        r2_require_entries \
            [r2_read_entries $values $manifest_sha $predecessor_values \
                r2-ro-auth-root-entries $password] \
            [list "package-manifest.v1.pending\tf" \
                "package-manifest.v1\tf"] "r2-auth-prefix-entries"
        r2_verify_manifest_pair $values $manifest_sha $predecessor_values \
            $password
        return [dict create phase manifest-pair present $present]
    }
    if {$manifest_pending && $manifest_final && $self_pending && !$self_final} {
        r2_require_entries \
            [r2_read_entries $values $manifest_sha $predecessor_values \
                r2-ro-auth-root-entries $password] \
            [list "package-manifest.v1.pending\tf" \
                "package-manifest.v1\tf" \
                "prepare-stage-root.sh.pending\tf"] \
            "r2-auth-prefix-entries"
        r2_verify_manifest_pair $values $manifest_sha $predecessor_values \
            $password
        foreach operation {
            r2-ro-auth-self-pending-stat
        } {
            r2_step $values $manifest_sha $predecessor_values \
                $operation $password
        }
        return [dict create phase self-pending present $present]
    }
    fail "r2-authority-prefix" 78
}

proc r2_ensure_delivery {
    values manifest_sha predecessor_values password
} {
    # Deliberately make the no-replace mkdir the first mutation primitive.  On
    # a resumed run, rc=1 is accepted only after exact read-only validation.
    r2_try_intake_mkdir $values $manifest_sha $predecessor_values $password
    foreach operation {r2-ro-intake-readlink r2-ro-intake-stat} {
        r2_step $values $manifest_sha $predecessor_values $operation $password
    }

    set manifest_entry "package-manifest.v1\tf"
    set self_entry "prepare-stage-root.sh\tf"
    set entries [r2_read_entries $values $manifest_sha $predecessor_values \
        r2-ro-intake-entries $password]
    if {$entries eq {}} {
        r2_step $values $manifest_sha $predecessor_values \
            r2-raw-scp-manifest $password
    } elseif {[llength $entries] == 1 &&
        [lindex $entries 0] eq $manifest_entry} {
        if {[r2_require_intake_prefix $values $manifest_sha \
            $predecessor_values package-manifest.v1 $password] eq "prefix"} {
            r2_step $values $manifest_sha $predecessor_values \
                r2-raw-scp-manifest $password
        }
    } elseif {[llength $entries] == 2 &&
        [lsort -ascii $entries] eq
            [lsort -ascii [list $manifest_entry $self_entry]]} {
        if {[r2_require_intake_prefix $values $manifest_sha \
            $predecessor_values package-manifest.v1 $password] ne "exact"} {
            fail "r2-intake-earlier-prefix" 78
        }
    } else {
        fail "r2-intake-prefix" 78
    }
    foreach operation {r2-ro-intake-manifest-stat r2-ro-intake-manifest-sha} {
        r2_step $values $manifest_sha $predecessor_values $operation $password
    }

    set entries [r2_read_entries $values $manifest_sha $predecessor_values \
        r2-ro-intake-entries $password]
    if {[llength $entries] == 1 && [lindex $entries 0] eq $manifest_entry} {
        r2_step $values $manifest_sha $predecessor_values \
            r2-raw-scp-self $password
    } elseif {[llength $entries] == 2 &&
        [lsort -ascii $entries] eq
            [lsort -ascii [list $manifest_entry $self_entry]]} {
        if {[r2_require_intake_prefix $values $manifest_sha \
            $predecessor_values prepare-stage-root.sh $password] eq "prefix"} {
            r2_step $values $manifest_sha $predecessor_values \
                r2-raw-scp-self $password
        }
    } else {
        fail "r2-intake-self-prefix" 78
    }
    foreach operation {r2-ro-intake-self-stat r2-ro-intake-self-sha} {
        r2_step $values $manifest_sha $predecessor_values $operation $password
    }
    r2_require_entries \
        [r2_read_entries $values $manifest_sha $predecessor_values \
            r2-ro-intake-entries $password] \
        [list $manifest_entry $self_entry] "r2-intake-final-entries"

    foreach operation {
        r2-raw-sync-intake-manifest r2-raw-sync-intake-self
        r2-raw-sync-intake-directory r2-raw-sync-intake-parent
    } {
        r2_step $values $manifest_sha $predecessor_values $operation $password
    }
    foreach operation {
        r2-ro-intake-readlink r2-ro-intake-stat
        r2-ro-intake-manifest-stat r2-ro-intake-manifest-sha
        r2-ro-intake-self-stat r2-ro-intake-self-sha
    } {
        r2_step $values $manifest_sha $predecessor_values $operation $password
    }
    r2_require_entries \
        [r2_read_entries $values $manifest_sha $predecessor_values \
            r2-ro-intake-entries $password] \
        [list $manifest_entry $self_entry] "r2-intake-postsync-entries"
    puts "B82_V6_R2_INTAKE_DURABLE files=2 directories=2 postcheck=exact"
}

proc r2_expect_phase {state expected reason} {
    set actual [dict get $state phase]
    if {$actual ne $expected} {
        fail "$reason-$actual" 78
    }
}

proc r2_ensure_authority {
    values manifest_sha predecessor_values initial_state password
} {
    set state $initial_state
    set phase [dict get $state phase]
    set pending_pair_synced 0
    set manifest_installed_here 0
    set self_installed_here 0
    if {$phase eq "absent"} {
        r2_step $values $manifest_sha $predecessor_values \
            r2-raw-home-qroot-create $password
        set state [r2_authority_state $values $manifest_sha \
            $predecessor_values $password]
        r2_expect_phase $state home-qroot r2-home-create-state
        set phase home-qroot
    }
    if {$phase eq "home-qroot"} {
        r2_step $values $manifest_sha $predecessor_values \
            r2-raw-auth-root-create $password
        set state [r2_authority_state $values $manifest_sha \
            $predecessor_values $password]
        r2_expect_phase $state auth-root r2-auth-create-state
        set phase auth-root
    }
    if {$phase eq "auth-root"} {
        r2_step $values $manifest_sha $predecessor_values \
            r2-raw-run-qroot-create $password
        set state [r2_authority_state $values $manifest_sha \
            $predecessor_values $password]
        r2_expect_phase $state run-qroot r2-run-create-state
        set phase run-qroot
    }
    if {$phase eq "run-qroot"} {
        r2_step $values $manifest_sha $predecessor_values \
            r2-raw-auth-manifest-install $password
        set state [r2_authority_state $values $manifest_sha \
            $predecessor_values $password]
        r2_expect_phase $state manifest-pending r2-manifest-install-state
        set phase manifest-pending
        set manifest_installed_here 1
    }
    if {$phase eq "manifest-pending"} {
        set self_present [dict get [dict get $state present] auth-self-pending]
        if {!$self_present} {
            if {!$manifest_installed_here} {
                set manifest_prefix_class [r2_require_auth_pending_prefix \
                    $values $manifest_sha $predecessor_values \
                    package-manifest.v1 $password]
                if {$manifest_prefix_class ne "exact"} {
                    r2_step $values $manifest_sha $predecessor_values \
                        r2-raw-auth-manifest-install $password
                }
                set manifest_installed_here 1
            }
            r2_step $values $manifest_sha $predecessor_values \
                r2-ro-auth-manifest-pending-sha $password
            r2_step $values $manifest_sha $predecessor_values \
                r2-raw-auth-self-install $password
            set self_installed_here 1
            set state [r2_authority_state $values $manifest_sha \
                $predecessor_values $password]
            r2_expect_phase $state manifest-pending r2-self-install-state
        } elseif {!$manifest_installed_here || !$self_installed_here} {
            if {!$manifest_installed_here} {
                set manifest_prefix_class [r2_require_auth_pending_prefix \
                    $values $manifest_sha $predecessor_values \
                    package-manifest.v1 $password]
            }
            if {!$self_installed_here} {
                set self_prefix_class [r2_require_auth_pending_prefix \
                    $values $manifest_sha $predecessor_values \
                    prepare-stage-root.sh $password]
            }
            if {!$manifest_installed_here &&
                $manifest_prefix_class ne "exact"} {
                r2_step $values $manifest_sha $predecessor_values \
                    r2-raw-auth-manifest-install $password
            }
            if {!$self_installed_here && $self_prefix_class ne "exact"} {
                r2_step $values $manifest_sha $predecessor_values \
                    r2-raw-auth-self-install $password
            }
            set manifest_installed_here 1
            set self_installed_here 1
        }
        foreach operation {
            r2-ro-auth-manifest-pending-sha
            r2-ro-auth-self-pending-sha
        } {
            r2_step $values $manifest_sha $predecessor_values \
                $operation $password
        }
        r2_step $values $manifest_sha $predecessor_values \
            r2-raw-sync-auth-manifest-pending $password
        set state [r2_authority_state $values $manifest_sha \
            $predecessor_values $password]
        r2_expect_phase $state manifest-pending r2-manifest-sync-state
        r2_step $values $manifest_sha $predecessor_values \
            r2-raw-sync-auth-self-pending $password
        set state [r2_authority_state $values $manifest_sha \
            $predecessor_values $password]
        r2_expect_phase $state manifest-pending r2-self-sync-state
        r2_step $values $manifest_sha $predecessor_values \
            r2-raw-link-auth-manifest $password
        set state [r2_authority_state $values $manifest_sha \
            $predecessor_values $password]
        r2_expect_phase $state self-pending r2-manifest-link-state
        set phase self-pending
        set pending_pair_synced 1
    }
    if {$phase eq "manifest-pair"} {
        r2_step $values $manifest_sha $predecessor_values \
            r2-raw-auth-self-install $password
        set self_installed_here 1
        r2_step $values $manifest_sha $predecessor_values \
            r2-ro-auth-self-pending-sha $password
        set state [r2_authority_state $values $manifest_sha \
            $predecessor_values $password]
        r2_expect_phase $state self-pending r2-self-install-state
        set phase self-pending
    }
    if {$phase eq "self-pending"} {
        if {!$self_installed_here && !$pending_pair_synced} {
            set self_prefix_class [r2_require_auth_pending_prefix \
                $values $manifest_sha $predecessor_values \
                prepare-stage-root.sh $password]
            if {$self_prefix_class ne "exact"} {
                r2_step $values $manifest_sha $predecessor_values \
                    r2-raw-auth-self-install $password
            }
            set self_installed_here 1
            r2_step $values $manifest_sha $predecessor_values \
                r2-ro-auth-self-pending-sha $password
        }
        # Re-sync both held inodes on convergence; neither operation can change
        # namespace topology.
        if {!$pending_pair_synced} {
            foreach operation {
                r2-raw-sync-auth-manifest-pending
                r2-raw-sync-auth-self-pending
            } {
                r2_step $values $manifest_sha $predecessor_values \
                    $operation $password
                set state [r2_authority_state $values $manifest_sha \
                    $predecessor_values $password]
                r2_expect_phase $state self-pending r2-pending-sync-state
            }
        }
        r2_step $values $manifest_sha $predecessor_values \
            r2-raw-link-auth-self $password
        set state [r2_authority_state $values $manifest_sha \
            $predecessor_values $password]
        r2_expect_phase $state complete r2-self-link-state
        set phase complete
    }
    if {$phase ne "complete"} {
        fail "r2-authority-state-$phase" 78
    }
    foreach operation {
        r2-raw-sync-auth-root r2-raw-sync-home-parent
        r2-raw-sync-home-qroot r2-raw-sync-run-parent
    } {
        r2_step $values $manifest_sha $predecessor_values $operation $password
        set state [r2_authority_state $values $manifest_sha \
            $predecessor_values $password]
        r2_expect_phase $state complete r2-authority-sync-state
    }
    return $state
}

proc r2_require_r1_terminal {values manifest_sha password position} {
    set state [execute_retirement_lineage_gate $values $manifest_sha $password]
    if {$state ne "TERMINAL"} {
        fail "r2-r1-$position-not-terminal" 78
    }
    puts "B82_V6_R2_R1_GATE position=$position state=TERMINAL writes=0"
}

proc r2_execute_common_gate {values manifest_sha password} {
    foreach operation [base_identity_operations] {
        transaction_step $values $manifest_sha $operation none $password
    }
    set operations [r2_stale_operations]
    set ordinal 0
    foreach operation $operations {
        incr ordinal
        set result [execute_primitive $values $manifest_sha $operation none \
            $password]
        if {[lindex $result 0] ne "ok"} {
            set rc [lindex $result 1]
            puts [format "B82_V6_R2_STALE_ITEM ordinal=%02d operation=%s class=STOP writes=0 rc=%d" $ordinal $operation $rc]
            puts "B82_V6_R2_STALE_SUMMARY items=28 checked=$ordinal result=STOP writes=0 rc=$rc"
            exit $rc
        }
        puts [format "B82_V6_R2_STALE_ITEM ordinal=%02d operation=%s class=ABSENT writes=0 rc=0" $ordinal $operation]
    }
    puts "B82_V6_R2_COMMON_GATE identities=5 stale_absent=28 writes=0 result=PASS"
}

proc r2_execute_predecessor_gate {
    values manifest_sha predecessor_values password
} {
    transaction_step $values $manifest_sha package-parent-stat none $password
    foreach operation {
        r2-ro-old-package-readlink r2-ro-old-package-stat
        r2-ro-old-package-entries
    } {
        r2_step $values $manifest_sha $predecessor_values $operation $password
    }
    foreach name [r2_predecessor_package_names] {
        foreach family {sha stat} {
            r2_step $values $manifest_sha $predecessor_values \
                "r2-ro-old-package-${family}-${name}" $password
        }
    }
    foreach operation {
        r2-ro-old-bootstrap-root-readlink r2-ro-old-bootstrap-root-stat
        r2-ro-old-bootstrap-provisioner-readlink
        r2-ro-old-bootstrap-provisioner-stat
        r2-ro-old-bootstrap-provisioner-sha
        r2-ro-old-bootstrap-stager-readlink
        r2-ro-old-bootstrap-stager-stat r2-ro-old-bootstrap-stager-sha
        r2-ro-old-bootstrap-entries
    } {
        r2_step $values $manifest_sha $predecessor_values $operation $password
    }
    set result [r2_step $values $manifest_sha $predecessor_values \
        r2-ro-old-provision-check $password]
    if {[lindex $result 3] ne "none"} {
        fail "r2-predecessor-provision-check" 78
    }
    puts "B82_V6_R2_PREDECESSOR_GATE package_files=17 bootstrap_files=2 provision_missing=none primitives=48 writes=0 result=PASS"
}

proc r2_postflight_presence {state} {
    set present [dict get $state present]
    foreach name {
        quarantine-intake quarantine-package quarantine-bootstrap lock
        receipt-pending receipt-final
    } {
        if {[dict get $present $name]} {
            return 1
        }
    }
    return 0
}

proc r2_terminal_presence {state} {
    if {[dict get $state phase] ne "complete"} {
        return 0
    }
    set present [dict get $state present]
    foreach name {
        quarantine-intake quarantine-package quarantine-bootstrap lock
        receipt-final
    } {
        if {![dict get $present $name]} {
            return 0
        }
    }
    return [expr {![dict get $present receipt-pending]}]
}

proc r2_exact_verify {
    values manifest_sha predecessor_values password
} {
    r2_step $values $manifest_sha $predecessor_values \
        r2-ro-helper-verify $password
    set state [r2_authority_state $values $manifest_sha \
        $predecessor_values $password]
    if {![r2_terminal_presence $state]} {
        fail "r2-terminal-presence" 78
    }
    puts "B82_V6_R2_VERIFY state=TERMINAL receipt_sha256=derived-by-authority-helper mutations=0"
    return $state
}

proc execute_r2_transaction {
    values manifest_sha predecessor_values password
} {
    puts "B82_V6_R2_TRANSACTION_START retire_id=$::R2_RETIRE_ID operation=retire-postflight-f75fe7678cfd-r2 sequence=fixed caller_argv=forbidden"
    # On the pristine path these are exactly primitives 1..84 and 85..97.
    r2_require_r1_terminal $values $manifest_sha $password preflight
    set state [r2_authority_state $values $manifest_sha \
        $predecessor_values $password]
    set phase [dict get $state phase]
    r2_mutation_trace_start $phase
    if {$phase ne "complete"} {
        # Exactly primitives 98..130 and 131..178 precede the first write,
        # whose zero-based trace index is 178 (one-based primitive #179).
        r2_execute_common_gate $values $manifest_sha $password
        r2_execute_predecessor_gate $values $manifest_sha \
            $predecessor_values $password
        r2_ensure_delivery $values $manifest_sha $predecessor_values $password
        set state [r2_ensure_authority $values $manifest_sha \
            $predecessor_values $state $password]
    } elseif {![r2_postflight_presence $state]} {
        r2_execute_common_gate $values $manifest_sha $password
        r2_execute_predecessor_gate $values $manifest_sha \
            $predecessor_values $password
        r2_ensure_delivery $values $manifest_sha $predecessor_values $password
        set state [r2_ensure_authority $values $manifest_sha \
            $predecessor_values $state $password]
    }

    if {[r2_terminal_presence $state]} {
        r2_exact_verify $values $manifest_sha $predecessor_values $password
        r2_require_r1_terminal $values $manifest_sha $password postflight
        r2_mutation_trace_finish
        puts "B82_V6_R2_TRANSACTION_COMPLETE retire_id=$::R2_RETIRE_ID state=TERMINAL mutation=already-complete automatic_cleanup=0 retention=quarantine"
        return TERMINAL
    }

    # Re-establish every read-only property that still has an original source
    # immediately before invoking the sole root mutation helper.
    set state [r2_authority_state $values $manifest_sha \
        $predecessor_values $password]
    r2_expect_phase $state complete r2-prehelper-authority
    r2_require_r1_terminal $values $manifest_sha $password pre-helper
    r2_execute_common_gate $values $manifest_sha $password
    if {![r2_postflight_presence $state]} {
        r2_execute_predecessor_gate $values $manifest_sha \
            $predecessor_values $password
    }
    r2_step $values $manifest_sha $predecessor_values \
        r2-raw-helper-mutate $password
    r2_exact_verify $values $manifest_sha $predecessor_values $password
    r2_require_r1_terminal $values $manifest_sha $password postflight
    r2_mutation_trace_finish
    puts "B82_V6_R2_TRANSACTION_COMPLETE retire_id=$::R2_RETIRE_ID state=TERMINAL mutation_surface=21 automatic_cleanup=0 retention=quarantine"
    return TERMINAL
}

proc execute_r2_verify_transaction {
    values manifest_sha predecessor_values password
} {
    set state [r2_exact_verify $values $manifest_sha $predecessor_values \
        $password]
    r2_require_r1_terminal $values $manifest_sha $password verify-postflight
    puts "B82_V6_R2_VERIFY_COMPLETE retire_id=$::R2_RETIRE_ID state=TERMINAL mutations=0"
    return $state
}

proc execute_stale_transaction_gate {values manifest_sha password} {
    set operations [prepare_stale_operations]
    set total [llength $operations]
    set ordinal 0
    foreach operation $operations {
        incr ordinal
        set result [execute_primitive $values $manifest_sha $operation none $password]
        set id [string range $operation 6 end]
        if {[lindex $result 0] ne "ok"} {
            set rc [lindex $result 1]
            puts [format "B82_V6_STALE_ITEM_V1 ordinal=%02d id=%s class=STOP writes=0 cleanup=0 rc=%d" $ordinal $id $rc]
            puts "B82_V6_STALE_SUMMARY_V1 profile=prepare-new items=$total checked=$ordinal absent=[expr {$ordinal - 1}] writes=0 cleanup=0 result=STOP rc=$rc"
            exit $rc
        }
        puts [format "B82_V6_STALE_ITEM_V1 ordinal=%02d id=%s class=ABSENT writes=0 cleanup=0 rc=0" $ordinal $id]
    }
    puts "B82_V6_STALE_SUMMARY_V1 profile=prepare-new items=$total checked=$total absent=$total writes=0 cleanup=0 result=PASS rc=0"
}

proc verify_remote_package_transaction {values manifest_sha password} {
    foreach name [package_names] {
        transaction_step $values $manifest_sha "verify-sha-$name" none $password
        transaction_step $values $manifest_sha "verify-stat-$name" none $password
    }
}

proc verify_provisioner_transaction {values manifest_sha password} {
    foreach operation [provisioner_verify_operations] {
        transaction_step $values $manifest_sha $operation none $password
    }
}

proc execute_postflight_transaction {values manifest_sha password} {
    verify_remote_package_transaction $values $manifest_sha $password
    foreach operation [concat [postflight_operations] {
        controller-shellcheck hermetic-matrix hermetic-fresh
    }] {
        transaction_step $values $manifest_sha $operation none $password
    }
    foreach operation [stager_verify_operations] {
        transaction_step $values $manifest_sha $operation none $password
    }
    foreach operation [stage_operations] {
        transaction_step $values $manifest_sha $operation none $password
    }
    puts "B82_V6_CONTROLLER_POSTFLIGHT_COMPLETE state=POSTFLIGHT"
}

proc execute_prepare_transaction {values manifest_sha password} {
    foreach operation [base_identity_operations] {
        transaction_step $values $manifest_sha $operation none $password
    }
    execute_stale_transaction_gate $values $manifest_sha $password
    transaction_step $values $manifest_sha package-parent-stat none $password
    execute_retirement_lineage_gate $values $manifest_sha $password
    transaction_step $values $manifest_sha package-mkdir none $password
    foreach name [package_names] {
        transaction_step $values $manifest_sha "scp-$name" none $password
        transaction_step $values $manifest_sha "verify-sha-$name" none $password
        transaction_step $values $manifest_sha "verify-stat-$name" none $password
    }
    foreach operation [bootstrap_create_operations] {
        transaction_step $values $manifest_sha $operation none $password
    }
    puts "B82_V6_CONTROLLER_STATE from=PACKAGE_BOUND to=BOOTSTRAP_ONLY automatic_apply=0"
    verify_provisioner_transaction $values $manifest_sha $password
    puts "B82_V6_CONTROLLER_STATE from=BOOTSTRAP_ONLY to=PROVISION_CHECK automatic_apply=0"
    set result [transaction_step $values $manifest_sha provision-check none $password]
    set missing [lindex $result 3]
    if {$missing eq "none"} {
        puts "B82_V6_CONTROLLER_STATE from=PROVISION_CHECK to=POSTFLIGHT automatic_apply=0"
        execute_postflight_transaction $values $manifest_sha $password
        return POSTFLIGHT
    }
    if {$missing ni {initial iperf3}} { fail "provision-state" 78 }
    puts "B82_V6_CONTROLLER_STATE from=PROVISION_CHECK to=AWAIT_APPLY automatic_apply=0"
    puts "B82_V6_PROVISION_AWAIT_APPLY missing_set=$missing explicit_mode=provision-apply automatic_apply=0"
    return AWAIT_APPLY
}

proc execute_provision_apply_transaction {values manifest_sha password} {
    foreach operation [concat [base_identity_operations] [bootstrap_verify_operations]] {
        transaction_step $values $manifest_sha $operation none $password
    }
    verify_remote_package_transaction $values $manifest_sha $password
    verify_provisioner_transaction $values $manifest_sha $password
    puts "B82_V6_CONTROLLER_STATE from=BOOTSTRAP_ONLY to=PROVISION_CHECK automatic_apply=0"
    set result [transaction_step $values $manifest_sha provision-check none $password]
    set missing [lindex $result 3]
    if {$missing eq "none"} {
        puts "B82_V6_CONTROLLER_STATE from=PROVISION_CHECK to=POSTFLIGHT automatic_apply=0"
        execute_postflight_transaction $values $manifest_sha $password
        return POSTFLIGHT
    }
    if {$missing ni {initial iperf3}} { fail "provision-state" 78 }
    puts "B82_V6_CONTROLLER_STATE from=PROVISION_CHECK to=AWAIT_APPLY automatic_apply=0"
    puts "B82_V6_CONTROLLER_STATE from=AWAIT_APPLY to=PROVISION_APPLY automatic_apply=0"
    verify_provisioner_transaction $values $manifest_sha $password
    set apply_result [transaction_step $values $manifest_sha provision-apply none $password]
    if {[lindex $apply_result 3] ne $missing} { fail "provision-apply-state" 78 }
    verify_provisioner_transaction $values $manifest_sha $password
    set post_result [transaction_step $values $manifest_sha provision-check none $password]
    if {[lindex $post_result 3] ne "none"} { fail "provision-postcheck" 78 }
    puts "B82_V6_CONTROLLER_STATE from=PROVISION_APPLY to=POSTFLIGHT automatic_apply=0"
    execute_postflight_transaction $values $manifest_sha $password
    return POSTFLIGHT
}

proc execute_transaction {values manifest_sha operation approved_sha password} {
    puts "B82_V6_TRANSPORT_TRANSACTION_START operation=$operation sequence=fixed caller_argv=forbidden"
    switch -- $operation {
        prepare {
            set result [execute_prepare_transaction $values $manifest_sha $password]
        }
        provision-apply {
            set result [execute_provision_apply_transaction $values $manifest_sha $password]
        }
        fresh-run - fresh-restore - veth-run - veth-restore -
        routed-run - routed-restore {
            transaction_step $values $manifest_sha $operation none $password
            set result COMPLETE
        }
        realnic-run {
            foreach primitive {
                scp-realnic-approved-plan verify-sha-realnic-approved-plan
                verify-stat-realnic-approved-plan stage-realnic-plan-snapshot realnic-run
            } {
                transaction_step $values $manifest_sha $primitive $approved_sha $password
            }
            set result COMPLETE
        }
        realnic-restore {
            foreach primitive {stage-realnic-plan-verify realnic-restore} {
                transaction_step $values $manifest_sha $primitive $approved_sha $password
            }
            set result COMPLETE
        }
        default { fail "transaction-operation" 65 }
    }
    puts "B82_V6_TRANSPORT_TRANSACTION_COMPLETE operation=$operation result=$result"
}

proc transport_main {arguments} {
    set argc [llength $arguments]
    set argv $arguments
    if {$argc != 12 ||
        [lindex $argv 0] ne "--manifest" ||
        [lindex $argv 2] ne "--manifest-sha256" ||
        [lindex $argv 4] ne "--credential-path" ||
        [lindex $argv 6] ne "--action" ||
        [lindex $argv 8] ne "--operation" ||
        [lindex $argv 10] ne "--approved-plan-sha256"} {
        fail "arguments" 64
    }
    set manifest [lindex $argv 1]
    set manifest_sha [lindex $argv 3]
    set credential_path [lindex $argv 5]
    set action [lindex $argv 7]
    set operation [lindex $argv 9]
    set approved_sha [lindex $argv 11]

    if {![regexp {^[0-9a-f]{64}$} $manifest_sha] ||
        $credential_path ne "/Users/siyixuan/codes-2/wg-mix-ebpf/credientials/192.168.10.82" ||
        $action ni {plan execute capture} ||
        ![regexp {^[A-Za-z0-9_.-]+$} $operation] ||
        !($approved_sha eq "none" || [regexp {^[0-9a-f]{64}$} $approved_sha])} {
        fail "argument-values" 65
    }
    if {[regexp {^(?:r2-(?:ro|raw)-|lineage-)} $operation]} {
        fail "private-operation" 65
    }
    if {($action eq "capture" && $operation ne "realnic-plan") ||
        ($action eq "execute" && ![transaction_operation $operation] &&
         ![read_only_operation $operation])} {
        fail "action-operation" 65
    }
    set sha_is_valid [expr {
        [regexp {^[0-9a-f]{64}$} $approved_sha] &&
        ![regexp {^0{64}$} $approved_sha] &&
        ![regexp {^f{64}$} $approved_sha]
    }]
    if {([operation_requires_approved_sha $operation] && !$sha_is_valid) ||
        (![operation_requires_approved_sha $operation] && $approved_sha ne "none")} {
        fail "approved-plan-sha-operation" 65
    }
    if {[catch {load_manifest $manifest $manifest_sha} values] ||
        $manifest ne "[dict get $values local_package_dir]/package-manifest.v1" ||
        [catch {validate_manifest_values $values} validation_message] ||
        [catch {validate_self $values} self_message]} {
        fail "policy" 66
    }
    if {[catch {exec /usr/bin/id -u} caller_uid] ||
        ![regexp {^[0-9]+$} $caller_uid] ||
        [catch {file lstat $manifest manifest_stat}] ||
        [catch {file lstat [dict get $values local_package_dir] package_stat}] ||
        $manifest_stat(type) ne "file" || $manifest_stat(nlink) != 1 ||
        ($manifest_stat(mode) & 07777) != 0600 ||
        $package_stat(type) ne "directory" || ($package_stat(mode) & 07777) != 0700 ||
        $package_stat(uid) != $caller_uid ||
        $manifest_stat(uid) != $package_stat(uid) ||
        $manifest_stat(gid) != $package_stat(gid)} {
        fail "local-package-owner" 66
    }
    if {$action eq "plan"} {
        if {[r2_mutation_operation $operation] ||
            [r2_read_only_operation $operation]} {
            set helper_mode [expr {[r2_mutation_operation $operation] ?
                "retire-postflight-f75fe7678cfd-r2" :
                "verify-postflight-retirement-r2"}]
            puts "B82_V6_TRANSPORT_PLAN operation=$operation transport=high-level-fixed credential_read=0 network_operations=0 raw_leaves=unreachable predecessor_format=v4 predecessor_fields=103 predecessor_package_files=17"
            puts "EXPECT_PROGRAM [info nameofexecutable] SCRIPT $::TRANSPORT_SCRIPT_PATH"
            puts "R2_AUTH_SELF_ARGV [list {*}[r2_helper_remote_argv \
                $manifest_sha $helper_mode]]"
            exit 0
        }
        if {[catch {build_operation $values $manifest_sha $operation $approved_sha} operation_spec]} {
            fail "policy" 66
        }
        lassign $operation_spec transport_type spawn_argv prompt_limit assertion timeout_seconds
        puts "B82_V6_TRANSPORT_PLAN operation=$operation transport=$transport_type credential_read=0 network_operations=0"
        puts "EXPECT_PROGRAM [info nameofexecutable] SCRIPT $::TRANSPORT_SCRIPT_PATH"
        puts "EXPECT_SPAWN_ARGV [list {*}$spawn_argv]"
        puts "EXPECT_OUTPUT_ASSERTION [list $assertion]"
        exit 0
    }

    if {$action eq "capture"} {
        if {[catch {build_operation $values $manifest_sha $operation $approved_sha} operation_spec]} {
            fail "policy" 66
        }
        lassign $operation_spec transport_type spawn_argv prompt_limit assertion timeout_seconds
        set password ""
        if {[catch {read_capture_credential $credential_path} password]} {
            set password ""
            fail "credential-value" 65
        }
        puts stderr "B82_V6_TRANSPORT_EXECUTE operation=$operation transport=$transport_type credential_in_argv=0 channel=capture"
        puts stderr "EXPECT_SPAWN_ARGV [list {*}$spawn_argv]"
        log_user 0
        spawn -noecho {*}$spawn_argv
        set child_id $spawn_id
        if {[catch {capture_child_payload $child_id $password $prompt_limit \
            $timeout_seconds} capture_result]} {
            set password ""
            fail "capture-expect" 78
        }
        set password ""
        lassign $capture_result payload credential_sends raw_bytes
        puts stderr "B82_V6_TRANSPORT_CAPTURE operation=$operation child_rc=0 prompts=$credential_sends raw_bytes=$raw_bytes payload_bytes=[string bytelength $payload] framing=canonical"
        fconfigure stdout -encoding binary -translation binary
        puts -nonewline stdout $payload
        flush stdout
        exit 0
    }
    set prebuilt_operation_spec {}
    set predecessor_values {}
    if {[r2_mutation_operation $operation] ||
        [r2_read_only_operation $operation]} {
        # The order is frozen: current v5/112 authority, independent frozen
        # predecessor v4/103 authority, then and only then credential access.
        require_transaction_local_authority $values $manifest_sha \
            $operation $approved_sha
        set predecessor_values [r2_require_predecessor_authority]
        execute_r2_predecessor_controller_verifier $values $manifest_sha
    } elseif {[transaction_operation $operation]} {
        require_transaction_local_authority $values $manifest_sha $operation $approved_sha
    } elseif {[catch {build_operation $values $manifest_sha $operation \
        $approved_sha} prebuilt_operation_spec]} {
        fail "policy" 66
    }
    set password [read_execute_credential $credential_path]
    if {[r2_mutation_operation $operation]} {
        execute_r2_transaction $values $manifest_sha $predecessor_values $password
    } elseif {[r2_read_only_operation $operation]} {
        execute_r2_verify_transaction $values $manifest_sha \
            $predecessor_values $password
    } elseif {[transaction_operation $operation]} {
        execute_transaction $values $manifest_sha $operation $approved_sha $password
    } else {
        require_manifest_authority $values $manifest_sha
        require_primitive_success [execute_operation_spec $operation \
            $prebuilt_operation_spec $password]
    }
    set password ""
    exit 0
}

if {[info exists argv0] && [file normalize $argv0] eq $::TRANSPORT_SCRIPT_PATH} {
    transport_main $argv
}
