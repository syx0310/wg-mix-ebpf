proc fail {message code} {
    puts stderr "B82_V6_TRANSPORT_STOP reason=$message rc=$code"
    exit $code
}

proc file_sha256 {path} {
    if {[catch {exec /usr/bin/shasum -a 256 -- $path} output]} {
        return -code error "sha256-command"
    }
    set digest [lindex $output 0]
    if {![regexp {^[0-9a-f]{64}$} $digest]} {
        return -code error "sha256-shape"
    }
    return $digest
}

proc r2_file_prefix_sha256 {path length} {
    if {![string is integer -strict $length] || $length < 0 ||
        $length > 16777216 || [file normalize $path] ne $path ||
        [file type $path] ne "file"} {
        return -code error "r2-sha256-prefix-arguments"
    }
    set channel [open $path r]
    fconfigure $channel -encoding binary -translation binary
    if {[catch {read $channel $length} payload]} {
        close $channel
        return -code error "r2-sha256-prefix-read"
    }
    close $channel
    if {[string bytelength $payload] != $length ||
        [catch {exec /usr/bin/shasum -a 256 << $payload} output]} {
        set payload ""
        return -code error "r2-sha256-prefix-command"
    }
    set payload ""
    set digest [lindex $output 0]
    if {![regexp {^[0-9a-f]{64}$} $digest]} {
        return -code error "r2-sha256-prefix-shape"
    }
    return $digest
}

